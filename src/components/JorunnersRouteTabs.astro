---
import type { Lang } from '../lib/i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isPl = lang === 'pl';
---

<section class="detail-block route-options-section" aria-labelledby="route-options-heading">
  <div class="route-options-head">
    <div>
      <span class="badge badge-forest">{isPl ? 'Porównaj 2 sprawdzone trasy' : 'Compare 2 Curated Routes'}</span>
      <h2 id="route-options-heading">{isPl ? 'Wybierz opcję trasy Jorunners' : 'Choose Your Jorunners Route Option'}</h2>
      <p class="route-options-lead">
        {isPl
          ? 'Obie opcje oferują ~50 km łatwych, widokowych tras górskich przez 8 dni / 7 nocy z pełnym wyżywieniem (3 posiłki dziennie) i noclegami w schroniskach. Przełącz zakładki poniżej, aby porównać teren, transfery i logistykę.'
          : 'Both options deliver ~50 km of easy, scenic mountain trails across 8 Days / 7 Nights with Full Board (3 meals/day) and mountain lodge stays. Switch tabs below to compare terrain, transfers, and logistics.'}
      </p>
    </div>
  </div>

  <div class="route-tabs-wrap">
    <div
      class="route-tablist"
      role="tablist"
      {...({ focusgroup: 'tablist nomemory' } as any)}
      aria-label={isPl ? 'Opcje trasy Jorunners' : 'Jorunners route options'}
    >
      <button
        type="button"
        role="tab"
        id="tab-option-a"
        class="route-tab"
        aria-selected="true"
        data-route-value={isPl ? 'Opcja A (Rekomendowana): Baza w Kazbegi / Stepancminda' : 'Option A (Recommended): Kazbegi / Stepantsminda Valley Basecamp'}
        {...({ focusgroupstart: '' } as any)}
      >
        <span class="route-tab-kicker">{isPl ? 'Rekomendowana · Łatwy teren' : 'Recommended · Easy Terrain'}</span>
        <span class="route-tab-title">{isPl ? 'Opcja A: Baza w Stepancmindzie' : 'Option A: Stepantsminda Basecamp'}</span>
      </button>

      <button
        type="button"
        role="tab"
        id="tab-option-b"
        class="route-tab"
        aria-selected="false"
        data-route-value={isPl ? 'Opcja B: Swanetia (Mestia do Uszguli) od schroniska do schroniska' : 'Option B: Svaneti (Mestia to Ushguli) Point-to-Point Lodges'}
      >
        <span class="route-tab-kicker">{isPl ? 'Tylko Czerwiec–Wrzesień · Klasyczny trek' : 'June–September Only · Classic Trek'}</span>
        <span class="route-tab-title">{isPl ? 'Opcja B: Mestia do Uszguli' : 'Option B: Mestia to Ushguli'}</span>
      </button>
    </div>

    <div class="route-panels-grid">
      <!-- Option A Panel -->
      <div
        role="tabpanel"
        id="panel-option-a"
        aria-labelledby="tab-option-a"
        tabindex="0"
        class="route-panel"
      >
        <div class="route-panel-card">
          <div class="route-panel-header">
            <div>
              <span class="badge badge-forest">{isPl ? 'Rekomendowana · Baza w dolinie i trasy dzienne' : 'Recommended · Valley Basecamp & Day Trails'}</span>
              <h3>{isPl ? 'Opcja A: Baza w Kazbegi / Stepancmindzie' : 'Option A: Kazbegi / Stepantsminda Valley Basecamp'}</h3>
            </div>
            <span class="badge badge-sea">{isPl ? '~3 godz. z Tbilisi' : '~3h from Tbilisi'}</span>
          </div>

          <p class="route-panel-intro">
            {isPl
              ? 'Idealna dla grup biegowych i aktywnych szukających łatwego terenu, krótkich transferów i braku codziennego pakowania walizek. Komfortowe pensjonaty górskie i codzienne wyjścia po 8–12 km (łącznie ~50 km).'
              : 'Ideal for running & active groups wanting easy terrain, short transfers, and zero daily packing or unpacking. Stay anchored in comfortable mountain lodges while completing 8–12 km daily outings totaling ~50 km.'}
          </p>

          <dl class="route-specs-grid">
            <div>
              <dt>{isPl ? 'Baza i noclegi' : 'Base & Stay'}</dt>
              <dd>{isPl ? 'Stepancminda (6 nocy w pensjonatach górskich + 1 noc w Tbilisi)' : 'Stepantsminda (6 nights in mountain lodges + 1 night in Tbilisi)'}</dd>
            </div>
            <div>
              <dt>{isPl ? 'Dystans dzienny' : 'Daily Distance'}</dt>
              <dd>{isPl ? '8–12 km dziennie (łącznie ~50 km w ciągu tygodnia)' : '8–12 km daily outings totaling ~50 km across the week'}</dd>
            </div>
            <div>
              <dt>{isPl ? 'Czas transferu' : 'Transfer Time'}</dt>
              <dd>{isPl ? '~3 godziny na północ z Tbilisi prywatnym busem' : '~3 hours north of Tbilisi by private group vehicle'}</dd>
            </div>
            <div>
              <dt>{isPl ? 'Logistyka' : 'Logistics'}</dt>
              <dd>{isPl ? 'Jedna baza — bez codziennego pakowania bagażu' : 'Single basecamp — no daily packing/unpacking'}</dd>
            </div>
          </dl>

          <div class="route-highlights-box">
            <h4>{isPl ? 'Główne trasy w programie' : 'Signature Day Trails Included'}</h4>
            <ul>
              <li>
                <strong>{isPl ? 'Dolina Truso (15–20 km w obie strony, elastycznie):' : 'Truso Valley (15–20 km round-trip, customizable):'}</strong>{' '}
                {isPl
                  ? 'Szeroka, łagodna droga szutrowa wzdłuż trawertynowych źródeł mineralnych, opuszczonych kamiennych wiosek i panoram doliny.'
                  : 'Wide, mostly flat gravel valley road past travertine mineral springs, abandoned stone villages, and sweeping river valley panoramas.'}
              </li>
              <li>
                <strong>{isPl ? 'Wysokogórska Dolina Juta (8–12 km tam i z powrotem):' : 'Juta High-Mountain Valley (8–12 km out-and-back):'}</strong>{' '}
                {isPl
                  ? 'Łatwo-umiarkowany szlak alpejski z możliwością zawrócenia w dowolnym momencie i opcjonalnym noclegiem w schronisku.'
                  : 'Easy-to-moderate alpine valley trail with flexible turn-back points and an optional mountain lodge overnight.'}
              </li>
            </ul>
          </div>

          <div class="route-panel-actions">
            <a
              href="#group-inquiry"
              class="btn btn-coral btn-sm select-route-cta"
              data-select-route={isPl ? 'Opcja A (Rekomendowana): Baza w Kazbegi / Stepancminda' : 'Option A (Recommended): Kazbegi / Stepantsminda Valley Basecamp'}
            >
              {isPl ? 'Zapytaj o Opcję A →' : 'Inquire About Option A →'}
            </a>
          </div>
        </div>
      </div>

      <!-- Option B Panel -->
      <div
        role="tabpanel"
        id="panel-option-b"
        aria-labelledby="tab-option-b"
        class="route-panel"
        hidden="until-found"
      >
        <div class="route-panel-card">
          <div class="route-panel-header">
            <div>
              <span class="badge badge-coral">{isPl ? 'Tylko lato / wczesna jesień · Czerwiec–Wrzesień' : 'Summer / Early Autumn Only · June–September'}</span>
              <h3>{isPl ? 'Opcja B: Mestia do Uszguli (od pensjonatu do pensjonatu)' : 'Option B: Mestia to Ushguli Point-to-Point Mountain Lodges'}</h3>
            </div>
            <span class="badge badge-sea">{isPl ? 'Transport bagażu 4x4' : '4x4 Luggage Support'}</span>
          </div>

          <p class="route-panel-intro">
            {isPl
              ? 'Klasyczna ~50-kilometrowa trasa od wioski do wioski przez Górną Swanetię z noclegami w rodzinnych pensjonatach, pełnym wyżywieniem i pełnym wsparciem aut 4x4.'
              : 'A classic village-to-village ~50 km tailored route through Upper Svaneti, staying in traditional family-run mountain lodges with full-board local dining and full 4x4 support.'}
          </p>

          <dl class="route-specs-grid">
            <div>
              <dt>{isPl ? 'Sezonowość' : 'Seasonality'}</dt>
              <dd>{isPl ? 'Tylko lato / wczesna jesień (czerwiec–wrzesień)' : 'Summer / Early Autumn only (June–September)'}</dd>
            </div>
            <div>
              <dt>{isPl ? 'Trasa i dystans' : 'Route & Distance'}</dt>
              <dd>{isPl ? 'Mestia do Uszguli (~50 km trasy punkt-punkt)' : 'Mestia to Ushguli (~50 km tailored point-to-point route)'}</dd>
            </div>
            <div>
              <dt>{isPl ? 'Czas transferu' : 'Transfer Time'}</dt>
              <dd>{isPl ? '~8–9 godzin z Tbilisi (lub lot krajowy, jeśli dostępny)' : '~8–9 hour road transfer from Tbilisi (or domestic flight when available)'}</dd>
            </div>
            <div>
              <dt>{isPl ? 'Wsparcie' : 'Support'}</dt>
              <dd>{isPl ? 'Transport bagażu 4x4 + opcjonalne podwiezienie na najstromszym podejściu' : '4x4 luggage support + optional vehicle skips on the steepest pass to keep effort easy-to-moderate'}</dd>
            </div>
          </dl>

          <div class="route-highlights-box">
            <h4>{isPl ? 'Charakter trasy i finał' : 'Route Experience & Finish'}</h4>
            <ul>
              <li>
                <strong>{isPl ? 'Rodzinne pensjonaty górskie:' : 'Family-Run Mountain Lodges:'}</strong>{' '}
                {isPl
                  ? 'Gościnność od wioski do wioski z sycącymi posiłkami kuchni swańskiej każdego wieczoru.'
                  : 'Village-to-village hospitality with hearty Full Board Svanetian dining each evening.'}
              </li>
              <li>
                <strong>{isPl ? 'Finał w Uszguli:' : 'Ushguli Finish:'}</strong>{' '}
                {isPl
                  ? 'Dotarcie wśród wpisanych na listę UNESCO średniowiecznych kamiennych wież obronnych i lodowców Kaukazu.'
                  : 'Arrive among UNESCO-listed medieval stone defensive towers and glacier-backed Caucasus valleys.'}
              </li>
            </ul>
          </div>

          <div class="route-panel-actions">
            <a
              href="#group-inquiry"
              class="btn btn-coral btn-sm select-route-cta"
              data-select-route={isPl ? 'Opcja B: Swanetia (Mestia do Uszguli) od schroniska do schroniska' : 'Option B: Svaneti (Mestia to Ushguli) Point-to-Point Lodges'}
            >
              {isPl ? 'Zapytaj o Opcję B →' : 'Inquire About Option B →'}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Side-by-Side Comparison Table -->
  <div class="route-compare-wrap">
    <h3 class="route-compare-title">{isPl ? 'Szybkie porównanie obu opcji' : 'Quick Side-by-Side Comparison'}</h3>
    <div class="route-table-scroll">
      <table class="route-compare-table">
        <thead>
          <tr>
            <th>{isPl ? 'Cecha' : 'Feature'}</th>
            <th>{isPl ? 'Opcja A: Stepancminda (Rekomendowana)' : 'Option A: Stepantsminda (Recommended)'}</th>
            <th>{isPl ? 'Opcja B: Mestia do Uszguli' : 'Option B: Mestia to Ushguli'}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>{isPl ? 'Format' : 'Format'}</strong></td>
            <td>{isPl ? 'Baza w dolinie + wyjścia dzienne (bez codziennego pakowania)' : 'Valley basecamp + day trails (no daily packing)'}</td>
            <td>{isPl ? 'Klasyczna trasa od wioski do wioski z noclegami' : 'Classic point-to-point village mountain lodges'}</td>
          </tr>
          <tr>
            <td><strong>{isPl ? 'Transfer z Tbilisi' : 'Transfer from Tbilisi'}</strong></td>
            <td>{isPl ? '~3 godziny jazdy na północ' : '~3 hours north by road'}</td>
            <td>{isPl ? '~8–9 godzin jazdy (lub lot krajowy)' : '~8–9 hours by road (or domestic flight if available)'}</td>
          </tr>
          <tr>
            <td><strong>{isPl ? 'Sezon' : 'Season'}</strong></td>
            <td>{isPl ? 'Od wiosny do jesieni' : 'Spring through Autumn'}</td>
            <td>{isPl ? 'Tylko lato / wczesna jesień (czerwiec–wrzesień)' : 'Summer / Early Autumn only (June–September)'}</td>
          </tr>
          <tr>
            <td><strong>{isPl ? 'Wysiłek i wsparcie' : 'Effort & Support'}</strong></td>
            <td>{isPl ? 'Łatwa droga szutrowa (Truso) i elastyczny powrót (Juta)' : 'Easy flat gravel (Truso) & flexible turn-back (Juta)'}</td>
            <td>{isPl ? 'Łatwy–umiarkowany ze wsparciem 4x4 na bagaż i strome odcinki' : 'Easy-to-moderate with 4x4 luggage & steep-pass vehicle skips'}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  const tablist = document.querySelector<HTMLElement>('.route-tablist');
  const tabs = tablist ? Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')) : [];
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.route-panel'));

  function activateTab(selectedTab: HTMLButtonElement, moveFocus = false) {
    const selectedId = selectedTab.id;
    tabs.forEach((tab) => {
      const isSelected = tab === selectedTab;
      tab.setAttribute('aria-selected', String(isSelected));
      tab.toggleAttribute('focusgroupstart', isSelected);
      if (!isSelected) {
        tab.setAttribute('tabindex', '-1');
      } else {
        tab.removeAttribute('tabindex');
      }
    });

    panels.forEach((panel) => {
      const matches = panel.getAttribute('aria-labelledby') === selectedId;
      if (matches) {
        panel.removeAttribute('hidden');
        panel.setAttribute('tabindex', '0');
      } else {
        panel.setAttribute('hidden', 'until-found');
        panel.removeAttribute('tabindex');
      }
    });

    selectedTab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    if (moveFocus) selectedTab.focus();

    const routeValue = selectedTab.dataset.routeValue;
    if (routeValue) {
      document.dispatchEvent(
        new CustomEvent('jorunners:route-change', { detail: { routeValue } })
      );
    }
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateTab(tab));

    tab.addEventListener('keydown', (e) => {
      let nextIdx = -1;
      if (e.key === 'ArrowRight') nextIdx = (index + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') nextIdx = (index - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') nextIdx = 0;
      else if (e.key === 'End') nextIdx = tabs.length - 1;

      if (nextIdx !== -1) {
        e.preventDefault();
        activateTab(tabs[nextIdx], true);
      }
    });
  });

  // Sync find-in-page reveal (hidden="until-found")
  panels.forEach((panel) => {
    panel.addEventListener('beforematch', () => {
      const tabId = panel.getAttribute('aria-labelledby');
      const tab = tabId ? document.getElementById(tabId) : null;
      if (tab instanceof HTMLButtonElement) activateTab(tab);
    });
  });

  // Clicking "Inquire About Option A/B" syncs the form radio button
  document.querySelectorAll<HTMLAnchorElement>('.select-route-cta').forEach((btn) => {
    btn.addEventListener('click', () => {
      const routeValue = btn.dataset.selectRoute;
      if (routeValue) {
        document.dispatchEvent(
          new CustomEvent('jorunners:route-change', { detail: { routeValue } })
        );
      }
    });
  });
</script>

<style>
  .route-options-head {
    margin-bottom: 1.25rem;
  }

  .route-options-head h2 {
    margin-top: 0.5rem;
    margin-bottom: 0.45rem;
  }

  .route-options-lead {
    color: var(--ink-600);
    max-width: 46rem;
    margin-bottom: 0;
  }

  .route-tablist {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.25rem;
    scrollbar-width: none;
  }

  .route-tablist::-webkit-scrollbar {
    display: none;
  }

  .route-tab {
    position: relative;
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 0.85rem 1.15rem;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: transparent;
    color: var(--ink-600);
    cursor: pointer;
    text-align: left;
    font: inherit;
    transition: background-color 0.18s ease, color 0.18s ease;
  }

  .route-tab:hover {
    background-color: var(--bg-surface);
    color: var(--ink-900);
  }

  .route-tab[aria-selected='true'] {
    background-color: var(--bg-surface);
    color: var(--forest-800);
    border-color: var(--border-subtle);
  }

  .route-tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    border-block-end: 3px solid var(--forest-700);
  }

  .route-tab-kicker {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sea-700);
  }

  .route-tab-title {
    font-size: 1rem;
    font-weight: 700;
    color: inherit;
  }

  .route-panels-grid {
    display: grid;
  }

  .route-panel {
    grid-area: 1 / 1;
  }

  .route-panel-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.4rem;
    box-shadow: var(--shadow-xs);
  }

  .route-panel-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .route-panel-header h3 {
    margin: 0.4rem 0 0;
    font-size: 1.25rem;
  }

  .route-panel-intro {
    color: var(--ink-700);
    margin-bottom: 1.15rem;
  }

  .route-specs-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin: 0 0 1.15rem;
    padding: 0.9rem;
    background-color: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .route-specs-grid dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-500);
    font-weight: 700;
    margin-bottom: 0.2rem;
  }

  .route-specs-grid dd {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-900);
  }

  .route-highlights-box h4 {
    font-size: 0.96rem;
    margin-bottom: 0.5rem;
  }

  .route-highlights-box ul {
    margin: 0 0 1.15rem;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.94rem;
    color: var(--ink-700);
  }

  .route-panel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .route-compare-wrap {
    margin-top: 1.5rem;
  }

  .route-compare-title {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
  }

  .route-table-scroll {
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background-color: #ffffff;
  }

  .route-compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .route-compare-table th,
  .route-compare-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: top;
  }

  .route-compare-table th {
    background-color: var(--bg-surface);
    font-weight: 700;
    color: var(--forest-800);
  }

  .route-compare-table tbody tr:last-child td {
    border-bottom: none;
  }
</style>
