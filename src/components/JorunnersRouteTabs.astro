---
import type { Lang } from '../lib/i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isPl = lang === 'pl';
const isUk = lang === 'uk';
const isHe = lang === 'he';
---

<section class="detail-block route-options-section" aria-labelledby="route-options-heading">
  <div class="route-options-head">
    <div>
      <span class="badge badge-forest">{isPl ? 'Porównaj 2 sprawdzone trasy' : isUk ? 'Порівняйте 2 перевірені маршрути' : isHe ? 'השוו בין 2 מסלולים מאומתים' : 'Compare 2 Curated Routes'}</span>
      <h2 id="route-options-heading">{isPl ? 'Wybierz opcję trasy Jorunners' : isUk ? 'Оберіть варіант маршруту Jorunners' : isHe ? 'בחרו את אפשרות המסלול של Jorunners' : 'Choose Your Jorunners Route Option'}</h2>
      <p class="route-options-lead">
        {isPl
          ? 'Obie opcje oferują ~50 km łatwych, widokowych tras górskich przez 8 dni / 7 nocy z pełnym wyżywieniem (3 posiłki dziennie) i noclegami w schroniskach. Przełącz zakładki poniżej, aby porównać teren, transfery i logistykę.'
          : isUk
          ? 'Обидва варіанти пропонують ~50 км легких видових гірських маршрутів упродовж 8 днів / 7 ночей із повним пансіоном (3-разовим харчуванням) та проживанням у гірських гостьових будинках. Перемикайте вкладки нижче для порівняння.'
          : isHe
          ? 'שתי האפשרויות מציעות ~50 ק״מ של שבילי הרים קלים ונופיים לאורך 8 ימים / 7 לילות בפנסיון מלא (3 ארוחות ביום) ולינה בבתי הארחה בהרים. עברו בין הלשוניות למטה כדי להשוות.'
          : 'Both options deliver ~50 km of easy, scenic mountain trails across 8 Days / 7 Nights with Full Board (3 meals/day) and mountain lodge stays. Switch tabs below to compare terrain, transfers, and logistics.'}
      </p>
    </div>
  </div>

  <div class="route-tabs-wrap">
    <div
      class="route-tablist"
      role="tablist"
      {...({ focusgroup: 'tablist nomemory' } as any)}
      aria-label={isPl ? 'Opcje trasy Jorunners' : isUk ? 'Варіанти маршруту Jorunners' : isHe ? 'אפשרויות מסלול Jorunners' : 'Jorunners route options'}
    >
      <button
        type="button"
        role="tab"
        id="tab-option-a"
        class="route-tab"
        aria-selected="true"
        data-route-value={isPl ? 'Opcja A (Rekomendowana): Baza w Kazbegi / Stepancminda' : isUk ? 'Варіант A (Рекомендований): База в Казбегі / Степанцмінда' : isHe ? 'אפשרות A (מומלצת): בסיס בקזבגי / סטפנצמינדה' : 'Option A (Recommended): Kazbegi / Stepantsminda Valley Basecamp'}
        {...({ focusgroupstart: '' } as any)}
      >
        <span class="route-tab-kicker">{isPl ? 'Rekomendowana · Łatwy teren' : isUk ? 'Рекомендований · Легкий рельєф' : isHe ? 'מומלצת · שטח קל' : 'Recommended · Easy Terrain'}</span>
        <span class="route-tab-title">{isPl ? 'Opcja A: Baza w Stepancmindzie' : isUk ? 'Варіант A: База в Степанцмінді' : isHe ? 'אפשרות A: בסיס בסטפנצמינדה' : 'Option A: Stepantsminda Basecamp'}</span>
      </button>

      <button
        type="button"
        role="tab"
        id="tab-option-b"
        class="route-tab"
        aria-selected="false"
        data-route-value={isPl ? 'Opcja B: Swanetia (Mestia do Uszguli) od schroniska do schroniska' : isUk ? 'Варіант B: Сванетія (Местія до Ушгулі) від притулку до притулку' : isHe ? 'אפשרות B: סוואנתי (ממסטיה לאושגולי) מבקתה לבקתה' : 'Option B: Svaneti (Mestia to Ushguli) Point-to-Point Lodges'}
      >
        <span class="route-tab-kicker">{isPl ? 'Tylko Czerwiec–Wrzesień · Klasyczny trek' : isUk ? 'Лише Червень–Вересень · Класичний трек' : isHe ? 'יוני–ספטמבר בלבד · טרק קלאסי' : 'June–September Only · Classic Trek'}</span>
        <span class="route-tab-title">{isPl ? 'Opcja B: Mestia do Uszguli' : isUk ? 'Варіант B: Местія до Ушгулі' : isHe ? 'אפשרות B: מסטיה לאושגולי' : 'Option B: Mestia to Ushguli'}</span>
      </button>
    </div>

    <div class="route-panels-grid">
      <!-- Option A Panel -->
      <div
        role="tabpanel"
        id="panel-option-a"
        aria-labelledby="tab-option-a"
        tabindex="0"
        class="route-panel"
      >
        <div class="route-panel-card">
          <div class="route-panel-header">
            <div>
              <span class="badge badge-forest">{isPl ? 'Rekomendowana · Baza w dolinie i trasy dzienne' : isUk ? 'Рекомендований · База в долині та денні виходи' : isHe ? 'מומלצת · בסיס בעמק וטיולי יום' : 'Recommended · Valley Basecamp & Day Trails'}</span>
              <h3>{isPl ? 'Opcja A: Baza w Kazbegi / Stepancmindzie' : isUk ? 'Варіант A: База в Казбегі / Степанцмінді' : isHe ? 'אפשרות A: בסיס בקזבגי / סטפנצמינדה' : 'Option A: Kazbegi / Stepantsminda Valley Basecamp'}</h3>
            </div>
            <span class="badge badge-sea">{isPl ? '~3 godz. z Tbilisi' : isUk ? '~3 год із Тбілісі' : isHe ? '~3 שעות מטביליסי' : '~3h from Tbilisi'}</span>
          </div>

          <p class="route-panel-intro">
            {isPl
              ? 'Idealna dla grup biegowych i aktywnych szukających łatwego terenu, krótkich transferów i braku codziennego pakowania walizek. Komfortowe pensjonaty górskie i codzienne wyjścia po 8–12 km (łącznie ~50 km).'
              : isUk
              ? 'Ідеально для бігових та активних груп, які хочуть легкого рельєфу, коротких переїздів і без щоденного збирання валіз. Комфортні гостьові будинки та денні виходи по 8–12 км (разом ~50 км).'
              : isHe
              ? 'אידיאלי לקבוצות ריצה ומטיילים פעילים המחפשים שטח נוח, נסיעות קצרות וללא אריזת מזוודות יומיומית. לינה נוחה בהרים ויציאות יומיות של 8–12 ק״מ (סה״כ ~50 ק״מ).'
              : 'Ideal for running & active groups wanting easy terrain, short transfers, and zero daily packing or unpacking. Stay anchored in comfortable mountain lodges while completing 8–12 km daily outings totaling ~50 km.'}
          </p>

          <dl class="route-specs-grid">
            <div>
              <dt>{isPl ? 'Baza i noclegi' : isUk ? 'База та проживання' : isHe ? 'בסיס ולינה' : 'Base & Stay'}</dt>
              <dd>{isPl ? 'Stepancminda (6 nocy w pensjonatach górskich + 1 noc w Tbilisi)' : isUk ? 'Степанцмінда (6 ночей у гірських будинках + 1 ніч у Тбілісі)' : isHe ? 'סטפנצמינדה (6 לילות בבתי הארחה בהרים + לילה בטביליסי)' : 'Stepantsminda (6 nights in mountain lodges + 1 night in Tbilisi)'}</dd>
            </div>
            <div>
              <dt>{isPl ? 'Dystans dzienny' : isUk ? 'Денна дистанція' : isHe ? 'מרחק יומי' : 'Daily Distance'}</dt>
              <dd>{isPl ? '8–12 km dziennie (łącznie ~50 km w ciągu tygodnia)' : isUk ? '8–12 км щодня (разом ~50 км за тиждень)' : isHe ? '8–12 ק״מ ביום (סה״כ ~50 ק״מ בשבוע)' : '8–12 km daily outings totaling ~50 km across the week'}</dd>
            </div>
            <div>
              <dt>{isPl ? 'Czas transferu' : isUk ? 'Час трансферу' : isHe ? 'זמן נסיעה' : 'Transfer Time'}</dt>
              <dd>{isPl ? '~3 godziny na północ z Tbilisi prywatnym busem' : isUk ? '~3 години на північ із Тбілісі приватним транспортом' : isHe ? '~3 שעות צפונה מטביליסי בהסעה פרטית' : '~3 hours north of Tbilisi by private group vehicle'}</dd>
            </div>
            <div>
              <dt>{isPl ? 'Logistyka' : isUk ? 'Логістика' : isHe ? 'לוגיסטיקה' : 'Logistics'}</dt>
              <dd>{isPl ? 'Jedna baza — bez codziennego pakowania bagażu' : isUk ? 'Одна база — без щоденного пакування багажу' : isHe ? 'בסיס קבוע — ללא אריזה יומיומית של מזוודות' : 'Single basecamp — no daily packing/unpacking'}</dd>
            </div>
          </dl>

          <div class="route-highlights-box">
            <h4>{isPl ? 'Główne trasy w programie' : isUk ? 'Основні маршрути програми' : isHe ? 'מסלולי היום המרכזיים' : 'Signature Day Trails Included'}</h4>
            <ul>
              <li>
                <strong>{isPl ? 'Dolina Truso (15–20 km w obie strony, elastycznie):' : isUk ? 'Долина Трусо (15–20 км туди й назад, гнучко):' : isHe ? 'עמק טרוסו (15–20 ק״מ הלוך-חזור, גמיש):' : 'Truso Valley (15–20 km round-trip, customizable):'}</strong>{' '}
                {isPl
                  ? 'Szeroka, łagodna droga szutrowa wzdłuż trawertynowych źródeł mineralnych, opuszczonych kamiennych wiosek i panoram doliny.'
                  : isUk
                  ? 'Широка полога ґрунтова дорога повз травертинові мінеральні джерела, старовинні кам’яні села та панорами ущелини.'
                  : isHe
                  ? 'דרך עפר רחבה ומתונה לאורך מעיינות מינרליים, כפרי אבן עתיקים ונופי עמק מרהיבים.'
                  : 'Wide, mostly flat gravel valley road past travertine mineral springs, abandoned stone villages, and sweeping river valley panoramas.'}
              </li>
              <li>
                <strong>{isPl ? 'Wysokogórska Dolina Juta (8–12 km tam i z powrotem):' : isUk ? 'Високогірна долина Джута (8–12 км туди й назад):' : isHe ? 'עמק ג׳וטה הגבוה (8–12 ק״מ הלוך-חזור):' : 'Juta High-Mountain Valley (8–12 km out-and-back):'}</strong>{' '}
                {isPl
                  ? 'Łatwo-umiarkowany szlak alpejski z możliwością zawrócenia w dowolnym momencie i opcjonalnym noclegiem w schronisku.'
                  : isUk
                  ? 'Легко-помірна альпійська стежка з можливістю розвернутися в будь-який момент та опціональною ночівлею в притулку.'
                  : isHe
                  ? 'שביל אלפיני קל-בינוני עם אפשרות חזרה גמישה בכל שלב ולינה אופציונלית בבקתת הרים.'
                  : 'Easy-to-moderate alpine valley trail with flexible turn-back points and an optional mountain lodge overnight.'}
              </li>
            </ul>
          </div>

          <div class="route-panel-actions">
            <a
              href="#group-inquiry"
              class="btn btn-coral btn-sm select-route-cta"
              data-select-route={isPl ? 'Opcja A (Rekomendowana): Baza w Kazbegi / Stepancminda' : isUk ? 'Варіант A (Рекомендований): База в Казбегі / Степанцмінда' : isHe ? 'אפשרות A (מומלצת): בסיס בקזבגי / סטפנצמינדה' : 'Option A (Recommended): Kazbegi / Stepantsminda Valley Basecamp'}
            >
              {isPl ? 'Zapytaj o Opcję A →' : isUk ? 'Запитати про Варіант A →' : isHe ? 'בירור על אפשרות A →' : 'Inquire About Option A →'}
            </a>
          </div>
        </div>
      </div>

      <!-- Option B Panel -->
      <div
        role="tabpanel"
        id="panel-option-b"
        aria-labelledby="tab-option-b"
        class="route-panel"
        hidden="until-found"
      >
        <div class="route-panel-card">
          <div class="route-panel-header">
            <div>
              <span class="badge badge-coral">{isPl ? 'Tylko lato / wczesna jesień · Czerwiec–Wrzesień' : isUk ? 'Лише літо / рання осінь · Червень–Вересень' : isHe ? 'קיץ / תחילת סתיו בלבד · יוני–ספטמבר' : 'Summer / Early Autumn Only · June–September'}</span>
              <h3>{isPl ? 'Opcja B: Mestia do Uszguli (od pensjonatu do pensjonatu)' : isUk ? 'Варіант B: Местія до Ушгулі (від села до села)' : isHe ? 'אפשרות B: מסטיה לאושגולי (מכפר לכפר)' : 'Option B: Mestia to Ushguli Point-to-Point Mountain Lodges'}</h3>
            </div>
            <span class="badge badge-sea">{isPl ? 'Transport bagażu 4x4' : isUk ? 'Перевезення багажу 4x4' : isHe ? 'העברת ציוד 4x4' : '4x4 Luggage Support'}</span>
          </div>

          <p class="route-panel-intro">
            {isPl
              ? 'Klasyczna ~50-kilometrowa trasa od wioski do wioski przez Górną Swanetię z noclegami w rodzinnych pensjonatach, pełnym wyżywieniem i pełnym wsparciem aut 4x4.'
              : isUk
              ? 'Класичний ~50-кілометровий маршрут від села до села Верхньою Сванетією з ночівлею в сімейних гостьових будинках, повним пансіоном і супроводом авто 4x4.'
              : isHe
              ? 'מסלול קלאסי של ~50 ק״מ מכפר לכפר בסוואנתי העליונה עם לינה בבתי הארחה משפחתיים, פנסיון מלא וליווי רכבי 4x4.'
              : 'A classic village-to-village ~50 km tailored route through Upper Svaneti, staying in traditional family-run mountain lodges with full-board local dining and full 4x4 support.'}
          </p>

          <dl class="route-specs-grid">
            <div>
              <dt>{isPl ? 'Sezonowość' : isUk ? 'Сезонність' : isHe ? 'עונתיות' : 'Seasonality'}</dt>
              <dd>{isPl ? 'Tylko lato / wczesna jesień (czerwiec–wrzesień)' : isUk ? 'Лише літо / рання осінь (червень–вересень)' : isHe ? 'קיץ / תחילת סתיו בלבד (יוני–ספטמבר)' : 'Summer / Early Autumn only (June–September)'}</dd>
            </div>
            <div>
              <dt>{isPl ? 'Trasa i dystans' : isUk ? 'Маршрут і дистанція' : isHe ? 'מסלול ומרחק' : 'Route & Distance'}</dt>
              <dd>{isPl ? 'Mestia do Uszguli (~50 km trasy punkt-punkt)' : isUk ? 'Местія до Ушгулі (~50 км точковий маршрут)' : isHe ? 'מסטיה לאושגולי (~50 ק״מ מנקודה לנקודה)' : 'Mestia to Ushguli (~50 km tailored point-to-point route)'}</dd>
            </div>
            <div>
              <dt>{isPl ? 'Czas transferu' : isUk ? 'Час трансферу' : isHe ? 'זמן נסיעה' : 'Transfer Time'}</dt>
              <dd>{isPl ? '~8–9 godzin z Tbilisi (lub lot krajowy, jeśli dostępny)' : isUk ? '~8–9 годин із Тбілісі (або внутрішній переліт за наявності)' : isHe ? '~8–9 שעות מטביליסי (או טיסת פנים לפי זמינות)' : '~8–9 hour road transfer from Tbilisi (or domestic flight when available)'}</dd>
            </div>
            <div>
              <dt>{isPl ? 'Wsparcie' : isUk ? 'Підтримка' : isHe ? 'ליווי ותמיכה' : 'Support'}</dt>
              <dd>{isPl ? 'Transport bagażu 4x4 + opcjonalne podwiezienie na najstromszym podejściu' : isUk ? 'Багаж 4x4 + опціональний трансфер на найкрутішому підйомі' : isHe ? 'העברת ציוד 4x4 + הקפצה אופציונלית בעלייה התלולה' : '4x4 luggage support + optional vehicle skips on the steepest pass to keep effort easy-to-moderate'}</dd>
            </div>
          </dl>

          <div class="route-highlights-box">
            <h4>{isPl ? 'Charakter trasy i finał' : isUk ? 'Особливості та фініш' : isHe ? 'חוויית המסלול והסיום' : 'Route Experience & Finish'}</h4>
            <ul>
              <li>
                <strong>{isPl ? 'Rodzinne pensjonaty górskie:' : isUk ? 'Сімейні гірські будинки:' : isHe ? 'בתי הארחה משפחתיים בהרים:' : 'Family-Run Mountain Lodges:'}</strong>{' '}
                {isPl
                  ? 'Gościnność od wioski do wioski z sycącymi posiłkami kuchni swańskiej każdego wieczoru.'
                  : isUk
                  ? 'Гостинність у селах та ситна сванська кухня щовечора.'
                  : isHe
                  ? 'אירוח חם מכפר לכפר עם ארוחות סוואנתיות עשירות בכל ערב.'
                  : 'Village-to-village hospitality with hearty Full Board Svanetian dining each evening.'}
              </li>
              <li>
                <strong>{isPl ? 'Finał w Uszguli:' : isUk ? 'Фініш в Ушгулі:' : isHe ? 'סיום באושגולי:' : 'Ushguli Finish:'}</strong>{' '}
                {isPl
                  ? 'Dotarcie wśród wpisanych na listę UNESCO średniowiecznych kamiennych wież obronnych i lodowców Kaukazu.'
                  : isUk
                  ? 'Фініш серед середньовічних кам’яних сванських веж зі списку UNESCO та льодовиків Кавказу.'
                  : isHe
                  ? 'הגעה אל מול מגדלי האבן מימי הביניים (UNESCO) וקרחוני הקווקז.'
                  : 'Arrive among UNESCO-listed medieval stone defensive towers and glacier-backed Caucasus valleys.'}
              </li>
            </ul>
          </div>

          <div class="route-panel-actions">
            <a
              href="#group-inquiry"
              class="btn btn-coral btn-sm select-route-cta"
              data-select-route={isPl ? 'Opcja B: Swanetia (Mestia do Uszguli) od schroniska do schroniska' : isUk ? 'Варіант B: Сванетія (Местія до Ушгулі) від притулку до притулку' : isHe ? 'אפשרות B: סוואנתי (ממסטיה לאושגולי) מבקתה לבקתה' : 'Option B: Svaneti (Mestia to Ushguli) Point-to-Point Lodges'}
            >
              {isPl ? 'Zapytaj o Opcję B →' : isUk ? 'Запитати про Варіант B →' : isHe ? 'בירור על אפשרות B →' : 'Inquire About Option B →'}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Side-by-Side Comparison Table -->
  <div class="route-compare-wrap">
    <h3 class="route-compare-title">{isPl ? 'Szybkie porównanie obu opcji' : isUk ? 'Швидке порівняння варіантів' : isHe ? 'השוואה מהירה בין שתי האפשרויות' : 'Quick Side-by-Side Comparison'}</h3>
    <div class="route-table-scroll">
      <table class="route-compare-table">
        <thead>
          <tr>
            <th>{isPl ? 'Cecha' : isUk ? 'Характеристика' : isHe ? 'מאפיין' : 'Feature'}</th>
            <th>{isPl ? 'Opcja A: Stepancminda (Rekomendowana)' : isUk ? 'Варіант A: Степанцмінда (Рекомендований)' : isHe ? 'אפשרות A: סטפנצמינדה (מומלצת)' : 'Option A: Stepantsminda (Recommended)'}</th>
            <th>{isPl ? 'Opcja B: Mestia do Uszguli' : isUk ? 'Варіант B: Местія до Ушгулі' : isHe ? 'אפשרות B: מסטיה לאושגולי' : 'Option B: Mestia to Ushguli'}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>{isPl ? 'Format' : isUk ? 'Формат' : isHe ? 'פורמט' : 'Format'}</strong></td>
            <td>{isPl ? 'Baza w dolinie + wyjścia dzienne (bez codziennego pakowania)' : isUk ? 'База в долині + денні виходи (без щоденного пакування)' : isHe ? 'בסיס בעמק + טיולי יום (ללא אריזה יומיומית)' : 'Valley basecamp + day trails (no daily packing)'}</td>
            <td>{isPl ? 'Klasyczna trasa od wioski do wioski z noclegami' : isUk ? 'Класичний маршрут від села до села з ночівлею' : isHe ? 'מסלול קלאסי מכפר לכפר עם לינה בבקתות' : 'Classic point-to-point village mountain lodges'}</td>
          </tr>
          <tr>
            <td><strong>{isPl ? 'Transfer z Tbilisi' : isUk ? 'Трансфер із Тбілісі' : isHe ? 'הסעה מטביליסי' : 'Transfer from Tbilisi'}</strong></td>
            <td>{isPl ? '~3 godziny jazdy na północ' : isUk ? '~3 години на північ дорогою' : isHe ? '~3 שעות נסיעה צפונה' : '~3 hours north by road'}</td>
