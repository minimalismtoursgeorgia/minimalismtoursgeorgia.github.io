---
import { SITE } from '../data/site';
import { type GuestReview, type ReviewCategory } from '../data/reviews';
import { withBase } from '../lib/urls';
import { localizePath, type Lang } from '../lib/i18n';

export interface Props {
  reviews: GuestReview[];
  variant?: 'band' | 'inline';
  sectionId?: string;
  enableFilters?: boolean;
  surface?: 'subtle' | 'white';
  eyebrow?: string;
  heading?: string;
  intro?: string;
  showTourLink?: boolean;
  showPlatformBar?: boolean;
  lang?: Lang;
}

const {
  reviews,
  variant = 'band',
  sectionId,
  enableFilters = false,
  surface = 'subtle',
  lang = 'en',
  eyebrow = lang === 'pl' ? 'Zweryfikowane opinie podróżnych' : 'Verified Traveler Feedback',
  heading = lang === 'pl' ? 'Co mówią nasi goście o wycieczkach' : 'What Guests Say About Our Tours',
  intro = lang === 'pl'
    ? 'Prawdziwe słowa podróżnych, którzy odkrywali Batumi i Adżarię z naszym zespołem przewodników.'
    : 'Real words from travelers who explored Batumi and Adjara with our guiding team.',
  showTourLink = true,
  showPlatformBar = true,
} = Astro.props;

const isPl = lang === 'pl';

const resolvedId = sectionId ?? (variant === 'band' ? 'reviews' : undefined);
const sectionClass =
  variant === 'band'
    ? surface === 'white'
      ? 'section section-surface reviews-section-root'
      : 'section reviews-band reviews-section-root'
    : 'detail-block reviews-inline reviews-section-root';

const CATEGORY_META: Record<
  ReviewCategory,
  { badgeClass: string; badgeText: (platform: GuestReview['platform']) => string; filterLabel: string }
> = {
  tour: {
    badgeClass: 'badge badge-forest',
    badgeText: (platform) => (isPl ? `Zweryfikowana opinia · ${platform}` : `Verified ${platform} Review`),
    filterLabel: isPl ? 'Ukończone wycieczki' : 'Completed Tours',
  },
  'safety-cancellation': {
    badgeClass: 'badge badge-sea',
    badgeText: (platform) => (isPl ? `Anulowanie dla bezpieczeństwa · ${platform}` : `Safety-First Cancellation · ${platform}`),
    filterLabel: isPl ? 'Bezpieczeństwo i zwroty' : 'Weather Safety & Refunds',
  },
  b2b: {
    badgeClass: 'badge badge-coral',
    badgeText: (platform) => (isPl ? `Partner B2B · ${platform}` : `B2B Partner · ${platform}`),
    filterLabel: isPl ? 'Partnerzy B2B' : 'B2B Partners',
  },
};

const filterOptions = [
  { id: 'all', label: isPl ? 'Wszystkie opinie' : 'All Feedback', count: reviews.length },
  ...(['tour', 'safety-cancellation', 'b2b'] as ReviewCategory[]).map((cat) => ({
    id: cat,
    label: CATEGORY_META[cat].filterLabel,
    count: reviews.filter((r) => r.category === cat).length,
  })),
].filter((opt) => opt.count > 0);
---

<section id={resolvedId} class={sectionClass}>
  <div class={variant === 'band' ? 'container' : undefined}>
    {
      variant === 'band' ? (
        <div class="section-header">
          <div>
            {eyebrow && <span class="eyebrow">{eyebrow}</span>}
            <h2>{heading}</h2>
          </div>
          {intro && <p>{intro}</p>}
        </div>
      ) : (
        <div class="reviews-inline-head">
          <h2>{heading}</h2>
          {intro && <p>{intro}</p>}
        </div>
      )
    }

    {
      enableFilters && filterOptions.length > 2 && (
        <div class="review-filter-bar">
          <div class="review-filters" role="group" aria-label="Filter reviews by category">
            {filterOptions.map((opt, idx) => (
              <button
                type="button"
                class={`review-filter-btn ${idx === 0 ? 'active' : ''}`}
                data-review-filter={opt.id}
                aria-pressed={idx === 0 ? 'true' : 'false'}
              >
                {opt.label} ({opt.count})
              </button>
            ))}
          </div>
          <p class="visually-hidden" aria-live="polite" data-filter-status />
        </div>
      )
    }

    <ul class="reviews-grid" role="list">
      {
        reviews.map((review) => {
          const meta = CATEGORY_META[review.category];
          return (
            <li data-review-category={review.category}>
              <article class="review-card reveal-on-scroll" data-category={review.category}>
                <header class="review-head">
                  <div class="review-badge-row">
                    <div class="review-badge-left">
                      <svg
                        class="review-quote-mark"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z" />
                      </svg>
                      <span class={meta.badgeClass}>
                        {review.sourceUrl ? (
                          <a
                            class="badge-link"
                            href={review.sourceUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {meta.badgeText(review.platform)} ↗
                          </a>
                        ) : (
                          meta.badgeText(review.platform)
                        )}
                      </span>
                    </div>
                    {review.country && review.countryFlag && (
                      <span class="country-pill">
                        <span aria-hidden="true">{review.countryFlag}</span> {review.country}
                      </span>
                    )}
                  </div>
                  <h3>{review.title}</h3>
                  {review.contextNote && <p class="review-context">{review.contextNote}</p>}
                </header>

                <blockquote class="review-quote">
                  <p>“{review.quote}”</p>
                  {review.originalQuote && (
                    <p class="review-original" lang={review.originalLang}>
                      {isPl ? 'Oryginał:' : 'Original:'} “{review.originalQuote}”
                    </p>
                  )}
                </blockquote>

                <footer class="review-foot">
                  <span class="review-meta">
                    {review.authorLabel}
                    {review.country && review.countryFlag && (
                      <>
                        {' · '}
                        <span aria-hidden="true">{review.countryFlag}</span> {review.country}
                      </>
                    )}
                    {' · '}
                    <time datetime={review.datePublished}>{review.dateLabel}</time>
                  </span>
                  {showTourLink && review.tourSlug && review.tourTitle && (
                    <a class="review-tour-link" href={withBase(localizePath(`/tours/${review.tourSlug}/`, lang))}>
                      {review.tourTitle} →
                    </a>
                  )}
                </footer>
              </article>
            </li>
          );
        })
      }
    </ul>

    {
      showPlatformBar && (
        <div class="reviews-cta-bar">
          <span class="reviews-cta-label">
            {isPl ? 'Zobacz i zostaw zweryfikowane opinie na:' : 'Explore & leave verified reviews on:'}
          </span>
          <div class="reviews-cta-actions">
            <a
              class="btn btn-outline btn-sm"
              href={SITE.googleReviewUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {isPl ? 'Opinie Google ↗' : 'Google Reviews ↗'}
            </a>
            <a
              class="btn btn-outline btn-sm"
              href={SITE.tripadvisorReviewUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {isPl ? 'Opinie Tripadvisor ↗' : 'Tripadvisor Reviews ↗'}
            </a>
            <a
              class="btn btn-outline btn-sm"
              href={SITE.trustpilotUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {isPl ? 'Opinie Trustpilot ↗' : 'Trustpilot Reviews ↗'}
            </a>
            <a
              class="btn btn-sea btn-sm"
              href={SITE.getYourGuideSupplierUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {isPl ? 'Wycieczki GetYourGuide ↗' : 'GetYourGuide Tours ↗'}
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.reviews-section-root').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-review-filter]');
    const items = root.querySelectorAll<HTMLLIElement>('li[data-review-category]');
    const statusEl = root.querySelector<HTMLElement>('[data-filter-status]');

    if (!buttons.length || !items.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.dataset.reviewFilter || 'all';
        let visibleCount = 0;

        buttons.forEach((other) => {
          const isMatch = other === btn;
          other.classList.toggle('active', isMatch);
          other.setAttribute('aria-pressed', String(isMatch));
        });

        items.forEach((li) => {
          const match = selected === 'all' || li.dataset.reviewCategory === selected;
          li.hidden = !match;
          if (match) visibleCount += 1;
        });

        if (statusEl) {
          statusEl.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'review' : 'reviews'}.`;
        }
      });
    });
  });
</script>

<style>
  .reviews-band {
    background-color: var(--bg-subtle);
    border-block: 1px solid var(--border-subtle);
  }

  .reviews-inline-head {
    margin-bottom: 1.15rem;
  }

  .reviews-inline-head h2 {
    font-size: 1.6rem;
    margin-bottom: 0.35rem;
  }

  .reviews-inline-head p {
    margin-bottom: 0;
  }

  .review-filter-bar {
    margin-bottom: 1.5rem;
  }

  .review-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .review-filter-btn {
    min-height: 2.45rem;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border-strong);
    background-color: var(--bg-surface);
    color: var(--ink-700);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease;
  }

  .review-filter-btn:hover {
    border-color: var(--forest-800);
    background-color: var(--forest-100);
    color: var(--forest-900);
  }

  .review-filter-btn.active {
    background-color: var(--forest-800);
    border-color: var(--forest-800);
    color: #ffffff;
  }

  .reviews-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
  }

  .reviews-grid > li {
    display: flex;
  }

  .reviews-grid > li[hidden] {
    display: none !important;
  }

  .review-card {
    width: 100%;
    container-type: inline-size;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 1.35rem;
    box-shadow: var(--shadow-xs);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .review-card[data-category='safety-cancellation'] {
    border-top: 3px solid var(--sea-600);
  }

  .review-card[data-category='b2b'] {
    border-top: 3px solid var(--coral-500);
  }

  @supports (grid-template-rows: subgrid) {
    .reviews-grid {
      row-gap: 1rem;
      column-gap: 1.5rem;
    }

    .reviews-grid > li {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
    }

    .review-card {
      grid-row: 1 / -1;
      grid-template-rows: subgrid;
      align-content: start;
    }
  }

  .review-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    border-color: var(--border-strong);
  }

  .review-head {
    display: grid;
    gap: 0.65rem;
    align-content: start;
  }

  .review-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
  }

  .review-badge-left {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .review-quote-mark {
    color: var(--coral-600);
    opacity: 0.85;
    flex-shrink: 0;
  }

  .badge-link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: inherit;
    text-decoration: none;
  }

  .badge-link:hover {
    text-decoration: underline;
  }

  .country-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.22rem 0.65rem;
    border-radius: var(--radius-pill);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-700);
    white-space: nowrap;
  }

  .review-head h3 {
    margin: 0;
    font-size: 1.22rem;
    color: var(--ink-900);
  }

  .review-context {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--ink-600);
    background-color: var(--bg-page);
    border-inline-start: 3px solid var(--sea-600);
    padding: 0.45rem 0.75rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .review-card[data-category='b2b'] .review-context {
    border-inline-start-color: var(--coral-500);
  }

  .review-quote {
    margin: 0;
    display: grid;
    gap: 0.65rem;
    align-content: start;
  }

  .review-quote p {
    margin: 0;
    color: var(--ink-700);
    font-size: 0.96rem;
    line-height: 1.68;
  }

  .review-original {
    font-size: 0.86rem !important;
    font-style: italic;
    color: var(--ink-600) !important;
    padding-top: 0.55rem;
    border-top: 1px dashed var(--border-subtle);
  }

  .review-foot {
    padding-top: 0.9rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .review-meta {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink-600);
  }

  .review-tour-link {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--forest-800);
    text-decoration: none;
  }

  .review-tour-link:hover {
    color: var(--coral-600);
    text-decoration: underline;
  }

  @container (min-width: 26rem) {
    .review-card {
      padding: 1.65rem;
    }

    .review-foot {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }
  }

  .reviews-cta-bar {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.25rem;
  }

  .reviews-cta-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink-700);
  }

  .reviews-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
</style>
