---
import { SITE, SOCIAL_LINKS } from '../data/site';
import { withBase, absoluteUrl } from '../lib/urls';

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  lang?: 'en' | 'ka' | 'pl' | 'uk' | 'he';
  alternateEnPath?: string;
  alternateKaPath?: string;
  alternatePlPath?: string;
  alternateUkPath?: string;
  alternateHePath?: string;
  keywords?: string[];
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = SITE.ogImagePath,
  ogType = 'website',
  lang = 'en',
  alternateEnPath,
  alternateKaPath,
  alternatePlPath,
  alternateUkPath,
  alternateHePath,
  keywords = lang === 'pl'
    ? [
        'Minimalism Tours Georgia',
        'wycieczki z Batumi',
        'Park Narodowy Mtirala trekking',
        'Wąwóz Machakhela wycieczka',
        'polskojęzyczny przewodnik Batumi Adżaria',
        'DMC Gruzja B2B',
      ]
    : lang === 'uk'
    ? [
        'Minimalism Tours Georgia',
        'екскурсії з Батумі',
        'Національний парк Мтірала трекінг',
        'Ущелина Мачахела екскурсія',
        'гірські походи Аджарія Грузія',
        'DMC Грузія B2B',
      ]
    : lang === 'he'
    ? [
        'Minimalism Tours Georgia',
        'טיולים מבאטומי',
        'הפארק הלאומי מטירלה טיול',
        'ערוץ מצ׳אחלה טיול ג׳יפים',
        'מדריך טיולים באטומי אג׳ריה גאורגיה',
        'טיולי טבע בגאורגיה',
      ]
    : [
        'Minimalism Tours Georgia',
        'Batumi day tours',
        'Mtirala National Park hike',
        'Machakhela hiking tour',
        'Adjara DMC tour operator',
        'Batumi B2B ground handling',
      ],
  jsonLd = [],
} = Astro.props;

const canonicalUrl = canonicalPath.startsWith('http')
  ? canonicalPath
  : absoluteUrl(canonicalPath, Astro.site);

const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : absoluteUrl(ogImage, Astro.site);

const defaultOrgSchema = {
  '@type': 'TravelAgency',
  '@id': `${absoluteUrl('/', Astro.site)}#organization`,
  name: SITE.brandName,
  slogan: `${SITE.motto} — ${SITE.campaignTagline}`,
  description: SITE.description,
  url: absoluteUrl('/', Astro.site),
  logo: absoluteUrl(SITE.logoPath, Astro.site),
  image: ogImageUrl,
  telephone: SITE.phoneRaw,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.streetAddress,
    postalCode: SITE.postalCode,
    addressLocality: SITE.baseCity,
    addressRegion: SITE.baseRegion,
    addressCountry: 'GE',
  },
  openingHours: 'Mo-Su 00:00-23:59',
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.coordinates.lat,
    longitude: SITE.coordinates.lng,
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Adjara, Georgia' },
    { '@type': 'City', name: 'Batumi' },
    { '@type': 'Country', name: 'Georgia' },
  ],
  sameAs: [
    ...SOCIAL_LINKS.map((s) => s.url),
    SITE.getYourGuideSupplierUrl,
    SITE.getYourGuideTourUrl,
    SITE.tripadvisorUrl,
    SITE.tripadvisorReviewUrl,
    SITE.trustpilotUrl,
  ],
  priceRange: '€€',
};

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [defaultOrgSchema, ...jsonLd],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords.join(', ')} />
<meta name="author" content={SITE.brandName} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
<meta name="theme-color" content="#1B4332" />

<link rel="canonical" href={canonicalUrl} />

{
  alternateEnPath && (
    <link rel="alternate" hreflang="en" href={absoluteUrl(alternateEnPath, Astro.site)} />
  )
}
{
  alternateKaPath && (
    <link rel="alternate" hreflang="ka" href={absoluteUrl(alternateKaPath, Astro.site)} />
  )
}
{
  alternatePlPath && (
    <link rel="alternate" hreflang="pl" href={absoluteUrl(alternatePlPath, Astro.site)} />
  )
}
{
  alternateUkPath && (
    <link rel="alternate" hreflang="uk" href={absoluteUrl(alternateUkPath, Astro.site)} />
  )
}
{
  alternateHePath && (
    <link rel="alternate" hreflang="he" href={absoluteUrl(alternateHePath, Astro.site)} />
  )
}
{
  (alternateEnPath || alternateKaPath || alternatePlPath || alternateUkPath || alternateHePath) && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={absoluteUrl(alternateEnPath || '/', Astro.site)}
    />
  )
}

<meta property="og:locale" content={lang === 'ka' ? 'ka_GE' : lang === 'pl' ? 'pl_PL' : lang === 'uk' ? 'uk_UA' : lang === 'he' ? 'he_IL' : 'en_US'} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.brandName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.brandName} — ${SITE.campaignTagline}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="icon" type="image/png" href={withBase('/favicon.png')} />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
<link rel="manifest" href={withBase('/site.webmanifest')} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@400;500;600;700&family=Noto+Sans+Hebrew:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
/>

<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
