<script
  id="batumi-news-ui-i18n"
  type="application/json"
  set:html={JSON.stringify({
    showingPrefix: copy.showingPrefix,
    showingOf: copy.showingOf,
    total: BATUMI_NEWS_ITEMS.length,
  })}
/>

<script>
  const i18nEl = document.getElementById('batumi-news-ui-i18n');
  const uiText = i18nEl?.textContent
    ? JSON.parse(i18nEl.textContent)
    : { showingPrefix: 'Showing', showingOf: 'updates of', total: 0 };

  const catButtons = document.querySelectorAll<HTMLButtonElement>('[data-news-cat]');
  const searchInput = document.getElementById('news-search-input') as HTMLInputElement | null;
  const statusSelect = document.getElementById('news-status-select') as HTMLSelectElement | null;
  const countEl = document.getElementById('news-results-count');
  const clearBtn = document.getElementById('news-clear-btn') as HTMLButtonElement | null;
  const emptyResetBtn = document.getElementById('news-empty-reset') as HTMLButtonElement | null;
  const emptyEl = document.getElementById('news-empty');
  const listItems = Array.from(document.querySelectorAll<HTMLLIElement>('[data-news-item]'));

  let activeCategory = 'all';

  const params = new URLSearchParams(window.location.search);
  const paramCat = params.get('category');
  if (paramCat) {
    const matchBtn = Array.from(catButtons).find((b) => b.dataset.newsCat === paramCat);
    if (matchBtn) {
      activeCategory = paramCat;
      catButtons.forEach((b) => {
        const isActive = b === matchBtn;
        b.classList.toggle('active', isActive);
        b.setAttribute('aria-pressed', String(isActive));
      });
    }
  }
  if (searchInput && params.get('q')) {
    searchInput.value = params.get('q') || '';
  }
  if (statusSelect && params.get('status')) {
    statusSelect.value = params.get('status') || 'all';
  }

  const applyNewsFilters = () => {
    const q = (searchInput?.value || '').trim().toLowerCase();
    const st = statusSelect?.value || 'all';
    let visible = 0;

    listItems.forEach((li) => {
      const catMatch = activeCategory === 'all' || li.dataset.category === activeCategory;
      const statusMatch = st === 'all' || li.dataset.status === st;
      const textMatch = !q || (li.dataset.search || '').includes(q);
      const show = catMatch && statusMatch && textMatch;
      li.hidden = !show;
      if (show) visible += 1;
    });

    if (countEl) {
      countEl.innerHTML = `${uiText.showingPrefix} <strong>${visible}</strong> ${uiText.showingOf} ${listItems.length}`;
    }

    const hasActiveFilter = activeCategory !== 'all' || st !== 'all' || q.length > 0;
    if (clearBtn) clearBtn.hidden = !hasActiveFilter;
    if (emptyEl) emptyEl.hidden = visible > 0;
  };

  const resetAllFilters = () => {
    activeCategory = 'all';
    catButtons.forEach((b) => {
      const isAll = b.dataset.newsCat === 'all';
      b.classList.toggle('active', isAll);
      b.setAttribute('aria-pressed', String(isAll));
    });
    if (searchInput) searchInput.value = '';
    if (statusSelect) statusSelect.value = 'all';
    applyNewsFilters();
  };

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.newsCat || 'all';
      catButtons.forEach((other) => {
        const isMatch = other === btn;
        other.classList.toggle('active', isMatch);
        other.setAttribute('aria-pressed', String(isMatch));
      });
      applyNewsFilters();
    });
  });

  searchInput?.addEventListener('input', applyNewsFilters);
  statusSelect?.addEventListener('change', applyNewsFilters);
  clearBtn?.addEventListener('click', resetAllFilters);
  emptyResetBtn?.addEventListener('click', resetAllFilters);

  const openTargetFromHash = () => {
    const hash = window.location.hash.replace(/^#/, '');
    if (!hash) return;
    const targetCard = document.getElementById(hash);
    if (!targetCard || !targetCard.classList.contains('news-card')) return;

    const parentLi = targetCard.closest<HTMLLIElement>('[data-news-item]');
    if (parentLi?.hidden) {
      resetAllFilters();
    }

    const disclosure = targetCard.querySelector<HTMLDetailsElement>('details.news-disclosure');
    if (disclosure) disclosure.open = true;

    targetCard.classList.remove('is-targeted');
    void targetCard.offsetWidth;
    targetCard.classList.add('is-targeted');
    targetCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  applyNewsFilters();
  openTargetFromHash();
  window.addEventListener('hashchange', openTargetFromHash);
</script>

