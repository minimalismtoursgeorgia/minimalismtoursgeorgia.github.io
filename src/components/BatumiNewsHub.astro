---
import { SITE } from '../data/site';
import { TOURS } from '../data/tours';
import {
  BATUMI_ANNUAL_CALENDAR,
  BATUMI_CATEGORY_LABELS,
  BATUMI_ESSENTIAL_FACTS,
  BATUMI_NEWS_FAQS,
  BATUMI_NEWS_ITEMS,
  BATUMI_NEWS_META,
  BATUMI_STATUS_LABELS,
  type BatumiNewsCategory,
  type BatumiNewsStatus,
} from '../data/batumi-news';
import { withBase } from '../lib/urls';

export interface Props {
  lang?: 'en' | 'ka';
}

const { lang = 'en' } = Astro.props;
const isKa = lang === 'ka';
const homePath = withBase(isKa ? '/ka/' : '/');

const categoryFilters: { id: 'all' | BatumiNewsCategory; label: string; count: number }[] = [
  { id: 'all', label: isKa ? 'ყველა' : 'All Updates', count: BATUMI_NEWS_ITEMS.length },
  ...(['events', 'projects', 'travel-rules', 'seasonal'] as BatumiNewsCategory[]).map((cat) => ({
    id: cat,
    label: BATUMI_CATEGORY_LABELS[cat][lang],
    count: BATUMI_NEWS_ITEMS.filter((i) => i.category === cat).length,
  })),
];

const statusOptions: { id: 'all' | BatumiNewsStatus; label: string }[] = [
  { id: 'all', label: isKa ? 'ყველა სტატუსი' : 'Any Timeline' },
  ...(['happening-soon', 'active-2026', 'planned-2027', 'annual-highlight'] as BatumiNewsStatus[]).map((st) => ({
    id: st,
    label: BATUMI_STATUS_LABELS[st][lang],
  })),
];

const copy = isKa
  ? {
      breadcrumbHome: 'მთავარი',
      breadcrumbCurrent: 'ბათუმის სიახლეები',
      eyebrow: 'ბათუმის სრული საინფორმაციო ცენტრი · 2026–2027',
      h1: 'ბათუმში დაგეგმილი სიახლეები, ღონისძიებები და წესები',
      heroDesc:
        'ყველა პასუხი ერთ გვერდზე, რომ სტუმარმა სხვაგან ძებნა არ დასჭირდეს: საახალწლო პროგრამა, ფესტივალები, სანაპირო პროექტები, 2026 წლის სავალდებულო დაზღვევა, გოდერძის სეზონი და ბილეთების ფასები.',
      verifiedLabel: 'ბოლო გადამოწმება:',
      verifiedDate: BATUMI_NEWS_META.lastVerifiedKa,
      jumpUpdates: 'მიმდინარე და დაგეგმილი სიახლეები',
      jumpCalendar: '12-თვიანი ფესტივალების კალენდარი',
      jumpResources: 'ბილეთები და კონსულტაცია',
      jumpFaq: 'ხშირი კითხვები',
      snapshotHeading: 'მთავარი ფაქტები ერთი შეხედვით',
      searchLandmarkLabel: 'ბათუმის სიახლეების ძიება და ფილტრაცია',
      searchLabel: 'ძიება საკვანძო სიტყვით',
      searchPlaceholder: 'ევროპის მოედანი, გოდერძი, დაზღვევა, ჯაზი, ბოტანიკური...',
      statusLabel: 'პერიოდი / სტატუსი',
      showingPrefix: 'ნაჩვენებია',
      showingOf: 'სიახლე სულ',
      clearFilters: 'ფილტრის გასუფთავება',
      emptyTitle: 'შესაბამისი სიახლე ვერ მოიძებნა',
      emptyDesc: 'სცადეთ სხვა საკვანძო სიტყვა ან მოგვწერეთ WhatsApp-ში თქვენი ვიზიტის კონკრეტულ თარიღებზე.',
      emptyReset: 'ყველას ჩვენება',
      emptyAsk: 'ჰკითხე გიდს WhatsApp-ში',
      venueLabel: 'ლოკაცია',
      mapsLinkLabel: 'რუკა ↗',
      admissionLabel: 'დასწრება / ფასი',
      detailsSummary: 'სრული დეტალები და გიდის რჩევა',
      guideTipLabel: 'ადგილობრივი გიდის რჩევა',
      askAboutTopic: 'იკითხე WhatsApp-ში ↗',
      relatedTourPrefix: 'შეათავსე ტურს:',
      calendarEyebrow: 'იანვრიდან დეკემბრამდე',
      calendarHeading: 'ბათუმის და აჭარის ყოველწლიური კალენდარი',
      calendarIntro:
        'რომელ თვეშიც არ უნდა გეგმავდეთ ბათუმში ჩამოსვლას, აქ ნახავთ სეზონურ ფესტივალებს, ბუნების პიკს და საუკეთესო ტურებს.',
      pairLabel: 'რეკომენდებული ტური:',
      resourcesEyebrow: 'ოფიციალური ბილეთები და კონსიერჟი',
      resourcesHeading: 'სად შევიძინოთ ბილეთები და როგორ დავგეგმოთ დღე ბათუმში',
      resourcesIntro:
        'ქვემოთ მოცემულია ოფიციალური პლატფორმები, სადაც ბილეთები იყიდება, და ჩვენი გუნდის პირდაპირი დახმარება.',
      conciergeTitle: 'Minimalism Tours Georgia — ბათუმის ლოკალური გზამკვლევი',
      conciergeDesc:
        'გჭირდებათ დაზუსტება, კონკრეტულ დღეს მუშაობს თუ არა საბაგირო, რა ხდება საახალწლო მოედანზე ან როგორ მოხვდეთ გოდერძიზე 4x4-ით? მოგვწერეთ უშუალოდ ბათუმელ გიდებს.',
      conciergeWa: 'მოგვწერეთ WhatsApp-ში',
      conciergeTg: 'მოგვწერეთ Telegram-ში',
      faqEyebrow: 'სტუმრების მთავარი კითხვები',
      faqHeading: 'ხშირად დასმული კითხვები ბათუმის სიახლეებზე',
      expandAll: 'ყველას გაშლა',
      collapseAll: 'ყველას ჩაკეცვა',
    }
  : {
      breadcrumbHome: 'Home',
      breadcrumbCurrent: 'Batumi News & Events',
      eyebrow: 'All-In-One Local Briefing · 2026–2027',
      h1: 'Batumi News, Planned Events & Visitor Updates',
      heroDesc:
        'Everything planned in Batumi—festivals, New Year’s Village schedules, coastal mega-projects, mandatory 2026 travel insurance rules, Goderdzi ski opening, and verified attraction tariffs—answered thoroughly in one place.',
      verifiedLabel: 'Last verified:',
      verifiedDate: BATUMI_NEWS_META.lastVerifiedEn,
      jumpUpdates: 'Live & Planned Updates',
      jumpCalendar: '12-Month Festival Calendar',
      jumpResources: 'Tickets & Local Concierge',
      jumpFaq: 'Visitor FAQs',
      snapshotHeading: 'Essential 2026–2027 Facts at a Glance',
      searchLandmarkLabel: 'Search and filter Batumi news and planned events',
      searchLabel: 'Search keyword',
      searchPlaceholder: 'Europe Square, Goderdzi, insurance, jazz, Botanical...',
      statusLabel: 'Timeline / Status',
      showingPrefix: 'Showing',
      showingOf: 'updates of',
      clearFilters: 'Clear Filters',
      emptyTitle: 'No matching Batumi updates found',
      emptyDesc:
        'Try another keyword or clear a filter—or message our Batumi desk directly for live date-specific advice.',
      emptyReset: 'Show All Updates',
      emptyAsk: 'Ask Local Guide on WhatsApp',
      venueLabel: 'Location',
      mapsLinkLabel: 'Map ↗',
      admissionLabel: 'Access / Price',
      detailsSummary: 'Full briefing, key dates & guide advice',
      guideTipLabel: 'Local Guide Tip',
      askAboutTopic: 'Ask on WhatsApp ↗',
      relatedTourPrefix: 'Pair with:',
      calendarEyebrow: 'January to December',
      calendarHeading: 'Year-Round Batumi & Adjara Event Calendar',
      calendarIntro:
        'No matter which month you visit Batumi, preview the signature festivals, mountain seasons, and ideal matching day tours.',
      pairLabel: 'Best paired tour:',
      resourcesEyebrow: 'Official Tickets & Live Support',
      resourcesHeading: 'How Ticketing & Daily Schedules Work in Batumi',
      resourcesIntro:
        'Save time avoiding guesswork: see where verified tickets are sold and reach our Batumi operations team anytime for live daily updates.',
      conciergeTitle: 'Minimalism Tours Georgia — Direct Batumi Concierge',
      conciergeDesc:
        'Want to check if Argo Cable Car is running in strong wind, get exact Europe Square concert hours, or arrange safe 4x4 transport to Goderdzi or Mtirala? Message our licensed local team directly.',
      conciergeWa: 'Message on WhatsApp',
      conciergeTg: 'Message on Telegram',
      faqEyebrow: 'Quick Answers',
      faqHeading: 'Batumi Events & Visitor Rules FAQ',
      expandAll: 'Expand all',
      collapseAll: 'Collapse all',
    };

const ticketingPlatforms = isKa
  ? [
      {
        name: 'TKT.ge და Biletebi.ge',
        role: 'კონცერტები, ცირკი, თეატრი და კლუბური ივენთები',
        detail: 'ბათუმის დრამატული თეატრის, STAR Circus-ის, მუსიკალური ცენტრის, Teatro-სა და სტენდ-აპ შოუების ოფიციალური ბილეთები.',
        url: 'https://tkt.ge',
      },
      {
        name: 'GoBatumi.com',
        role: 'აჭარის ტურიზმის დეპარტამენტის ოფიციალური კალენდარი',
        detail: 'მერიისა და რეგიონული ფესტივალების (ბათუმობა, განდაგანა, ზაფხულის ფესტივალი) ზუსტი დღის განრიგი.',
        url: 'https://gobatumi.com',
      },
      {
        name: 'MTA.ski',
        role: 'გოდერძის სათხილამურო ტრასების და საბაგიროების სტატუსი',
        detail: 'ზანკას გონდოლას, ჭანჭახის საბაგიროს, თოვლის საფარისა და 2026–27 სკი-პასების ყოველდღიური სტატუსი.',
        url: 'https://mta.ski',
      },
    ]
  : [
      {
        name: 'TKT.ge & Biletebi.ge',
        role: 'Concerts, STAR Circus, Theatre & NYE Club Tickets',
        detail: 'Georgia’s primary verified box offices for Batumi Drama Theatre, Music Center, STAR Circus Georgia, Teatro NYE, and touring stand-up shows.',
        url: 'https://tkt.ge',
      },
      {
        name: 'GoBatumi.com',
        role: 'Official Adjara Tourism Portal',
        detail: 'Official municipal announcements for Batumoba, Summer Festival, Gandagana, and regional folk holidays as exact dates lock in.',
        url: 'https://gobatumi.com',
      },
      {
        name: 'MTA.ski',
        role: 'Live Goderdzi Lifts & Mountain Trails Agency',
        detail: 'Check daily gondola/chairlift openings, natural snow updates, and 2026–2027 tiered ski passes before heading inland from Batumi.',
        url: 'https://mta.ski',
      },
    ];
---

<section class="page-banner">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={homePath}>{copy.breadcrumbHome}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{copy.breadcrumbCurrent}</span>
    </nav>

    <div class="news-banner-meta">
      <span class="eyebrow" style="margin-bottom: 0;">{copy.eyebrow}</span>
      <span class="badge badge-forest">
        {copy.verifiedLabel} <time datetime={BATUMI_NEWS_META.lastVerifiedIso}>{copy.verifiedDate}</time>
      </span>
    </div>

    <h1>{copy.h1}</h1>
    <p style="max-width: 50rem; font-size: 1.06rem;">{copy.heroDesc}</p>

    <nav class="news-jump-pills" aria-label={isKa ? 'სექციებზე გადასვლა' : 'On this page'}>
      <a class="btn btn-outline btn-sm" href="#live-updates">{copy.jumpUpdates}</a>
      <a class="btn btn-outline btn-sm" href="#annual-calendar">{copy.jumpCalendar}</a>
      <a class="btn btn-outline btn-sm" href="#official-resources">{copy.jumpResources}</a>
      <a class="btn btn-outline btn-sm" href="#batumi-faq">{copy.jumpFaq}</a>
    </nav>
  </div>
</section>

<!-- Essential Facts Snapshot -->
<section class="section-tight" aria-label={copy.snapshotHeading}>
  <div class="container">
    <div class="facts-snapshot-grid">
      {
        BATUMI_ESSENTIAL_FACTS.map((fact) => (
          <a href={`#${fact.targetSlug}`} class="fact-tile">
            <article class={`fact-tile-inner fact-tone-${fact.tone}`}>
              <span class="fact-kicker">{fact.kicker[lang]}</span>
              <h2>{fact.headline[lang]}</h2>
              <p>{fact.detail[lang]}</p>
            </article>
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- Filterable & Searchable Exhaustive Updates -->
<section id="live-updates" class="section">
  <div class="container">
    <search class="news-filter-shell" aria-label={copy.searchLandmarkLabel}>
      <div class="news-category-pills" role="group" aria-label={isKa ? 'კატეგორიის ფილტრი' : 'Filter by category'}>
        {
          categoryFilters.map((cat, idx) => (
            <button
              type="button"
              class={`news-cat-btn ${idx === 0 ? 'active' : ''}`}
              data-news-cat={cat.id}
              aria-pressed={idx === 0 ? 'true' : 'false'}
            >
              {cat.label} ({cat.count})
            </button>
          ))
        }
      </div>

      <div class="news-inputs-row">
        <div class="field">
          <label for="news-search-input">{copy.searchLabel}</label>
          <input
            id="news-search-input"
            type="search"
            placeholder={copy.searchPlaceholder}
            autocomplete="off"
          />
        </div>

        <div class="field">
          <label for="news-status-select">{copy.statusLabel}</label>
          <select id="news-status-select">
            {statusOptions.map((st) => <option value={st.id}>{st.label}</option>)}
          </select>
        </div>
      </div>

      <div class="news-status-bar">
        <p id="news-results-count" aria-live="polite">
          {copy.showingPrefix} <strong>{BATUMI_NEWS_ITEMS.length}</strong> {copy.showingOf} {BATUMI_NEWS_ITEMS.length}
        </p>
        <button id="news-clear-btn" type="button" class="btn btn-outline btn-sm" hidden>
          {copy.clearFilters}
        </button>
      </div>
    </search>

    <ul id="news-list" class="news-grid" role="list">
      {
        BATUMI_NEWS_ITEMS.map((item) => {
          const catMeta = BATUMI_CATEGORY_LABELS[item.category];
          const statusText = BATUMI_STATUS_LABELS[item.status][lang];
          const relatedTour = item.relatedTourSlug
            ? TOURS.find((t) => t.slug === item.relatedTourSlug)
            : undefined;
          const searchHaystack = [
            item.title[lang],
            item.summary[lang],
            item.dateRange[lang],
            item.venue[lang],
            item.admission[lang],
            item.localTip[lang],
            ...item.keyDetails[lang],
          ]
            .join(' ')
            .toLowerCase();

          return (
            <li
              data-news-item
              data-category={item.category}
              data-status={item.status}
              data-search={searchHaystack}
            >
              <article id={item.slug} class="news-card">
                {
                  item.image && item.imageAlt && (
                    <img
                      src={withBase(item.image)}
                      alt={item.imageAlt[lang]}
                      width="1200"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    />
                  )
                }

                <header class="news-card-head">
                  <div class="news-card-badges">
                    <span class={`badge ${catMeta.badgeClass}`}>{catMeta[lang]}</span>
                    <span class="news-status-pill">{statusText}</span>
                    <span class="news-date-pill">{item.dateRange[lang]}</span>
                  </div>
                  <h3>{item.title[lang]}</h3>
                </header>

                <div class="news-card-body">
                  <p class="news-summary">{item.summary[lang]}</p>

                  <dl class="news-facts">
                    <div>
                      <dt>{copy.venueLabel}</dt>
                      <dd>
                        {item.venue[lang]}
                        {item.mapsUrl && (
                          <>
                            {' '}
                            <a
                              href={item.mapsUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="news-inline-map"
                            >
                              {copy.mapsLinkLabel}
                            </a>
                          </>
                        )}
                      </dd>
                    </div>
                    <div>
                      <dt>{copy.admissionLabel}</dt>
                      <dd>{item.admission[lang]}</dd>
                    </div>
                  </dl>

                  <details class="news-disclosure">
                    <summary>{copy.detailsSummary}</summary>
                    <div class="news-disclosure-panel">
                      <ul class="news-detail-list">
                        {item.keyDetails[lang].map((bullet) => <li>{bullet}</li>)}
                      </ul>

                      <div class="news-guide-tip">
                        <strong>{copy.guideTipLabel}:</strong> {item.localTip[lang]}
                      </div>
                    </div>
                  </details>
                </div>

                <footer class="news-card-foot">
                  {relatedTour ? (
                    <a class="btn btn-forest btn-sm" href={withBase(`/tours/${relatedTour.slug}/`)}>
                      {copy.relatedTourPrefix} {relatedTour.shortTitle} →
                    </a>
                  ) : (
                    <span class="news-foot-tag">{catMeta[lang]}</span>
                  )}

                  <a
                    class="btn btn-outline btn-sm"
                    href={`${SITE.whatsappUrl}?text=${encodeURIComponent(
                      isKa
                        ? `გამარჯობა Minimalism Tours Georgia! მაინტერესებს: ${item.whatsappTopic.ka}`
                        : `Hello Minimalism Tours Georgia! I'd like details about: ${item.whatsappTopic.en}`
                    )}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {copy.askAboutTopic}
                  </a>
                </footer>
              </article>
            </li>
          );
        })
      }
    </ul>

    <div id="news-empty" class="empty-state" hidden>
      <h2>{copy.emptyTitle}</h2>
      <p>{copy.emptyDesc}</p>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem;">
        <button id="news-empty-reset" type="button" class="btn btn-forest">{copy.emptyReset}</button>
        <a
          class="btn btn-coral"
          href={`${SITE.whatsappUrl}?text=${encodeURIComponent(
            isKa
              ? 'გამარჯობა Minimalism Tours Georgia! მინდა ვიკითხო ბათუმში დაგეგმილი ღონისძიებების შესახებ.'
              : 'Hello Minimalism Tours Georgia! Could you share what is happening in Batumi during my dates?'
          )}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.emptyAsk}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Year-Round Batumi & Adjara Calendar -->
<section id="annual-calendar" class="section section-surface">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="eyebrow">{copy.calendarEyebrow}</span>
        <h2>{copy.calendarHeading}</h2>
      </div>
      <p>{copy.calendarIntro}</p>
    </div>

    <div class="calendar-grid">
      {
        BATUMI_ANNUAL_CALENDAR.map((block) => (
          <article class="calendar-card reveal-on-scroll">
            <span class="badge badge-sea">{block.months[lang]}</span>
            <h3>{block.title[lang]}</h3>
            <ul class="calendar-list">
              {block.highlights[lang].map((hl) => <li>{hl}</li>)}
            </ul>
            <footer>
              <span>{copy.pairLabel}</span>
              <a href={withBase(`/tours/${block.pairWithTourSlug}/`)}>
                {block.pairWithTourLabel[lang]} →
              </a>
            </footer>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Ticketing & Direct Local Concierge -->
<section id="official-resources" class="section section-forest">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="eyebrow">{copy.resourcesEyebrow}</span>
        <h2>{copy.resourcesHeading}</h2>
      </div>
      <p>{copy.resourcesIntro}</p>
    </div>

    <div class="resources-layout">
      <div class="resources-list">
        {
          ticketingPlatforms.map((plat) => (
            <article class="resource-item">
              <span class="resource-role">{plat.role}</span>
              <h3>
                <a href={plat.url} target="_blank" rel="noopener noreferrer">
                  {plat.name} ↗
                </a>
              </h3>
              <p>{plat.detail}</p>
            </article>
          ))
        }
