---
import { SITE } from '../data/site';
import {
  BATUMI_CATEGORY_LABELS,
  BATUMI_NEWS_ITEMS,
  BATUMI_NEWS_META,
  BATUMI_STATUS_LABELS,
} from '../data/batumi-news';
import { withBase } from '../lib/urls';

export interface Props {
  lang?: 'en' | 'ka';
}

const { lang = 'en' } = Astro.props;
const isKa = lang === 'ka';
const hubPath = withBase(isKa ? '/ka/batumi-news/' : '/batumi-news/');
const featuredItems = BATUMI_NEWS_ITEMS.filter((item) => item.featuredOnHome).slice(0, 4);

const copy = isKa
  ? {
      eyebrow: `ბათუმის ცოცხალი გზამკვლევი · განახლდა ${BATUMI_NEWS_META.lastVerifiedKa}`,
      heading: 'რა ხდება და რა იგეგმება ბათუმში (2026–2027)',
      intro:
        'საახალწლო სოფელი ევროპის მოედანზე, გოდერძის ზამთრის სეზონი, 2026 წლის სავალდებულო დაზღვევის წესი და სანაპირო მეგაპროექტები — ყველა გადამოწმებული პასუხი მხოლოდ ჩვენს საიტზე.',
      ctaAll: `ყველა სიახლე და კალენდარი (${BATUMI_NEWS_ITEMS.length}) →`,
      ctaAsk: 'ჰკითხე ადგილობრივ გიდს WhatsApp-ში',
      bottomNote:
        'გინდათ ზუსტი თარიღების, ბილეთების ან ღონისძიებების ტურთან შეთავსების დაზუსტება? სრულ გვერდზე ნახავთ 10 დეტალურ ბრიფინგს და 12-თვიან ფესტივალების კალენდარს.',
      waText:
        'გამარჯობა Minimalism Tours Georgia! მაინტერესებს ბათუმში დაგეგმილი სიახლეები და ტურის დაგეგმვა ჩემს თარიღებზე.',
    }
  : {
      eyebrow: `Batumi Live Guide · Verified ${BATUMI_NEWS_META.lastVerifiedEn}`,
      heading: 'What’s Happening & Planned in Batumi (2026–2027)',
      intro:
        'From Europe Square’s New Year’s Village and Goderdzi ski opening to mandatory 2026 travel insurance and coastal mega-projects—get complete, guide-verified answers right here without searching elsewhere.',
      ctaAll: `Full Batumi News & Calendar (${BATUMI_NEWS_ITEMS.length}) →`,
      ctaAsk: 'Ask a Local Guide on WhatsApp',
      bottomNote:
        'Explore all 10 verified briefings, attraction hours & ticket prices, and our 12-month Batumi & Adjara festival calendar on the dedicated hub.',
      waText:
        'Hello Minimalism Tours Georgia! I saw your Batumi News guide and would like advice for my upcoming travel dates.',
    };
---

<section id="batumi-news" class="section section-surface">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="eyebrow">{copy.eyebrow}</span>
        <h2>{copy.heading}</h2>
      </div>
      <div>
        <p>{copy.intro}</p>
      </div>
    </div>

    <div class="news-teaser-grid">
      {
        featuredItems.map((item) => {
          const cat = BATUMI_CATEGORY_LABELS[item.category];
          const statusLabel = BATUMI_STATUS_LABELS[item.status][lang];
          const targetHref = `${hubPath}#${item.slug}`;

          return (
            <article class="news-teaser-card reveal-on-scroll">
              <header>
                <div class="news-teaser-badges">
                  <span class={`badge ${cat.badgeClass}`}>{cat[lang]}</span>
                  <span class="news-status-pill">{statusLabel}</span>
                </div>
                <h3>
                  <a class="card-link" href={targetHref}>
                    {item.title[lang]}
                  </a>
                </h3>
              </header>

              <p>{item.summary[lang]}</p>

              <footer>
                <span class="news-teaser-date">{item.dateRange[lang]}</span>
                <span class="news-teaser-arrow" aria-hidden="true">
                  {isKa ? 'სრულად →' : 'Read briefing →'}
                </span>
              </footer>
            </article>
          );
        })
      }
    </div>

    <div class="news-teaser-bar">
      <p>{copy.bottomNote}</p>
      <div class="news-teaser-actions">
        <a class="btn btn-forest" href={hubPath}>
          {copy.ctaAll}
        </a>
        <a
          class="btn btn-coral"
          href={`${SITE.whatsappUrl}?text=${encodeURIComponent(copy.waText)}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.ctaAsk}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .news-teaser-grid {
    display: grid;
    gap: 1.35rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17.5rem), 1fr));
  }

  .news-teaser-card {
    container-type: inline-size;
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.35rem;
    box-shadow: var(--shadow-xs);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.85rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  @supports (grid-template-rows: subgrid) {
    .news-teaser-grid {
      row-gap: 1.35rem;
      column-gap: 1.35rem;
    }

    .news-teaser-card {
      grid-row: span 3;
      grid-template-rows: subgrid;
      align-content: start;
    }
  }

  .news-teaser-card:has(a.card-link) {
    position: relative;
  }

  .news-teaser-card a.card-link {
    color: var(--ink-900);
    text-decoration: none;
  }

  .news-teaser-card a.card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .news-teaser-card a.card-link:focus-visible {
    outline: none;
  }

  .news-teaser-card:has(a.card-link:focus-visible) {
    outline: 3px solid var(--coral-600);
    outline-offset: 3px;
  }

  .news-teaser-card:has(a.card-link:hover) {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .news-teaser-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.65rem;
  }

  .news-status-pill {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--ink-600);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
  }

  .news-teaser-card h3 {
    font-size: 1.15rem;
    margin: 0;
    line-height: 1.3;
  }

  .news-teaser-card > p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-700);
  }

  .news-teaser-card > footer {
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem 0.75rem;
  }

  .news-teaser-date {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-600);
  }

  .news-teaser-arrow {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--forest-800);
  }

  .news-teaser-card:has(a.card-link:hover) .news-teaser-arrow {
    color: var(--coral-600);
  }

  .news-teaser-bar {
    margin-top: 1.75rem;
    padding: 1.15rem 1.35rem;
    border-radius: var(--radius-lg);
    background-color: var(--forest-100);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
  }

  .news-teaser-bar p {
    margin: 0;
    max-width: 40rem;
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--ink-900);
  }

  .news-teaser-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
</style>
