---
import type { Tour } from '../data/tours';
import { withBase } from '../lib/urls';
import { localizePath, type Lang } from '../lib/i18n';

export interface Props {
  tour: Tour;
  priority?: boolean;
  lang?: Lang;
}

const { tour, priority = false, lang = 'en' } = Astro.props;
const isPl = lang === 'pl';
const isUk = lang === 'uk';
const isHe = lang === 'he';
---

<article
  class="tour-card reveal-on-scroll"
  data-category={tour.category}
  data-region={tour.regionSlug}
  data-duration={tour.durationBucket}
  data-difficulty={tour.difficulty}
  data-price={tour.startingPriceEur ?? 9999}
  data-hours={tour.durationHours}
  data-search={`${tour.title} ${tour.region} ${tour.category} ${tour.summary}`.toLowerCase()}
>
  <img
    src={withBase(tour.heroImage)}
    alt={tour.heroAlt}
    width="1200"
    height="750"
    loading={priority ? undefined : 'lazy'}
    decoding="async"
  />
  <header>
    <div class="tour-card-meta">
      {
        tour.cardTags && tour.cardTags.length > 0 ? (
          tour.cardTags.map((tag, idx) => (
            <span class={`badge ${idx === 0 ? 'badge-forest' : idx === 1 ? 'badge-sea' : 'badge-coral'}`}>
              {tag}
            </span>
          ))
        ) : (
          <>
            <span class="badge badge-forest">{tour.category}</span>
            <span class="badge badge-sea">{tour.duration}</span>
          </>
        )
      }
    </div>
    <h3>
      <a class="card-link" href={withBase(localizePath(`/tours/${tour.slug}/`, lang))}>
        {tour.shortTitle}
      </a>
    </h3>
  </header>
  <div class="tour-card-body">
    <p>{tour.summary}</p>
    <ul class="tour-facts-inline">
      <li>📍 {tour.region}</li>
      <li>🥾 {tour.difficulty}</li>
      <li>👥 {tour.groupSize}</li>
    </ul>
  </div>
  <footer>
    <div class="tour-price-block">
      <span class="tour-price-kicker">
        {tour.startingPriceEur !== null
          ? (isPl ? 'Cena grupowa już od' : isUk ? 'Групова ціна від' : isHe ? 'מחיר קבוצתי החל מ-' : 'Direct Group Rate From')
          : (tour.quoteLabel || (isPl ? 'Wyprawa sezonowa' : isUk ? 'Сезонна експедиція' : isHe ? 'משלחת עונתית' : 'Seasonal Expedition'))}
      </span>
      <span class="tour-price-value">
        {tour.startingPriceEur !== null
          ? `€${tour.startingPriceEur} / ${isPl ? 'os.' : isUk ? 'ос.' : isHe ? 'אדם' : 'guest'}`
          : (isPl ? 'Wycena indywidualna' : isUk ? 'Індивідуальний розрахунок' : isHe ? 'הצעת מחיר מותאמת' : 'Custom Quote')}
      </span>
    </div>
    <span class="btn btn-outline btn-sm" aria-hidden="true">{isPl ? 'Zobacz →' : isUk ? 'Детальніше →' : isHe ? 'לפרטים →' : 'Explore →'}</span>
  </footer>
</article>
