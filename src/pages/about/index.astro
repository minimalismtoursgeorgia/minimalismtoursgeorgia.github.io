---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  SITE,
  CERTIFICATIONS,
  VEHICLES,
  CONTENT_PILLARS,
} from '../../data/site';
import { withBase, absoluteUrl } from '../../lib/urls';

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'About', item: absoluteUrl('/about/', Astro.site) },
  ],
};
---

<BaseLayout
  title={`About ${SITE.brandName} | Batumi Tour Operator & Adjara DMC`}
  description="Minimalism Tours Georgia is a Batumi-based licensed tour operator and Adjara DMC with over 10 years of experience operating under GMGA/FMGA, UNESCO Heritage, and Red Cross First Aid standards."
  canonicalPath="/about/"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">About</span>
      </nav>
      <span class="eyebrow">Licensed Local Tour Operator &amp; DMC · Batumi</span>
      <h1>About Minimalism Tours Georgia</h1>
      <p style="max-width: 46rem; font-size: 1.05rem;">
        “{SITE.motto}” — unhurried nature, cultural, and B2B excursions across Adjara and Georgia, backed by certified guiding teams and transparent ground logistics.
      </p>
    </div>
  </section>

  <!-- Company Operations & Philosophy -->
  <section class="section">
    <div class="container founder-grid">
      <div class="founder-photo">
        <img
          src={withBase('/images/mtirala-canopy.webp')}
          alt="UNESCO Colchic temperate rainforest canopy in Mtirala National Park near Batumi, Georgia"
          fetchpriority="high"
          width="1200"
          height="800"
          decoding="async"
        />
      </div>

      <div>
        <span class="eyebrow">Batumi Tour Operator &amp; Adjara DMC</span>
        <h2>Minimalism Tours Georgia · {SITE.experienceYears}+ Years Operating Across Georgia</h2>
        <p>
          Based in Batumi on the Black Sea coast, Minimalism Tours Georgia operates small-group, private, and B2B ground handling programs for travelers and trade partners who want deeper local quality than rushed coach stops. From UNESCO-listed Colchic rainforests in Mtirala and Machakhela to high-mountain expeditions in Kazbegi and Svaneti, our team prioritizes ecological understanding, vetted village hospitality, and dependable pacing.
        </p>
        <p>
          Every itinerary lists honest walking difficulty, active weather contingency plans, exact pickup points, and complete price transparency — no surprise entry tickets at park gates, and clear net or direct rates.
        </p>

        <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem;">
          <a class="btn btn-coral" href={withBase('/tours/')}>Explore Our Tours</a>
          <a class="btn btn-forest" href={withBase('/partners/')}>B2B &amp; Agency Partnerships</a>
          <a class="btn btn-outline" href={SITE.youtubeUrl} target="_blank" rel="noopener noreferrer">
            Watch Routes on YouTube ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Certifications -->
  <section class="section section-surface">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Training &amp; Guest Safety</span>
          <h2>Verified Guiding Certifications</h2>
        </div>
        <p>Official training credentials held in ecological interpretation, mountain trekking, and emergency first aid.</p>
      </div>

      <div class="cert-grid">
        {
          CERTIFICATIONS.map((c) => (
            <article class="cert-card reveal-on-scroll">
              <span class="badge badge-forest">{c.issuer}</span>
              <h3>{c.title}</h3>
              <p>{c.scope}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Vehicles & Onboard Comfort -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Mountain &amp; Coastal Transport</span>
          <h2>Tour Vehicles Matched to Group Size &amp; Terrain</h2>
        </div>
        <p>Comfortable, climate-controlled transport equipped with Wi-Fi for mountain climbs and coastal drives.</p>
      </div>

      <div class="vehicle-grid">
        {
          VEHICLES.map((v) => (
            <article class="vehicle-card reveal-on-scroll">
              <span class="badge badge-sea">{v.capacity}</span>
              <h3>{v.name}</h3>
              <p>{v.idealFor}</p>
              <ul>
                {v.amenities.map((a) => <li>{a}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Brand Pillars + B2B Partnerships -->
  <section class="section section-forest">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">How We Operate</span>
          <h2>Four Guiding Standards &amp; Partner Inquiries</h2>
        </div>
      </div>

      <div class="about-pillars">
        {
          CONTENT_PILLARS.map((p) => (
            <div class="about-pillar">
              <h3>{p.name}</h3>
              <p>{p.summary}</p>
            </div>
          ))
        }
      </div>

      <div class="b2b-box">
        <div>
          <h3>Hotels, Hostels &amp; Inbound Travel Partners</h3>
          <p style="margin-bottom: 0;">
            Need reliable small-group or private Batumi departures for your guests? Contact us directly for a current one-page experience brief, seasonal capacity availability, and clear written referral terms.
          </p>
        </div>
        <a class="btn btn-coral" href={withBase('/partners/#b2b-inquiry')}>Request Partner Brief</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-banner {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--ink-600);
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--ink-700);
    text-decoration: none;
    font-weight: 600;
  }

  .founder-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 54rem) {
    .founder-grid {
      grid-template-columns: minmax(17rem, 23rem) 1fr;
    }
  }

  .founder-photo {
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-md);
  }

  .founder-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
  }

  .cert-grid,
  .vehicle-grid,
  .about-pillars {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .cert-card,
  .vehicle-card {
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.4rem;
  }

  .vehicle-card {
    background-color: var(--bg-surface);
  }

  .cert-card h3,
  .vehicle-card h3 {
    margin-top: 0.85rem;
    margin-bottom: 0.5rem;
    font-size: 1.18rem;
  }

  .cert-card p {
    margin-bottom: 0;
    font-size: 0.93rem;
  }

  .vehicle-card ul {
    margin: 0.85rem 0 0;
    padding-inline-start: 1.15rem;
    font-size: 0.9rem;
    color: var(--ink-700);
    display: grid;
    gap: 0.3rem;
  }

  .about-pillar {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-md);
    padding: 1.2rem;
  }

  .about-pillar h3 {
    color: #f4b69f;
    font-size: 1.12rem;
    margin-bottom: 0.45rem;
  }

  .about-pillar p {
    margin: 0;
    font-size: 0.92rem;
  }

  .b2b-box {
    margin-top: 2rem;
    padding: 1.65rem;
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.22);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .b2b-box h3 {
    margin-bottom: 0.4rem;
  }

  .b2b-box > div {
    max-width: 44rem;
  }
</style>
