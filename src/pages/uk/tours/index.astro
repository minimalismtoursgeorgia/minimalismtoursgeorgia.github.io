---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TourCard from '../../../components/TourCard.astro';
import GroupInquiryForm from '../../../components/GroupInquiryForm.astro';
import { SITE } from '../../../data/site';
import {
  UK_CATEGORY_LABELS,
  UK_DIFFICULTY_LABELS,
  getToursForLangUk,
} from '../../../data/i18n-uk';
import { absoluteUrl, withBase } from '../../../lib/urls';

const ukTours = getToursForLangUk('uk');

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Головна', item: absoluteUrl('/uk/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'Екскурсії', item: absoluteUrl('/uk/tours/', Astro.site) },
  ],
};

const regions = Array.from(new Set(ukTours.map((t) => t.regionSlug)));
const categories = Array.from(new Set(ukTours.map((t) => t.category)));
---

<BaseLayout
  title={`Усі тури та екскурсії Грузією з Батумі | ${SITE.brandName}`}
  description="Переглядайте всі тури з гідом: Національний парк Мтірала, Ботанічний сад, Ущелина Мачахела, Старий Батумі та сходження на Казбек."
  canonicalPath="/uk/tours/"
  alternateEnPath="/tours/"
  alternateKaPath="/ka/"
  alternatePlPath="/pl/tours/"
  alternateUkPath="/uk/tours/"
  alternateHePath="/he/tours/"
  lang="uk"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/uk/')}>Головна</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Екскурсії</span>
      </nav>
      <span class="eyebrow">{ukTours.length} автентичних маршрутів</span>
      <h1>Екскурсії з гідом по Аджарії та Грузії</h1>
      <p style="max-width: 44rem; font-size: 1.05rem;">
        Фільтруйте за регіоном, тривалістю, складністю або ключовим словом. Кожен маршрут має чесну оцінку фізичного навантаження, перелік включених послуг і прозорі групові тарифи.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="filter-bar" role="region" aria-label="Фільтр та сортування турів">
        <div class="field">
          <label for="f-search">Пошук за словом</label>
          <input id="f-search" type="search" placeholder="водоспад, обід, канатка, Казбек..." />
        </div>

        <div class="field">
          <label for="f-region">Регіон</label>
          <select id="f-region">
            <option value="">Усі регіони</option>
            {
              regions.map((slug) => {
                const label = ukTours.find((t) => t.regionSlug === slug)?.region || slug;
                return <option value={slug}>{label}</option>;
              })
            }
          </select>
        </div>

        <div class="field">
          <label for="f-category">Стиль</label>
          <select id="f-category">
            <option value="">Усі стилі</option>
            {categories.map((cat) => <option value={cat}>{UK_CATEGORY_LABELS[cat]}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="f-duration">Тривалість</label>
          <select id="f-duration">
            <option value="">Будь-яка тривалість</option>
            <option value="half-day">Пів дня (~3 год)</option>
            <option value="full-day">Повний день (6–7 год)</option>
            <option value="multi-day">Багатоденні (2–8 днів)</option>
          </select>
        </div>

        <div class="field">
          <label for="f-difficulty">Складність</label>
          <select id="f-difficulty">
            <option value="">Усі рівні</option>
            <option value="Easy">{UK_DIFFICULTY_LABELS['Easy']}</option>
            <option value="Easy–Moderate">{UK_DIFFICULTY_LABELS['Easy–Moderate']}</option>
            <option value="Moderate">{UK_DIFFICULTY_LABELS['Moderate']}</option>
            <option value="Moderate–Challenging">{UK_DIFFICULTY_LABELS['Moderate–Challenging']}</option>
            <option value="Challenging">{UK_DIFFICULTY_LABELS['Challenging']}</option>
          </select>
        </div>

        <div class="field">
          <label for="f-sort">Сортувати за</label>
          <select id="f-sort">
            <option value="featured">Рекомендовані</option>
            <option value="price-asc">Найнижча групова ціна</option>
            <option value="duration-asc">Найкоротший час</option>
            <option value="duration-desc">Найдовша подорож</option>
          </select>
        </div>
      </div>

      <div class="filter-status-row">
        <p id="tours-count" aria-live="polite">
          Показано <strong>{ukTours.length}</strong> з {ukTours.length} турів
        </p>
        <button id="reset-filters-btn" type="button" class="btn btn-outline btn-sm" hidden>
          Скинути фільтри
        </button>
      </div>

      <div id="tours-grid" class="tours-grid">
        {ukTours.map((tour, idx) => <TourCard tour={tour} priority={idx < 2} lang="uk" />)}
      </div>

      <div id="tours-empty" class="empty-state" hidden>
        <h2>Відповідних маршрутів не знайдено</h2>
        <p>Спробуйте очистити один із фільтрів або напишіть нашій команді, який індивідуальний чи B2B маршрут ви плануєте.</p>
        <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem;">
          <button id="empty-reset-btn" type="button" class="btn btn-forest">Показати всі тури</button>
          <a class="btn btn-coral" href={withBase('/uk/contact/')}>Запитати індивідуальний маршрут</a>
        </div>
      </div>

      <GroupInquiryForm
        lang="uk"
        heading="Групові поїздки та багатоденне планування"
        intro="Плануєте студентський лижний табір у Бакуріані, біговий тиждень Jorunners ~50 км або виїзд для великої групи? Налаштуйте запит нижче."
      />
    </div>
  </section>
</BaseLayout>

<script>
  const searchEl = document.getElementById('f-search') as HTMLInputElement | null;
  const regionEl = document.getElementById('f-region') as HTMLSelectElement | null;
  const categoryEl = document.getElementById('f-category') as HTMLSelectElement | null;
  const durationEl = document.getElementById('f-duration') as HTMLSelectElement | null;
  const difficultyEl = document.getElementById('f-difficulty') as HTMLSelectElement | null;
  const sortEl = document.getElementById('f-sort') as HTMLSelectElement | null;
  const grid = document.getElementById('tours-grid');
  const countEl = document.getElementById('tours-count');
  const resetBtn = document.getElementById('reset-filters-btn') as HTMLButtonElement | null;
  const emptyResetBtn = document.getElementById('empty-reset-btn');
  const emptyState = document.getElementById('tours-empty');

  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.tour-card')) : [];

  const params = new URLSearchParams(window.location.search);
  if (regionEl && params.get('region')) regionEl.value = params.get('region') || '';
  if (durationEl && params.get('duration')) durationEl.value = params.get('duration') || '';
  if (difficultyEl && params.get('difficulty')) difficultyEl.value = params.get('difficulty') || '';
  if (categoryEl && params.get('category')) categoryEl.value = params.get('category') || '';
  if (searchEl && params.get('q')) searchEl.value = params.get('q') || '';

  const applyFilters = () => {
    const q = (searchEl?.value || '').trim().toLowerCase();
    const region = regionEl?.value || '';
    const category = categoryEl?.value || '';
    const duration = durationEl?.value || '';
    const difficulty = difficultyEl?.value || '';
    const sortBy = sortEl?.value || 'featured';

    let visibleCount = 0;

    cards.forEach((card) => {
      const matchQ = !q || (card.dataset.search || '').includes(q);
      const matchRegion = !region || card.dataset.region === region;
      const matchCat = !category || card.dataset.category === category;
      const matchDur = !duration || card.dataset.duration === duration;
      const matchDiff = !difficulty || card.dataset.difficulty === difficulty;
      const show = matchQ && matchRegion && matchCat && matchDur && matchDiff;
      card.hidden = !show;
      if (show) visibleCount += 1;
    });

    if (grid) {
      const sorted = [...cards].sort((a, b) => {
        if (sortBy === 'price-asc') {
          return Number(a.dataset.price || 9999) - Number(b.dataset.price || 9999);
        }
        if (sortBy === 'duration-asc') {
          return Number(a.dataset.hours || 0) - Number(b.dataset.hours || 0);
        }
        if (sortBy === 'duration-desc') {
          return Number(b.dataset.hours || 0) - Number(a.dataset.hours || 0);
        }
        return 0;
      });
      if (sortBy !== 'featured') {
        sorted.forEach((c) => grid.appendChild(c));
      }
    }

    const hasActiveFilter = Boolean(q || region || category || duration || difficulty);
    if (resetBtn) resetBtn.hidden = !hasActiveFilter;
    if (emptyState) emptyState.hidden = visibleCount > 0;
    if (countEl) {
      countEl.innerHTML = `Показано <strong>${visibleCount}</strong> з ${cards.length} турів`;
    }
  };

  const resetAll = () => {
    if (searchEl) searchEl.value = '';
    if (regionEl) regionEl.value = '';
    if (categoryEl) categoryEl.value = '';
    if (durationEl) durationEl.value = '';
    if (difficultyEl) difficultyEl.value = '';
    if (sortEl) sortEl.value = 'featured';
    window.history.replaceState({}, '', window.location.pathname);
    applyFilters();
  };

  [searchEl, regionEl, categoryEl, durationEl, difficultyEl, sortEl].forEach((el) => {
    el?.addEventListener('input', applyFilters);
    el?.addEventListener('change', applyFilters);
  });

  resetBtn?.addEventListener('click', resetAll);
  emptyResetBtn?.addEventListener('click', resetAll);

  applyFilters();
</script>

<style>
  .page-banner {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--ink-600);
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--ink-700);
    text-decoration: none;
    font-weight: 600;
  }

  .filter-bar {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(11.5rem, 1fr));
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.15rem;
    box-shadow: var(--shadow-xs);
    margin-bottom: 1.25rem;
  }

  .filter-status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.35rem;
  }

  .filter-status-row p {
    margin: 0;
    font-size: 0.94rem;
    color: var(--ink-700);
  }

  .empty-state {
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-xl);
    padding: 3rem 1.5rem;
    text-align: center;
    margin-top: 1.5rem;
  }
</style>
