---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReviewsSection from '../../../components/ReviewsSection.astro';
import { SITE } from '../../../data/site';
import {
  UK_B2B_PARTNER_TYPES,
  UK_B2B_GUARANTEES,
  UK_VEHICLES,
  UK_CERTIFICATIONS,
  getReviewsForLangUk,
} from '../../../data/i18n-uk';
import { withBase, absoluteUrl } from '../../../lib/urls';

const ukPartnerProofReviews = getReviewsForLangUk('uk').filter(
  (review) => review.category === 'b2b' || review.category === 'safety-cancellation',
);

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Головна', item: absoluteUrl('/uk/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'B2B та Партнери', item: absoluteUrl('/uk/partners/', Astro.site) },
  ],
};
---

<BaseLayout
  title={`Співпраця B2B та DMC-обслуговування в Грузії | ${SITE.brandName}`}
  description="Співпрацюйте з Minimalism Tours Georgia для DMC-обслуговування в Батумі та Аджарії, готельних екскурсій, корпоративних виїздів і сертифікованої логістики по всій Грузії."
  canonicalPath="/uk/partners/"
  alternateEnPath="/partners/"
  alternateKaPath="/ka/"
  alternatePlPath="/pl/partners/"
  alternateUkPath="/uk/partners/"
  lang="uk"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/uk/')}>Головна</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">B2B та Партнери</span>
      </nav>
      <span class="eyebrow">DMC Батумі й Аджарія · Операції для туріндустрії</span>
      <h1>Наземне B2B-обслуговування та партнерство з агентствами</h1>
      <p style="max-width: 48rem; font-size: 1.05rem;">
        {SITE.brandName} забезпечує надійні локальні операції з Батумі по Аджарії, Колхіді, Сванетії та Казбегі для міжнародних туроператорів, готелів, компаній і академічних чи круїзних груп.
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.35rem;">
        <a
          class="btn btn-coral"
          href={`${SITE.whatsappUrl}?text=${encodeURIComponent('Вітаю, Minimalism Tours Georgia B2B! Хотіли б обговорити B2B нетто-тарифи та наземне обслуговування в Батумі / Грузії.')}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Запросити B2B-прайс у WhatsApp →
        </a>
        <a
          class="btn btn-forest"
          href={`${SITE.telegramUrl}?text=${encodeURIComponent('Вітаю, Minimalism Tours Georgia B2B! Хотіли б обговорити співпрацю з агентством/готелем.')}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Написати у B2B-відділ у Telegram
        </a>
        <a class="btn btn-outline" href="#b2b-inquiry">Заповнити партнерський запит</a>
      </div>
    </div>
  </section>

  <!-- Who We Partner With -->
  <section id="partner-types" class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Гнучкі формати співпраці</span>
          <h2>З ким ми співпрацюємо</h2>
        </div>
        <p>Рішення для туристичних агентств, готелів, корпоративних команд і тематичних груп.</p>
      </div>

      <div class="partner-grid">
        {
          UK_B2B_PARTNER_TYPES.map((partner) => (
            <article class="partner-card reveal-on-scroll">
              <span class="badge badge-forest">{partner.tag}</span>
              <h3>{partner.title}</h3>
              <p>{partner.summary}</p>
              <ul class="partner-points">
                {partner.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Operational Guarantees & Fleet -->
  <section id="guarantees" class="section section-surface">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Операційні стандарти та логістика</span>
          <h2>Гарантії B2B-сервісу та автопарк</h2>
        </div>
        <p>Стабільна безпека, прозоре ціноутворення та погодний супровід від узбережжя до високогір’я.</p>
      </div>

      <div class="guarantees-grid">
        {
          UK_B2B_GUARANTEES.map((g) => (
            <article class="guarantee-card reveal-on-scroll">
              <h3>{g.title}</h3>
              <p>{g.detail}</p>
            </article>
          ))
        }
      </div>

      <div class="fleet-subhead">
        <span class="eyebrow">Власний автопарк</span>
        <h3>Класи авто під розмір групи (1–16+ гостей)</h3>
      </div>

      <div class="fleet-grid">
        {
          UK_VEHICLES.map((v) => (
            <article class="fleet-card reveal-on-scroll">
              <span class="badge badge-sea">{v.capacity}</span>
              <h4>{v.name}</h4>
              <p>{v.idealFor}</p>
              <ul>
                {v.amenities.map((a) => <li>{a}</li>)}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="cert-strip" aria-label="Сертифікати гідів та безпеки">
        {
          UK_CERTIFICATIONS.map((c) => (
            <span class="badge badge-forest">{c.title}</span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Proven B2B & Safety Track Record -->
  <ReviewsSection
    sectionId="partner-proof"
    reviews={ukPartnerProofReviews}
    variant="band"
    surface="subtle"
    eyebrow="Підтверджена практика B2B та безпеки"
    heading="Відгуки партнерів і відповідальна реакція на погоду"
    intro="Реальні відгуки міжнародного туроператора та гостей, чиї виїзди були чесно скасовані заради безпеки на гірських стежках."
    showPlatformBar={false}
    lang="uk"
  />

  <!-- Request B2B Tariff / Partner Brief -->
  <section id="b2b-inquiry" class="section">
    <div class="container b2b-form-wrap">
      <div class="b2b-form-card">
        <span class="eyebrow">Цілодобовий B2B-офіс 24/7</span>
        <h2>Запросити B2B-тариф або групову пропозицію</h2>
        <p style="font-size: 0.94rem; margin-bottom: 1.5rem;">
          Вкажіть дані вашої компанії та побажання щодо маршруту нижче, щоб миттєво сформувати запит для <strong>WhatsApp</strong>, <strong>Telegram</strong> або скопіювати його в буфер обміну.
        </p>

        <form id="b2b-partner-form" class="form-grid" data-enhanced-validation novalidate>
          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="p-company">Назва компанії / агентства *</label>
              <span id="p-company-hint" class="field-hint">Потрібно для підготовки партнерського розрахунку</span>
              <input
                id="p-company"
                name="company"
                type="text"
                required
                minlength="2"
                autocomplete="organization"
                aria-describedby="p-company-hint"
                data-error="p-company-error"
                placeholder="напр. Travel DMC або Готель Батумі"
              />
              <div id="p-company-error" class="error-msg">
                <span role="img" aria-label="Помилка">⚠</span> Введіть щонайменше 2 символи для назви компанії.
              </div>
            </div>

            <div class="field">
              <label for="p-type">Тип партнера *</label>
              <span id="p-type-hint" class="field-hint">Оберіть основну модель співпраці</span>
              <select
                id="p-type"
                name="partnerType"
                required
                aria-describedby="p-type-hint"
                data-error="p-type-error"
              >
                <option value="">Оберіть тип партнера...</option>
                <option value="Турагентство / Туроператор / DMC">Турагентство / Туроператор / DMC</option>
                <option value="Готель / Консьєрж у Батумі">Готель / Консьєрж у Батумі</option>
                <option value="Корпоративний виїзд / Тімбілдінг">Корпоративний виїзд / Тімбілдінг</option>
                <option value="Круїзна екскурсія / Академічна група">Круїзна екскурсія / Академічна група</option>
                <option value="Індивідуальне B2B DMC-обслуговування">Індивідуальне B2B DMC-обслуговування</option>
              </select>
              <div id="p-type-error" class="error-msg">
                <span role="img" aria-label="Помилка">⚠</span> Оберіть тип партнера.
              </div>
            </div>
          </div>

          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="p-location">Країна / Місто</label>
              <span id="p-location-hint" class="field-hint">Звідки ваші гості або де працює агентство</span>
              <input
                id="p-location"
                name="location"
                type="text"
                autocomplete="country-name"
                aria-describedby="p-location-hint"
                placeholder="напр. Київ, Україна / Батумі, Грузія"
              />
            </div>

            <div class="field">
              <label for="p-group">Орієнтовний розмір групи та сезон</label>
              <span id="p-group-hint" class="field-hint">Необов’язково: кількість гостей, регулярність або місяці</span>
              <input
                id="p-group"
                name="groupSeason"
                type="text"
                aria-describedby="p-group-hint"
                placeholder="напр. 6–14 гостей · Травень–Вересень"
              />
            </div>
          </div>

          <div class="field">
            <label for="p-notes">Маршрути, мови та операційні примітки</label>
            <span id="p-notes-hint" class="field-hint">Необов’язково: нетто-ставки чи комісія, white-label гід, модулі Мтірала/Казбегі/Сванетія</span>
            <textarea
              id="p-notes"
              name="notes"
              aria-describedby="p-notes-hint"
              placeholder="Опишіть бажані програми, точки збору чи багатоденні вимоги..."
            ></textarea>
          </div>

          <div class="b2b-submit-row">
            <button type="submit" class="btn btn-coral">Надіслати у WhatsApp →</button>
            <button id="p-tg-btn" type="button" class="btn btn-forest">Надіслати у Telegram →</button>
            <button id="p-copy-btn" type="button" class="btn btn-outline">Копіювати B2B-запит</button>
          </div>

          <p id="p-feedback" class="b2b-feedback" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script
  id="partners-config"
  type="application/json"
  set:html={JSON.stringify({
    whatsappUrl: SITE.whatsappUrl,
    telegramUrl: SITE.telegramUrl,
  })}
/>

<script>
  const cfgNode = document.getElementById('partners-config');
  const cfg = cfgNode?.textContent ? JSON.parse(cfgNode.textContent) : null;

  const form = document.getElementById('b2b-partner-form') as HTMLFormElement | null;
  const tgBtn = document.getElementById('p-tg-btn');
  const copyBtn = document.getElementById('p-copy-btn');
  const feedbackEl = document.getElementById('p-feedback');

  const getBrief = () => {
    if (!form) return '';
    const d = new FormData(form);
    return [
      'Minimalism Tours Georgia — Партнерський запит B2B (UA)',
      `Компанія / Агентство: ${d.get('company')}`,
      `Тип партнера: ${d.get('partnerType')}`,
      d.get('location') ? `Країна / Місто: ${d.get('location')}` : '',
      d.get('groupSeason') ? `Розмір групи та сезон: ${d.get('groupSeason')}` : '',
      d.get('notes') ? `Примітки: ${d.get('notes')}` : '',
    ]
      .filter(Boolean)
      .join('\n');
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity() || !cfg) return;
    const url = `${cfg.whatsappUrl}?text=${encodeURIComponent(getBrief())}`;
    window.open(url, '_blank', 'noopener,noreferrer');
    if (feedbackEl) {
      feedbackEl.textContent = 'Відкриваємо WhatsApp із заповненим B2B-запитом.';
    }
  });

  tgBtn?.addEventListener('click', () => {
    if (!form || !form.reportValidity() || !cfg) return;
    const url = `${cfg.telegramUrl}?text=${encodeURIComponent(getBrief())}`;
    window.open(url, '_blank', 'noopener,noreferrer');
    if (feedbackEl) {
      feedbackEl.textContent = 'Відкриваємо Telegram із заповненим B2B-запитом.';
    }
  });

  copyBtn?.addEventListener('click', async () => {
    if (!form || !form.reportValidity()) return;
    try {
      await navigator.clipboard.writeText(getBrief());
      if (feedbackEl) {
        feedbackEl.textContent = 'B2B-запит скопійовано до буфера обміну!';
      }
    } catch {
      if (feedbackEl) {
        feedbackEl.textContent = 'Скористайтеся кнопкою Надіслати у WhatsApp або Telegram вище.';
      }
    }
  });
</script>

<style>
  .page-banner {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--ink-600);
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--ink-700);
    text-decoration: none;
    font-weight: 600;
  }

  .partner-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .partner-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: clamp(1.35rem, 2.5vw, 1.85rem);
    box-shadow: var(--shadow-xs);
  }

  .partner-card h3 {
    margin: 0.85rem 0 0.5rem;
    font-size: 1.25rem;
  }

  .partner-points {
    margin: 0.85rem 0 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.4rem;
    color: var(--ink-700);
    font-size: 0.92rem;
  }

  .guarantees-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .guarantee-card {
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.35rem;
  }

  .guarantee-card h3 {
    margin-bottom: 0.45rem;
    font-size: 1.08rem;
  }

  .guarantee-card p {
    margin-bottom: 0;
    font-size: 0.92rem;
  }

  .fleet-subhead {
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
  }

  .fleet-subhead h3 {
    margin: 0.35rem 0 0;
    font-size: 1.35rem;
  }

  .fleet-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .fleet-card {
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.35rem;
  }

  .fleet-card h4 {
    margin: 0.8rem 0 0.45rem;
    font-size: 1.12rem;
  }

  .fleet-card ul {
    margin: 0.75rem 0 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.3rem;
    font-size: 0.88rem;
    color: var(--ink-700);
  }

  .cert-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .b2b-form-wrap {
    max-width: 54rem;
  }

  .b2b-form-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 3.2vw, 2.5rem);
    box-shadow: var(--shadow-xs);
  }

  .b2b-form-card h2 {
    margin-top: 0.4rem;
  }

  .b2b-submit-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .b2b-feedback {
    margin: 0.25rem 0 0;
    min-height: 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--forest-800);
  }
</style>
