---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SocialIcon from '../../../components/SocialIcon.astro';
import { SITE, PICKUP_POINTS, SOCIAL_LINKS } from '../../../data/site';
import { UK_SITE, UK_PICKUP_POINTS, getToursForLangUk } from '../../../data/i18n-uk';
import { withBase, absoluteUrl } from '../../../lib/urls';

const ukTours = getToursForLangUk('uk');

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Головна', item: absoluteUrl('/uk/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'Контакти', item: absoluteUrl('/uk/contact/', Astro.site) },
  ],
};
---

<BaseLayout
  title={`Контакти та замовлення туру | ${SITE.brandName}`}
  description="Зв’яжіться з Minimalism Tours Georgia через WhatsApp, Telegram або телефоном, щоб забронювати екскурсії з Батумі, приватні маршрути Аджарією, B2B-тури чи сходження на Казбек."
  canonicalPath="/uk/contact/"
  alternateEnPath="/contact/"
  alternateKaPath="/ka/"
  alternatePlPath="/pl/contact/"
  alternateUkPath="/uk/contact/"
  lang="uk"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/uk/')}>Головна</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Контакти</span>
      </nav>
      <span class="eyebrow">Нуль комісій при бронюванні · Пряма локальна відповідь</span>
      <h1>Заплануйте тур або поставте запитання</h1>
      <p style="max-width: 46rem; font-size: 1.05rem;">
        Надішліть бажані дати, розмір групи та точку збору в Батумі напряму до нашого відділу бронювань — або пишіть одразу в WhatsApp щодо стану стежок.{' '}
        <a href={withBase('/uk/partners/')}>Шукаєте нетто-тарифи B2B? Перейдіть до B2B та Партнери →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <!-- Accessible Direct Request Form -->
      <div class="contact-form-card">
        <h2>Пряме бронювання та конструктор маршруту</h2>
        <p style="font-size: 0.94rem; margin-bottom: 1.5rem;">
          Заповніть деталі нижче та оберіть спосіб надсилання: готове повідомлення у <strong>WhatsApp</strong>, готовий <strong>Telegram</strong> або копіювання в буфер обміну.
        </p>

        <form id="full-contact-form" class="form-grid" data-enhanced-validation novalidate>
          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="c-name">Ім’я та прізвище *</label>
              <span id="c-name-hint" class="field-hint">Потрібно для підтвердження бронювання</span>
              <input
                id="c-name"
                name="name"
                type="text"
                required
                minlength="2"
                autocomplete="name"
                aria-describedby="c-name-hint"
                data-error="c-name-error"
                placeholder="Ваше ім’я"
              />
              <div id="c-name-error" class="error-msg">
                <span role="img" aria-label="Помилка">⚠</span> Введіть щонайменше 2 символи для імені.
              </div>
            </div>

            <div class="field">
              <label for="c-email">Електронна пошта *</label>
              <span id="c-email-hint" class="field-hint">Формат: you@example.com</span>
              <input
                id="c-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                aria-describedby="c-email-hint"
                data-error="c-email-error"
                placeholder="you@example.com"
              />
              <div id="c-email-error" class="error-msg">
                <span role="img" aria-label="Помилка">⚠</span> Введіть коректну електронну адресу.
              </div>
            </div>
          </div>

          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="c-tour">Обраний тур або маршрут *</label>
              <span id="c-tour-hint" class="field-hint">Оберіть стандартний тур або індивідуальний запит</span>
              <select
                id="c-tour"
                name="tour"
                required
                aria-describedby="c-tour-hint"
                data-error="c-tour-error"
              >
                <option value="">Оберіть екскурсію...</option>
                {ukTours.map((t) => <option value={t.title}>{t.shortTitle} ({t.duration})</option>)}
                <option value="Індивідуальний маршрут Аджарія / Зелене озеро / Колхіда">
                  Індивідуальний маршрут Аджарія / Зелене озеро / Колхіда
                </option>
                <option value="B2B партнерство (Готель / Турагентство)">
                  B2B партнерство (Готель / Турагентство)
                </option>
              </select>
              <div id="c-tour-error" class="error-msg">
                <span role="img" aria-label="Помилка">⚠</span> Оберіть тур або тип запиту.
              </div>
            </div>

            <div class="field">
              <label for="c-pickup">Точка збору в Батумі</label>
              <span id="c-pickup-hint" class="field-hint">Або оберіть готель у центрі / інший регіон</span>
              <select id="c-pickup" name="pickup" aria-describedby="c-pickup-hint">
                {PICKUP_POINTS.map((p) => {
                  const ukP = UK_PICKUP_POINTS[p.id];
                  return <option value={ukP ? ukP.name : p.name}>{ukP ? ukP.name : p.name}</option>;
                })}
                <option value="Власний готель у центрі Батумі">Власний готель у центрі Батумі</option>
                <option value="Степанцмінда / Казбегі / Інший регіон">Степанцмінда / Казбегі / Інший регіон</option>
              </select>
            </div>
          </div>

          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="c-date">Бажана дата</label>
              <span id="c-date-hint" class="field-hint">Залиште порожнім, якщо дати гнучкі</span>
              <input id="c-date" name="date" type="date" aria-describedby="c-date-hint" />
            </div>

            <div class="field">
              <label for="c-guests">Кількість гостей (1–16) *</label>
              <span id="c-guests-hint" class="field-hint">Загальна кількість мандрівників разом із дітьми</span>
              <input
                id="c-guests"
                name="guests"
                type="number"
                min="1"
                max="16"
                value="2"
                required
                aria-describedby="c-guests-hint"
                data-error="c-guests-error"
              />
              <div id="c-guests-error" class="error-msg">
                <span role="img" aria-label="Помилка">⚠</span> Розмір групи має бути від 1 до 16 гостей.
              </div>
            </div>
          </div>

          <div class="field">
            <label for="c-notes">Запитання, харчування або спорядження</label>
            <span id="c-notes-hint" class="field-hint">Необов’язково: вегетаріанське меню, трекінгові палиці, дати на Казбек або вік дітей</span>
            <textarea
              id="c-notes"
              name="notes"
              aria-describedby="c-notes-hint"
              placeholder="Розкажіть, яким ви бачите ідеальний день..."
            ></textarea>
          </div>

          <div class="contact-submit-row">
            <button type="submit" class="btn btn-coral">
              Надіслати у WhatsApp →
            </button>
            <button id="c-tg-btn" type="button" class="btn btn-forest">
              Надіслати у Telegram →
            </button>
            <button id="c-copy-btn" type="button" class="btn btn-outline">
              Копіювати підсумок
            </button>
          </div>

          <p id="c-feedback" class="contact-feedback" role="status" aria-live="polite"></p>
        </form>
      </div>

      <!-- Direct Channels -->
      <aside class="contact-side">
        <div class="side-panel">
          <span class="eyebrow">Прямі канали</span>
          <h2>Контакти Minimalism Tours Georgia</h2>
          <ul class="direct-list">
            <li>
              <strong>WhatsApp та Телефон</strong>
              <a href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer">
                {SITE.phoneDisplay} (Найшвидша відповідь)
              </a>
              <a href={`tel:${SITE.phoneRaw}`}>Зателефонувати {SITE.phoneDisplay}</a>
            </li>
            <li>
              <strong>Telegram</strong>
              <a href={SITE.telegramUrl} target="_blank" rel="noopener noreferrer">
                @MinimalismToursGeorgia ↗
              </a>
            </li>
            <li>
              <strong>Адреса офісу</strong>
              <a href={SITE.googleBusinessUrl} target="_blank" rel="noopener noreferrer">
                {SITE.officeAddressDisplay} ↗
              </a>
            </li>
            <li>
              <strong>Графік роботи</strong>
              <span>{UK_SITE.officeHoursDisplay}</span>
            </li>
            <li>
              <strong>GetYourGuide</strong>
              <a href={SITE.getYourGuideSupplierUrl} target="_blank" rel="noopener noreferrer">
                Усі тури Minimalism Tours Georgia ↗
              </a>
            </li>
            <li>
              <strong>Відгуки Google</strong>
              <a href={SITE.googleReviewUrl} target="_blank" rel="noopener noreferrer">
                Залишити відгук у Google ↗
              </a>
            </li>
            <li>
              <strong>Tripadvisor</strong>
              <a href={SITE.tripadvisorReviewUrl} target="_blank" rel="noopener noreferrer">
                Відгуки на Tripadvisor ↗
              </a>
            </li>
            <li>
              <strong>Trustpilot</strong>
              <a href={SITE.trustpilotUrl} target="_blank" rel="noopener noreferrer">
                Відгуки на Trustpilot ↗
              </a>
            </li>
          </ul>
        </div>

        <div class="side-panel">
          <span class="eyebrow">Стежте за Minimalism Tours Georgia</span>
          <h3>Офіційні соцмережі</h3>
          <ul class="social-grid">
            {
              SOCIAL_LINKS.map((s) => (
                <li>
                  <a class="social-card-link" href={s.url} target="_blank" rel="noopener noreferrer">
                    <span class="social-icon-badge" aria-hidden="true">
                      <SocialIcon id={s.id} size={18} />
                    </span>
                    <span class="social-card-meta">
                      <strong>{s.name}</strong>
                      <span>{s.handle} ↗</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="side-panel">
          <span class="eyebrow">Точки збору</span>
          <h3>4 перевірені локації в Батумі</h3>
          <ul class="pickup-compact">
            {
              PICKUP_POINTS.map((p) => {
                const ukP = UK_PICKUP_POINTS[p.id];
                return (
                  <li>
                    <strong>{ukP ? ukP.name : p.name}</strong>
                    <span>{ukP ? ukP.address : p.address}</span>
                    <a href={p.mapsUrl} target="_blank" rel="noopener noreferrer">Google Карти ↗</a>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script
  id="contact-config"
  type="application/json"
  set:html={JSON.stringify({
    whatsappUrl: SITE.whatsappUrl,
    telegramUrl: SITE.telegramUrl,
    formspreeEndpoint: SITE.formspreeEndpoint,
  })}
/>

<script>
  const cfgNode = document.getElementById('contact-config');
  const cfg = cfgNode?.textContent ? JSON.parse(cfgNode.textContent) : null;

  const form = document.getElementById('full-contact-form') as HTMLFormElement | null;
  const tgBtn = document.getElementById('c-tg-btn');
  const copyBtn = document.getElementById('c-copy-btn');
  const feedbackEl = document.getElementById('c-feedback');

  const getSummary = () => {
    if (!form) return '';
    const d = new FormData(form);
    return [
      'Minimalism Tours Georgia — Запит / Бронювання (UA)',
      `Ім’я: ${d.get('name')}`,
      `Email: ${d.get('email')}`,
      `Тур: ${d.get('tour')}`,
      `Збір: ${d.get('pickup')}`,
      `Бажана дата: ${d.get('date') || 'Гнучка'}`,
      `Кількість гостей: ${d.get('guests')}`,
      d.get('notes') ? `Примітки: ${d.get('notes')}` : '',
    ]
      .filter(Boolean)
      .join('\n');
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity() || !cfg) return;
    const summary = getSummary();

    if (cfg.formspreeEndpoint) {
      try {
        await fetch(cfg.formspreeEndpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
      } catch {
        // Fallback cleanly to WhatsApp
      }
    }

    const waUrl = `${cfg.whatsappUrl}?text=${encodeURIComponent(summary)}`;
    window.open(waUrl, '_blank', 'noopener,noreferrer');
    if (feedbackEl) {
      feedbackEl.textContent = 'Відкриваємо WhatsApp із заповненими деталями туру.';
    }
  });

  tgBtn?.addEventListener('click', () => {
    if (!form || !form.reportValidity() || !cfg) return;
    const summary = getSummary();
    const tgUrl = `${cfg.telegramUrl}?text=${encodeURIComponent(summary)}`;
    window.open(tgUrl, '_blank', 'noopener,noreferrer');
    if (feedbackEl) {
      feedbackEl.textContent = 'Відкриваємо Telegram із заповненими деталями туру.';
    }
  });

  copyBtn?.addEventListener('click', async () => {
    if (!form || !form.reportValidity()) return;
    try {
      await navigator.clipboard.writeText(getSummary());
      if (feedbackEl) {
        feedbackEl.textContent = 'Підсумок запиту скопійовано до буфера обміну!';
      }
    } catch {
      if (feedbackEl) {
        feedbackEl.textContent = 'Скористайтеся кнопкою Надіслати у WhatsApp або Telegram вище.';
      }
    }
  });
</script>

<style>
  .page-banner {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--ink-600);
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--ink-700);
    text-decoration: none;
    font-weight: 600;
  }

  .contact-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 58rem) {
    .contact-grid {
      grid-template-columns: 1.35fr 0.85fr;
    }
  }

  .contact-form-card,
  .side-panel {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: clamp(1.4rem, 3vw, 2.25rem);
    box-shadow: var(--shadow-xs);
  }

  .contact-side {
    display: grid;
    gap: 1.5rem;
  }

  .direct-list,
  .pickup-compact {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .direct-list li,
  .pickup-compact li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.92rem;
  }

  .direct-list li:last-child,
  .pickup-compact li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .pickup-compact span {
    color: var(--ink-600);
    font-size: 0.85rem;
  }

  .social-grid {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: 0.65rem;
  }

  .social-card-link {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-page);
    color: var(--ink-900);
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .social-icon-badge {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--forest-100);
    color: var(--forest-800);
    transition: background-color 160ms ease, color 160ms ease;
  }

  .social-card-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .social-card-link strong {
    font-size: 0.92rem;
    color: var(--forest-800);
  }

  .social-card-link span {
    font-size: 0.8rem;
    color: var(--ink-600);
    overflow-wrap: anywhere;
  }

  .social-card-link:hover,
  .social-card-link:focus-visible {
    border-color: var(--forest-800);
    background-color: var(--forest-100);
    transform: translateY(-1px);
  }

  .social-card-link:hover .social-icon-badge,
  .social-card-link:focus-visible .social-icon-badge {
    background-color: var(--forest-800);
    color: #ffffff;
  }

  .contact-submit-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .contact-feedback {
    margin: 0.25rem 0 0;
    min-height: 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--forest-800);
  }
</style>
