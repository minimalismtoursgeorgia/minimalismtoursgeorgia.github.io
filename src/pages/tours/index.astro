---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourCard from '../../components/TourCard.astro';
import { SITE } from '../../data/site';
import { TOURS } from '../../data/tours';
import { absoluteUrl, withBase } from '../../lib/urls';

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'Tours', item: absoluteUrl('/tours/', Astro.site) },
  ],
};

const regions = Array.from(new Set(TOURS.map((t) => t.regionSlug)));
const categories = Array.from(new Set(TOURS.map((t) => t.category)));
---

<BaseLayout
  title={`All Tours in Georgia from Batumi | ${SITE.brandName}`}
  description="Browse all guided rainforest hikes, Mtirala & Botanical Garden combos, Machakhela valley treks, Batumi Old Town walking tours, and Mount Kazbek expeditions."
  canonicalPath="/tours/"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Tours</span>
      </nav>
      <span class="eyebrow">7 Authentic Routes</span>
      <h1>Guided Tours Across Adjara &amp; Georgia</h1>
      <p style="max-width: 44rem; font-size: 1.05rem;">
        Filter by region, duration, terrain pace, or keyword. Every route shows honest physical grading, what is included, and transparent group rates.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="filter-bar" role="region" aria-label="Filter and sort tours">
        <div class="field">
          <label for="f-search">Search Keyword</label>
          <input id="f-search" type="search" placeholder="waterfall, food, cable car, Kazbek..." />
        </div>

        <div class="field">
          <label for="f-region">Region</label>
          <select id="f-region">
            <option value="">All Regions</option>
            {
              regions.map((slug) => {
                const label = TOURS.find((t) => t.regionSlug === slug)?.region || slug;
                return <option value={slug}>{label}</option>;
              })
            }
          </select>
        </div>

        <div class="field">
          <label for="f-category">Style</label>
          <select id="f-category">
            <option value="">All Styles</option>
            {categories.map((cat) => <option value={cat}>{cat}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="f-duration">Duration</label>
          <select id="f-duration">
            <option value="">Any Length</option>
            <option value="half-day">Half-Day (~3h)</option>
            <option value="full-day">Full-Day (6–7h)</option>
            <option value="multi-day">Multi-Day (2–5 Days)</option>
          </select>
        </div>

        <div class="field">
          <label for="f-difficulty">Difficulty</label>
          <select id="f-difficulty">
            <option value="">All Levels</option>
            <option value="Easy">Easy</option>
            <option value="Easy–Moderate">Easy–Moderate</option>
            <option value="Moderate">Moderate</option>
            <option value="Moderate–Challenging">Moderate–Challenging</option>
            <option value="Challenging">Challenging</option>
          </select>
        </div>

        <div class="field">
          <label for="f-sort">Sort By</label>
          <select id="f-sort">
            <option value="featured">Recommended</option>
            <option value="price-asc">Lowest Group Price</option>
            <option value="duration-asc">Shortest Duration</option>
            <option value="duration-desc">Longest Adventure</option>
          </select>
        </div>
      </div>

      <div class="filter-status-row">
        <p id="tours-count" aria-live="polite">
          Showing <strong>{TOURS.length}</strong> of {TOURS.length} tours
        </p>
        <button id="reset-filters-btn" type="button" class="btn btn-outline btn-sm" hidden>
          Clear Filters
        </button>
      </div>

      <div id="tours-grid" class="tours-grid">
        {TOURS.map((tour, idx) => <TourCard tour={tour} priority={idx < 2} />)}
      </div>

      <div id="tours-empty" class="empty-state" hidden>
        <h2>No matching routes found</h2>
        <p>Try clearing one of the filters or tell Beka what kind of private itinerary you have in mind.</p>
        <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem;">
          <button id="empty-reset-btn" type="button" class="btn btn-forest">Show All Tours</button>
          <a class="btn btn-coral" href={withBase('/contact/')}>Request Custom Route</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const searchEl = document.getElementById('f-search') as HTMLInputElement | null;
  const regionEl = document.getElementById('f-region') as HTMLSelectElement | null;
  const categoryEl = document.getElementById('f-category') as HTMLSelectElement | null;
  const durationEl = document.getElementById('f-duration') as HTMLSelectElement | null;
  const difficultyEl = document.getElementById('f-difficulty') as HTMLSelectElement | null;
  const sortEl = document.getElementById('f-sort') as HTMLSelectElement | null;
  const grid = document.getElementById('tours-grid');
  const countEl = document.getElementById('tours-count');
  const resetBtn = document.getElementById('reset-filters-btn') as HTMLButtonElement | null;
  const emptyResetBtn = document.getElementById('empty-reset-btn');
  const emptyState = document.getElementById('tours-empty');

  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.tour-card')) : [];

  // Hydrate initial filters from URL parameters (from Home Quick Finder)
  const params = new URLSearchParams(window.location.search);
  if (regionEl && params.get('region')) regionEl.value = params.get('region') || '';
  if (durationEl && params.get('duration')) durationEl.value = params.get('duration') || '';
  if (difficultyEl && params.get('difficulty')) difficultyEl.value = params.get('difficulty') || '';
  if (categoryEl && params.get('category')) categoryEl.value = params.get('category') || '';
  if (searchEl && params.get('q')) searchEl.value = params.get('q') || '';

  const applyFilters = () => {
    const q = (searchEl?.value || '').trim().toLowerCase();
    const region = regionEl?.value || '';
    const category = categoryEl?.value || '';
    const duration = durationEl?.value || '';
    const difficulty = difficultyEl?.value || '';
    const sortBy = sortEl?.value || 'featured';

    let visibleCount = 0;

    cards.forEach((card) => {
      const matchQ = !q || (card.dataset.search || '').includes(q);
      const matchRegion = !region || card.dataset.region === region;
      const matchCat = !category || card.dataset.category === category;
      const matchDur = !duration || card.dataset.duration === duration;
      const matchDiff = !difficulty || card.dataset.difficulty === difficulty;
      const show = matchQ && matchRegion && matchCat && matchDur && matchDiff;
      card.hidden = !show;
      if (show) visibleCount += 1;
    });

    if (grid) {
      const sorted = [...cards].sort((a, b) => {
        if (sortBy === 'price-asc') {
          return Number(a.dataset.price || 9999) - Number(b.dataset.price || 9999);
        }
        if (sortBy === 'duration-asc') {
          return Number(a.dataset.hours || 0) - Number(b.dataset.hours || 0);
        }
        if (sortBy === 'duration-desc') {
          return Number(b.dataset.hours || 0) - Number(a.dataset.hours || 0);
        }
        return 0;
      });
      if (sortBy !== 'featured') {
        sorted.forEach((c) => grid.appendChild(c));
      }
    }

    const hasActiveFilter = Boolean(q || region || category || duration || difficulty);
    if (resetBtn) resetBtn.hidden = !hasActiveFilter;
    if (emptyState) emptyState.hidden = visibleCount > 0;
    if (countEl) {
      countEl.innerHTML = `Showing <strong>${visibleCount}</strong> of ${cards.length} tours`;
    }
  };

  const resetAll = () => {
    if (searchEl) searchEl.value = '';
    if (regionEl) regionEl.value = '';
    if (categoryEl) categoryEl.value = '';
    if (durationEl) durationEl.value = '';
    if (difficultyEl) difficultyEl.value = '';
    if (sortEl) sortEl.value = 'featured';
    window.history.replaceState({}, '', window.location.pathname);
    applyFilters();
  };

  [searchEl, regionEl, categoryEl, durationEl, difficultyEl, sortEl].forEach((el) => {
    el?.addEventListener('input', applyFilters);
    el?.addEventListener('change', applyFilters);
  });

  resetBtn?.addEventListener('click', resetAll);
  emptyResetBtn?.addEventListener('click', resetAll);

  applyFilters();
</script>

<style>
  .page-banner {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--ink-600);
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--ink-700);
    text-decoration: none;
    font-weight: 600;
  }

  .filter-bar {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(11.5rem, 1fr));
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.15rem;
    box-shadow: var(--shadow-xs);
    margin-bottom: 1.25rem;
  }

  .filter-status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.35rem;
  }

  .filter-status-row p {
    margin: 0;
    font-size: 0.94rem;
    color: var(--ink-700);
  }

  .empty-state {
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-xl);
    padding: 3rem 1.5rem;
    text-align: center;
    margin-top: 1.5rem;
  }
</style>
