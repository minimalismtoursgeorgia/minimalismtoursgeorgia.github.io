---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourCard from '../../components/TourCard.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import JorunnersRouteTabs from '../../components/JorunnersRouteTabs.astro';
import GroupInquiryForm from '../../components/GroupInquiryForm.astro';
import { SITE, PICKUP_POINTS } from '../../data/site';
import { TOURS, type Tour } from '../../data/tours';
import { getReviewsByTourSlug } from '../../data/reviews';
import { withBase, absoluteUrl } from '../../lib/urls';

export function getStaticPaths() {
  return TOURS.map((tour) => ({
    params: { slug: tour.slug },
    props: { tour },
  }));
}

interface Props {
  tour: Tour;
}

const { tour } = Astro.props;
const relatedTours = TOURS.filter((t) => t.slug !== tour.slug).slice(0, 3);
const tourReviews = getReviewsByTourSlug(tour.slug);
const hasSafetyCancellationReview = tourReviews.some((r) => r.category === 'safety-cancellation');

const tourJsonLd = {
  '@type': 'TouristTrip',
  name: tour.title,
  description: tour.seoDescription,
  touristType: ['Nature lovers', 'Hikers', 'Cultural travelers', 'Small groups'],
  image: absoluteUrl(tour.heroImage, Astro.site),
  url: absoluteUrl(`/tours/${tour.slug}/`, Astro.site),
  provider: {
    '@type': 'TravelAgency',
    name: SITE.brandName,
    telephone: SITE.phoneRaw,
  },
  ...(tour.startingPriceEur !== null
    ? {
        offers: {
          '@type': 'Offer',
          priceCurrency: 'EUR',
          price: String(tour.startingPriceEur),
          availability: 'https://schema.org/InStock',
          url: absoluteUrl(`/tours/${tour.slug}/`, Astro.site),
        },
      }
    : {}),
};

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'Tours', item: absoluteUrl('/tours/', Astro.site) },
    {
      '@type': 'ListItem',
      position: 3,
      name: tour.shortTitle,
      item: absoluteUrl(`/tours/${tour.slug}/`, Astro.site),
    },
  ],
};

const faqJsonLd = tour.faqs.length
  ? [
      {
        '@type': 'FAQPage',
        mainEntity: tour.faqs.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      },
    ]
  : [];

const videoJsonLd = (tour.videos || []).map((v) => ({
  '@type': 'VideoObject',
  name: v.title,
  description: v.caption,
  thumbnailUrl: `https://i.ytimg.com/vi/${v.youtubeId}/maxresdefault.jpg`,
  ...(v.uploadDate ? { uploadDate: v.uploadDate } : {}),
  embedUrl: `https://www.youtube-nocookie.com/embed/${v.youtubeId}`,
  contentUrl: `https://www.youtube.com/watch?v=${v.youtubeId}`,
}));
---

<BaseLayout
  title={`${tour.title} | ${SITE.brandName}`}
  description={tour.seoDescription}
  canonicalPath={`/tours/${tour.slug}/`}
  alternateEnPath={`/tours/${tour.slug}/`}
  alternatePlPath={`/pl/tours/${tour.slug}/`}
  alternateUkPath={`/uk/tours/${tour.slug}/`}
  ogImage={tour.heroImage}
  keywords={tour.keywords}
  jsonLd={[tourJsonLd, breadcrumbJsonLd, ...faqJsonLd, ...videoJsonLd]}
>
  <!-- Hero Media Header -->
  <section class="tour-hero">
    <div class="container">
      <div class="tour-hero-top-nav">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={withBase('/')}>Home</a>
          <span aria-hidden="true">/</span>
          <a href={withBase('/tours/')}>Tours</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{tour.shortTitle}</span>
        </nav>
        <a class="btn btn-outline btn-sm" href={withBase('/tours/')}>← Back to All Tours</a>
      </div>

      <div class="tour-hero-badges">
        <span class="badge badge-forest">{tour.statusLabel}</span>
        <span class="badge badge-sea">{tour.region}</span>
        <span class="badge badge-coral">{tour.difficulty}</span>
      </div>

      <h1>{tour.title}</h1>
      <p class="tour-hero-lead">{tour.summary}</p>

      <div class="tour-hero-media">
        <img
          src={withBase(tour.heroImage)}
          alt={tour.heroAlt}
          fetchpriority="high"
          width="1400"
          height="900"
          decoding="async"
        />
      </div>

      {
        tour.gallery.length > 1 && (
          <div class="gallery-strip" role="region" aria-label="Tour photo gallery">
            {tour.gallery.map((item, idx) => (
              <button
                type="button"
                class="gallery-thumb"
                data-lightbox-src={withBase(item.src)}
                data-lightbox-alt={item.alt}
                aria-label={`View photo ${idx + 1}: ${item.alt}`}
              >
                <img
                  src={withBase(item.src)}
                  alt={item.alt}
                  width="480"
                  height="320"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- Main Two-Column Content + Sticky Booking Sidebar -->
  <section class="section-tight">
    <div class="container tour-layout">
      <div class="tour-main">
        <!-- Quick Facts Grid -->
        <dl class="facts-bar">
          <div>
            <dt>Duration</dt>
            <dd>{tour.duration}</dd>
          </div>
          <div>
            <dt>Difficulty</dt>
            <dd>{tour.difficulty}</dd>
          </div>
          <div>
            <dt>Group Limit</dt>
            <dd>{tour.groupSize}</dd>
          </div>
          <div>
            <dt>Minimum Age</dt>
            <dd>{tour.minAge}</dd>
          </div>
          <div>
            <dt>Languages</dt>
            <dd>English / ქართული</dd>
          </div>
          <div>
            <dt>Cancellation</dt>
            <dd>24h Free Cancel</dd>
          </div>
          {
            tour.meals && (
              <div>
                <dt>Meals</dt>
                <dd>{tour.meals}</dd>
              </div>
            )
          }
          {
            tour.season && (
              <div>
                <dt>Season</dt>
                <dd>{tour.season}</dd>
              </div>
            )
          }
        </dl>

        {tour.hasRouteOptions && <JorunnersRouteTabs />}

        {
          tour.videos && tour.videos.length > 0 && (
            <section class="detail-block tour-video-block" aria-labelledby="tour-video-heading">
              <div class="video-head">
                <h2 id="tour-video-heading">Watch the Trail Preview</h2>
                <a
                  class="video-channel-link"
                  href={SITE.youtubeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  More on YouTube ↗
                </a>
              </div>

              <div class="video-stack">
                {tour.videos.map((v) => (
                  <figure class="video-card">
                    <div
                      class="video-facade"
                      data-youtube-id={v.youtubeId}
                      data-video-title={v.title}
                    >
                      <button
                        type="button"
                        class="video-facade-trigger"
                        aria-label={`Play video: ${v.title}`}
                      >
                        <img
                          src={`https://i.ytimg.com/vi/${v.youtubeId}/maxresdefault.jpg`}
                          alt={v.title}
                          width="1280"
                          height="720"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="video-facade-scrim" aria-hidden="true" />
                        <span class="video-facade-overlay">
                          <span class="video-play-btn" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M8 5.14v14l11-7-11-7Z" />
                            </svg>
                          </span>
                          <span class="video-play-meta">
                            <span class="video-play-label">Play Trail Video</span>
                            {v.durationLabel && (
                              <span class="video-duration-pill">{v.durationLabel}</span>
                            )}
                          </span>
                        </span>
                      </button>
                      <noscript>
                        <iframe
                          src={`https://www.youtube-nocookie.com/embed/${v.youtubeId}?rel=0`}
                          title={v.title}
                          width="1280"
                          height="720"
                          loading="lazy"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                          referrerpolicy="strict-origin-when-cross-origin"
                          allowfullscreen
                        />
                      </noscript>
                    </div>
                    <figcaption class="video-caption">
                      <span>{v.caption}</span>
                      <a
                        href={`https://www.youtube.com/watch?v=${v.youtubeId}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Watch on YouTube ↗
                      </a>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )
        }

        <!-- Highlights -->
        <section class="detail-block">
          <h2>Why Travelers Choose This Route</h2>
          <ul class="highlight-list">
            {tour.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </section>

        <!-- Step-by-step Itinerary -->
        <section class="detail-block">
          <h2>Step-by-Step Itinerary</h2>
          <ol class="itinerary-steps">
            {
              tour.itinerary.map((step) => (
                <li>
                  <div class="step-time">{step.timeOrDuration}</div>
                  <div class="step-body">
                    <h3>{step.title}</h3>
                    <p>{step.detail}</p>
                    {step.ticketNote && <span class="badge badge-sea">{step.ticketNote}</span>}
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <!-- Included / Excluded -->
        <section class="detail-block">
          <h2>Transparent Inclusions &amp; Exclusions</h2>
          <div class="inc-exc-grid">
            <div class="inc-box">
              <h3>Included</h3>
              <ul>
                {tour.included.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="exc-box">
              <h3>Not Included</h3>
              <ul>
                {tour.excluded.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>

          {
            tour.optionalExtras && tour.optionalExtras.length > 0 && (
              <div class="optional-extras-box">
                <div class="optional-extras-head">
                  <h3>Optional Add-Ons (If Desired)</h3>
                  <span class="badge badge-sea">On Guest Request</span>
                </div>
                <p class="optional-extras-intro">
                  Nothing here is mandatory — if you’d like to add any of these during your Mtirala day, let your guide know or tick them in the booking box.
                </p>
                <div class="optional-extras-grid">
                  {tour.optionalExtras.map((extra) => (
                    <div class="optional-extra-item">
                      <div class="optional-extra-title">
                        <strong>{extra.label}</strong>
                        <span class="badge badge-forest">Optional</span>
                      </div>
                      <p>{extra.detail}</p>
                    </div>
                  ))}
                </div>
              </div>
            )
          }
        </section>

        <!-- Weather & Packing -->
        <section class="detail-block weather-packing-grid">
          <div class="info-callout">
            <h3>Active Weather &amp; Rain Plan</h3>
            <p>{tour.weatherPlan}</p>
            <p style="margin-bottom: 0; font-size: 0.9rem;">
              <strong>Safety-first track record:</strong> When severe storms make trails unsafe, we cancel honestly and arrange full refunds —{' '}
              <a href={hasSafetyCancellationReview ? '#tour-reviews' : withBase('/#reviews')}>
                {hasSafetyCancellationReview ? 'read verified guest feedback below →' : 'see verified weather-cancellation reviews →'}
              </a>
            </p>
          </div>
          <div class="info-callout">
            <h3>What to Bring</h3>
            <ul>
              {tour.packingList.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </section>

        <!-- Pickup Locations -->
        {
          tour.regionSlug !== 'kazbegi-svaneti' && tour.regionSlug !== 'bakuriani-borjomi' && (
            <section class="detail-block">
              <h2>Batumi Pickup &amp; Return Locations ({SITE.defaultStartTime})</h2>
              <div class="mini-pickup-grid">
                {PICKUP_POINTS.map((p) => (
                  <div class="mini-pickup">
                    <strong>{p.name}</strong>
                    <span>{p.address}</span>
                    <a href={p.mapsUrl} target="_blank" rel="noopener noreferrer">
                      Map Pin ↗
                    </a>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        {
          tour.isGroupProgram && <GroupInquiryForm selectedSlug={tour.slug} />
        }

        <!-- Verified Tour Reviews -->
        {
          tourReviews.length > 0 && (
            <ReviewsSection
              sectionId="tour-reviews"
              reviews={tourReviews}
              variant="inline"
              heading="Verified Guest Reviews"
              intro="Real feedback from travelers who experienced this route or our weather-safety refund handling."
              showTourLink={false}
            />
          )
        }

        <!-- Tour FAQs -->
        {
          tour.faqs.length > 0 && (
            <section class="detail-block">
              <h2>Tour Questions</h2>
              <div class="accordion">
                {tour.faqs.map((f) => (
                  <details>
                    <summary>{f.question}</summary>
                    <div class="accordion-panel">
                      <p>{f.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <!-- Sticky Interactive Booking Sidebar -->
      <aside class="tour-sidebar" aria-label="Tour pricing calculator and booking">
        <div class="booking-card" id="tour-booking-widget">
          <span class="eyebrow" style="margin-bottom: 0.35rem;">{tour.pricingNote}</span>

          {
            tour.pricingTiers.length > 0 ? (
              <>
                <div class="sidebar-price-head">
                  <strong id="sb-price-display" class="sidebar-price-main">
                    €{tour.startingPriceEur}
                  </strong>
                  <span id="sb-price-caption" class="sidebar-price-sub">
                    from / adult (group tier)
                  </span>
                </div>

                <div class="currency-pills" style="margin-bottom: 1rem;" role="group" aria-label="Currency display">
                  <button type="button" class="sb-curr-btn active" data-currency="EUR" aria-pressed="true">EUR €</button>
                  <button type="button" class="sb-curr-btn" data-currency="USD" aria-pressed="false">USD $</button>
                  <button type="button" class="sb-curr-btn" data-currency="GEL" aria-pressed="false">GEL ₾</button>
                </div>

                <div class="form-grid">
                  <div class="form-grid form-grid-2">
                    <div class="field">
                      <label for="sb-adults">Adults</label>
                      <input id="sb-adults" type="number" min="1" max="16" value="2" />
                    </div>
                    <div class="field">
                      <label for="sb-children">Children (0–17)</label>
                      <input id="sb-children" type="number" min="0" max="8" value="0" />
                    </div>
                  </div>

                  <div class="field">
                    <label for="sb-date">Preferred Date</label>
                    <input id="sb-date" type="date" />
                  </div>

                  {tour.regionSlug !== 'kazbegi-svaneti' && (
                    <div class="field">
                      <label for="sb-pickup">Batumi Pickup</label>
                      <select id="sb-pickup">
                        {PICKUP_POINTS.map((p) => (
                          <option value={p.name}>{p.name}</option>
                        ))}
                        <option value="Custom central Batumi hotel">Custom central Batumi hotel</option>
                      </select>
                    </div>
                  )}

                  {tour.optionalExtras && tour.optionalExtras.length > 0 && (
                    <fieldset class="opt-addons-fieldset">
                      <legend>Optional Add-Ons (If Desired)</legend>
                      <div class="opt-addons-grid">
                        {tour.optionalExtras.map((extra) => (
                          <label class="opt-addon-pill">
                            <input type="checkbox" class="sb-addon-check" value={extra.label} />
                            <span>{extra.shortLabel}</span>
                          </label>
                        ))}
                      </div>
                    </fieldset>
                  )}
                </div>

                <div class="sb-summary-box">
                  <div>
                    <span>Adult rate</span>
                    <strong id="sb-adult-rate">€{tour.pricingTiers[1]?.adultEur || tour.pricingTiers[0].adultEur}</strong>
                  </div>
                  <div>
                    <span>Child rate (75%)</span>
                    <strong id="sb-child-rate">€{tour.pricingTiers[1]?.childEur || tour.pricingTiers[0].childEur}</strong>
                  </div>
                  <div class="sb-total-row">
                    <span>Estimated Total</span>
                    <strong id="sb-total-rate">
                      €{(tour.pricingTiers[1]?.adultEur || tour.pricingTiers[0].adultEur) * 2}
                    </strong>
                  </div>
                </div>

                <div class="tier-table-wrap">
                  <p class="tier-table-title">Group Pricing Tiers (EUR base)</p>
                  <table class="tier-table">
                    <thead>
                      <tr>
                        <th>Group</th>
                        <th>Adult</th>
                        <th>Child</th>
                      </tr>
                    </thead>
                    <tbody>
                      {tour.pricingTiers.map((tier) => (
                        <tr>
                          <td>{tier.label}</td>
                          <td>€{tier.adultEur}</td>
                          <td>€{tier.childEur}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </>
            ) : (
              <div class="sb-summary-box" style="margin-top: 0.75rem;">
                <p style="margin: 0; font-size: 0.94rem;">
                  {tour.isGroupProgram
                    ? `${tour.duration} · ${tour.meals || 'Full Board'} · Tailored group logistics from Tbilisi. Use the inquiry form below for a custom group quote.`
                    : 'Summer Mount Kazbek expeditions (June–September) are quoted individually based on dates, guide-to-climber ratio, Betlemi Hut beds, and gear rentals.'}
                </p>
              </div>
            )
          }

          <div class="sb-cta-stack">
            {
              tour.isGroupProgram && (
                <a class="btn btn-forest" href="#group-inquiry">
                  Open Group Inquiry Form ↓
                </a>
              )
            }
            <a
              id="sb-wa-book"
              class="btn btn-coral"
              href={`${SITE.whatsappUrl}?text=${encodeURIComponent(`Hello Minimalism Tours Georgia! I'm interested in "${tour.title}".`)}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Book / Ask on WhatsApp
            </a>

            {
              tour.gygUrl && (
                <a
                  class="btn btn-sea"
                  href={tour.gygUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Book Instant on GetYourGuide ↗
                </a>
              )
            }

            {
              tour.tripadvisorUrl && (
                <a
                  class="btn btn-outline"
                  href={tour.tripadvisorUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Read Reviews on Tripadvisor ↗
                </a>
              )
            }

            <a
              id="sb-tg-book"
              class="btn btn-outline"
              href={`${SITE.telegramUrl}?text=${encodeURIComponent(`Hello Minimalism Tours Georgia! I'm interested in "${tour.title}".`)}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Message on Telegram
            </a>
          </div>

          <p class="sb-trust-foot">
            ✓ {SITE.cancellationPolicy} · Direct booking with {SITE.brandName}
            <br />
            <a href={withBase('/guest-registration/')}>Pre-trip Guest Registration &amp; Medical Form →</a>
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Related Tours -->
  <section class="section section-surface">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Keep Exploring</span>
          <h2>More Adventures from Batumi</h2>
        </div>
        <a class="btn btn-outline btn-sm" href={withBase('/tours/')}>View All Tours</a>
      </div>
      <div class="tours-grid">
        {relatedTours.map((rt) => <TourCard tour={rt} />)}
      </div>
    </div>
  </section>

  <!-- Photo Gallery Lightbox Modal (<dialog closedby="any">) -->
  <dialog id="gallery-lightbox" class="lightbox-dialog" closedby="any" aria-labelledby="lightbox-caption">
    <div class="dialog-head">
      <h2 id="lightbox-caption">Tour Photo</h2>
      <button
        type="button"
        class="dialog-close"
        command="close"
        commandfor="gallery-lightbox"
        aria-label="Close photo lightbox"
      >
        ✕
      </button>
    </div>
    <div class="dialog-body">
      <img
        id="lightbox-img"
        src={withBase(tour.heroImage)}
        alt={tour.heroAlt}
        fetchpriority="low"
      />
    </div>
  </dialog>

  <script
    id="tour-detail-payload"
    type="application/json"
    set:html={JSON.stringify({
      title: tour.title,
      shortTitle: tour.shortTitle,
      pricingTiers: tour.pricingTiers,
      currencyRates: SITE.currencyRates,
      whatsappUrl: SITE.whatsappUrl,
      telegramUrl: SITE.telegramUrl,
    })}
  />

  <script>
    // 1) Gallery Lightbox
    const lightbox = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');

    document.querySelectorAll<HTMLButtonElement>('.gallery-thumb').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const src = thumb.dataset.lightboxSrc;
        const alt = thumb.dataset.lightboxAlt || 'Tour photograph';
        if (lightbox && lightboxImg && src) {
          lightboxImg.src = src;
          lightboxImg.alt = alt;
          if (lightboxCaption) lightboxCaption.textContent = alt;
          lightbox.showModal();
        }
      });
    });

    // 1b) Click-to-Play YouTube Video Facade
    document.querySelectorAll<HTMLButtonElement>('.video-facade-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const facade = btn.closest<HTMLElement>('.video-facade');
        const youtubeId = facade?.dataset.youtubeId;
        if (!facade || !youtubeId) return;
        const videoTitle = facade.dataset.videoTitle || 'Tour video preview';
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeId)}?autoplay=1&rel=0`;
        iframe.title = videoTitle;
        iframe.width = '1280';
        iframe.height = '720';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.allowFullscreen = true;
        facade.replaceChildren(iframe);
      });
    });

    // 2) Sidebar Calculator + Dynamic WhatsApp / Email Links
    const payloadNode = document.getElementById('tour-detail-payload');
    if (payloadNode?.textContent) {
      const data = JSON.parse(payloadNode.textContent);
      const adultsInput = document.getElementById('sb-adults') as HTMLInputElement | null;
      const childInput = document.getElementById('sb-children') as HTMLInputElement | null;
      const dateInput = document.getElementById('sb-date') as HTMLInputElement | null;
      const pickupInput = document.getElementById('sb-pickup') as HTMLSelectElement | null;

      const priceDisplay = document.getElementById('sb-price-display');
      const adultRateEl = document.getElementById('sb-adult-rate');
      const childRateEl = document.getElementById('sb-child-rate');
      const totalRateEl = document.getElementById('sb-total-rate');
      const waBtn = document.getElementById('sb-wa-book') as HTMLAnchorElement | null;
      const tgBtn = document.getElementById('sb-tg-book') as HTMLAnchorElement | null;
      const currBtns = document.querySelectorAll<HTMLButtonElement>('.sb-curr-btn');
      const addonChecks = document.querySelectorAll<HTMLInputElement>('.sb-addon-check');

      let currency: 'EUR' | 'USD' | 'GEL' = 'EUR';

      const fmt = (eur: number) => {
        const cfg = data.currencyRates[currency] || data.currencyRates.EUR;
        return `${cfg.symbol}${Math.round(eur * cfg.rate)}`;
      };

      const updateSidebar = () => {
        if (!data.pricingTiers.length) return;
        const maxPax = data.pricingTiers[data.pricingTiers.length - 1]?.maxPax || 16;
        const adults = Math.max(1, Math.min(maxPax, Number(adultsInput?.value || 2)));
        const children = Math.max(0, Math.min(8, Number(childInput?.value || 0)));
        const totalPax = Math.min(maxPax, adults + children);

        const tier =
          data.pricingTiers.find((t: any) => totalPax >= t.minPax && totalPax <= t.maxPax) ||
          data.pricingTiers[data.pricingTiers.length - 1];

        const totalEur = adults * tier.adultEur + children * tier.childEur;
        const minAdultEur = data.pricingTiers[data.pricingTiers.length - 1].adultEur;

        if (priceDisplay) priceDisplay.textContent = fmt(minAdultEur);
        if (adultRateEl) adultRateEl.textContent = fmt(tier.adultEur);
        if (childRateEl) childRateEl.textContent = fmt(tier.childEur);
        if (totalRateEl) totalRateEl.textContent = fmt(totalEur);

        const dateStr = dateInput?.value || 'Flexible date';
        const pickupStr = pickupInput?.value || 'To be confirmed';
        const selectedAddons = Array.from(addonChecks)
          .filter((cb) => cb.checked)
          .map((cb) => cb.value);

        const msg = [
          `Hello Minimalism Tours Georgia!`,
          `Tour: ${data.title}`,
          `Guests: ${adults} adult(s), ${children} child(ren)`,
          `Preferred Date: ${dateStr}`,
          `Pickup: ${pickupStr}`,
          selectedAddons.length ? `Optional Add-Ons (if desired): ${selectedAddons.join(', ')}` : '',
          `Estimated Group Total: €${totalEur} (${fmt(totalEur)})`,
        ]
          .filter(Boolean)
          .join('\n');

        if (waBtn) waBtn.href = `${data.whatsappUrl}?text=${encodeURIComponent(msg)}`;
        if (tgBtn) tgBtn.href = `${data.telegramUrl}?text=${encodeURIComponent(msg)}`;
      };

      currBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          currency = (btn.dataset.currency as 'EUR' | 'USD' | 'GEL') || 'EUR';
          currBtns.forEach((b) => {
            const active = b === btn;
            b.classList.toggle('active', active);
            b.setAttribute('aria-pressed', String(active));
          });
          updateSidebar();
        });
      });

      [adultsInput, childInput, dateInput, pickupInput, ...Array.from(addonChecks)].forEach((el) => {
        el?.addEventListener('input', updateSidebar);
        el?.addEventListener('change', updateSidebar);
      });

      updateSidebar();
    }
  </script>
</BaseLayout>

