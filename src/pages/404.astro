---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { withBase } from '../lib/urls';
---

<BaseLayout
  title={`Page Not Found | ${SITE.brandName}`}
  description="The page you requested could not be found. Explore guided tours from Batumi across Georgia."
>
  <section class="section">
    <div class="container" style="max-width: 42rem; text-align: center; padding-block: 3rem;">
      <span class="eyebrow">404 · Trail Not Found</span>
      <h1>Even good trails fork sometimes.</h1>
      <p style="font-size: 1.05rem; margin-bottom: 2rem;">
        The page you followed isn’t at this trailhead. Head back to our Batumi day tours or contact our reservations desk to find the right route.
      </p>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem;">
        <a class="btn btn-coral" href={withBase('/tours/')}>Browse All Tours</a>
        <a class="btn btn-outline" href={withBase('/')}>Return Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
