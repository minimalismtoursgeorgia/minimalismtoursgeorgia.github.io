---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import {
  SITE,
  B2B_PARTNER_TYPES,
  B2B_GUARANTEES,
  VEHICLES,
  CERTIFICATIONS,
} from '../../data/site';
import { getPartnerProofReviews } from '../../data/reviews';
import { withBase, absoluteUrl } from '../../lib/urls';

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'B2B & Partners', item: absoluteUrl('/partners/', Astro.site) },
  ],
};
---

<BaseLayout
  title={`B2B Ground Handling & Travel Trade Partners | ${SITE.brandName}`}
  description="Partner with Minimalism Tours Georgia for Batumi and Adjara DMC ground handling, hotel concierge excursions, corporate retreats, and certified small-group logistics across Georgia."
  canonicalPath="/partners/"
  alternateEnPath="/partners/"
  alternatePlPath="/pl/partners/"
  alternateUkPath="/uk/partners/"
  alternateHePath="/he/partners/"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">B2B &amp; Partners</span>
      </nav>
      <span class="eyebrow">Batumi &amp; Adjara DMC · Travel Trade Operations</span>
      <h1>B2B Ground Handling &amp; Agency Partnerships</h1>
      <p style="max-width: 48rem; font-size: 1.05rem;">
        {SITE.brandName} provides reliable local operations from Batumi across Adjara, Kolkheti, Svaneti, and Kazbegi for international tour operators, local hotels, corporate teams, and cruise or academic delegations.
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.35rem;">
        <a
          class="btn btn-coral"
          href={`${SITE.whatsappUrl}?text=${encodeURIComponent('Hello Minimalism Tours Georgia B2B Desk! We would like to discuss B2B net tariffs and ground handling in Batumi / Georgia.')}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Request B2B Tariff on WhatsApp →
        </a>
        <a
          class="btn btn-forest"
          href={`${SITE.telegramUrl}?text=${encodeURIComponent('Hello Minimalism Tours Georgia B2B Desk! We would like to discuss agency/hotel cooperation.')}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Message B2B Desk on Telegram
        </a>
        <a class="btn btn-outline" href="#b2b-inquiry">Submit Partner Brief</a>
      </div>
    </div>
  </section>

  <!-- Who We Partner With -->
  <section id="partner-types" class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Tailored Trade Cooperation</span>
          <h2>Who We Partner With</h2>
        </div>
        <p>Flexible cooperation built for agencies, hotel desks, corporate retreats, and special-interest groups.</p>
      </div>

      <div class="partner-grid">
        {
          B2B_PARTNER_TYPES.map((partner) => (
            <article class="partner-card reveal-on-scroll">
              <span class="badge badge-forest">{partner.tag}</span>
              <h3>{partner.title}</h3>
              <p>{partner.summary}</p>
              <ul class="partner-points">
                {partner.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Operational Guarantees & Fleet -->
  <section id="guarantees" class="section section-surface">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Operational Standards &amp; Logistics</span>
          <h2>B2B Service Guarantees &amp; Fleet</h2>
        </div>
        <p>Consistent safety, transparent pricing, and weather-backed operations across coastal and alpine Georgia.</p>
      </div>

      <div class="guarantees-grid">
        {
          B2B_GUARANTEES.map((g) => (
            <article class="guarantee-card reveal-on-scroll">
              <h3>{g.title}</h3>
              <p>{g.detail}</p>
            </article>
          ))
        }
      </div>

      <div class="fleet-subhead">
        <span class="eyebrow">Dedicated Fleet</span>
        <h3>Matched Vehicle Classes (1 to 16+ Guests)</h3>
      </div>

      <div class="fleet-grid">
        {
          VEHICLES.map((v) => (
            <article class="fleet-card reveal-on-scroll">
              <span class="badge badge-sea">{v.capacity}</span>
              <h4>{v.name}</h4>
              <p>{v.idealFor}</p>
              <ul>
                {v.amenities.map((a) => <li>{a}</li>)}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="cert-strip" aria-label="Company guiding and safety certifications">
        {
          CERTIFICATIONS.map((c) => (
            <span class="badge badge-forest">{c.title}</span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Proven B2B & Safety Track Record -->
  <ReviewsSection
    sectionId="partner-proof"
    reviews={getPartnerProofReviews()}
    variant="band"
    surface="subtle"
    eyebrow="Proven B2B & Safety Track Record"
    heading="Partner Feedback & Weather-Safety Handling"
    intro="Real feedback from an international tour operator and guests whose departures were cancelled honestly for mountain safety."
    showPlatformBar={false}
  />

  <!-- Request B2B Tariff / Partner Brief -->
  <section id="b2b-inquiry" class="section">
    <div class="container b2b-form-wrap">
      <div class="b2b-form-card">
        <span class="eyebrow">24/7 B2B Operations Desk</span>
        <h2>Request B2B Tariff or Custom Group Proposal</h2>
        <p style="font-size: 0.94rem; margin-bottom: 1.5rem;">
          Share your company profile and route requirements below to open an instant pre-filled brief via <strong>WhatsApp</strong>, <strong>Telegram</strong>, or copy it to your clipboard.
        </p>

        <form id="b2b-partner-form" class="form-grid" data-enhanced-validation novalidate>
          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="p-company">Company / Agency Name *</label>
              <span id="p-company-hint" class="field-hint">Required so we can prepare a partner quote</span>
              <input
                id="p-company"
                name="company"
                type="text"
                required
                minlength="2"
                autocomplete="organization"
                aria-describedby="p-company-hint"
                data-error="p-company-error"
                placeholder="e.g. Black Sea Travel DMC or Hotel Batumi"
              />
              <div id="p-company-error" class="error-msg">
                <span role="img" aria-label="Error">⚠</span> Please enter at least 2 characters for your company or agency name.
              </div>
            </div>

            <div class="field">
              <label for="p-type">Partner Type *</label>
              <span id="p-type-hint" class="field-hint">Select your primary cooperation model</span>
              <select
                id="p-type"
                name="partnerType"
                required
                aria-describedby="p-type-hint"
                data-error="p-type-error"
              >
                <option value="">Choose partner type...</option>
                <option value="Travel Agency / Tour Operator / DMC">Travel Agency / Tour Operator / DMC</option>
                <option value="Batumi Hotel / Concierge Desk">Batumi Hotel / Concierge Desk</option>
                <option value="Corporate / Team Retreat">Corporate / Team Retreat</option>
                <option value="Cruise Shore Excursion / Academic Group">Cruise Shore Excursion / Academic Group</option>
                <option value="Custom B2B Ground Handling">Custom B2B Ground Handling</option>
              </select>
              <div id="p-type-error" class="error-msg">
                <span role="img" aria-label="Error">⚠</span> Please select your partner type.
              </div>
            </div>
          </div>

          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="p-location">Country / City</label>
              <span id="p-location-hint" class="field-hint">Where your guests or agency operate from</span>
              <input
                id="p-location"
                name="location"
                type="text"
                autocomplete="country-name"
                aria-describedby="p-location-hint"
                placeholder="e.g. Batumi, Georgia / Warsaw, Poland"
              />
            </div>

            <div class="field">
              <label for="p-group">Expected Group Size &amp; Season</label>
              <span id="p-group-hint" class="field-hint">Optional: pax range, monthly departures, or travel window</span>
              <input
                id="p-group"
                name="groupSeason"
                type="text"
                aria-describedby="p-group-hint"
                placeholder="e.g. 6–14 guests · May–September"
              />
            </div>
          </div>

          <div class="field">
            <label for="p-notes">Routes, Languages &amp; Operational Notes</label>
            <span id="p-notes-hint" class="field-hint">Optional: net vs. commissionable rates, white-label guiding, Mtirala/Kazbegi/Svaneti modules</span>
            <textarea
              id="p-notes"
              name="notes"
              aria-describedby="p-notes-hint"
              placeholder="Tell us about your target itineraries, pickup hotels/ports, or multi-day requirements..."
            ></textarea>
          </div>

          <div class="b2b-submit-row">
            <button type="submit" class="btn btn-coral">Send via WhatsApp →</button>
            <button id="p-tg-btn" type="button" class="btn btn-forest">Send via Telegram →</button>
            <button id="p-copy-btn" type="button" class="btn btn-outline">Copy B2B Brief</button>
          </div>

          <p id="p-feedback" class="b2b-feedback" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script
  id="partners-config"
  type="application/json"
  set:html={JSON.stringify({
    whatsappUrl: SITE.whatsappUrl,
    telegramUrl: SITE.telegramUrl,
  })}
/>

<script>
  const cfgNode = document.getElementById('partners-config');
  const cfg = cfgNode?.textContent ? JSON.parse(cfgNode.textContent) : null;

  const form = document.getElementById('b2b-partner-form') as HTMLFormElement | null;
  const tgBtn = document.getElementById('p-tg-btn');
  const copyBtn = document.getElementById('p-copy-btn');
  const feedbackEl = document.getElementById('p-feedback');

  const getBrief = () => {
    if (!form) return '';
    const d = new FormData(form);
    return [
      'Minimalism Tours Georgia — B2B Partner Brief',
      `Company / Agency: ${d.get('company')}`,
      `Partner Type: ${d.get('partnerType')}`,
      d.get('location') ? `Country / City: ${d.get('location')}` : '',
      d.get('groupSeason') ? `Group Size & Season: ${d.get('groupSeason')}` : '',
      d.get('notes') ? `Notes: ${d.get('notes')}` : '',
    ]
      .filter(Boolean)
      .join('\n');
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity() || !cfg) return;
    const url = `${cfg.whatsappUrl}?text=${encodeURIComponent(getBrief())}`;
    window.open(url, '_blank', 'noopener,noreferrer');
    if (feedbackEl) {
      feedbackEl.textContent = 'Opening WhatsApp with your B2B partner brief.';
    }
  });

  tgBtn?.addEventListener('click', () => {
    if (!form || !form.reportValidity() || !cfg) return;
    const url = `${cfg.telegramUrl}?text=${encodeURIComponent(getBrief())}`;
    window.open(url, '_blank', 'noopener,noreferrer');
    if (feedbackEl) {
      feedbackEl.textContent = 'Opening Telegram with your B2B partner brief.';
    }
  });

  copyBtn?.addEventListener('click', async () => {
    if (!form || !form.reportValidity()) return;
    try {
      await navigator.clipboard.writeText(getBrief());
      if (feedbackEl) {
        feedbackEl.textContent = 'B2B partner brief copied to your clipboard!';
      }
    } catch {
      if (feedbackEl) {
        feedbackEl.textContent = 'Please use Send via WhatsApp or Telegram above.';
      }
    }
  });
</script>

<style>
  .page-banner {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--ink-600);
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--ink-700);
    text-decoration: none;
    font-weight: 600;
  }

  .partner-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .partner-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: clamp(1.35rem, 2.5vw, 1.85rem);
    box-shadow: var(--shadow-xs);
  }

  .partner-card h3 {
    margin: 0.85rem 0 0.5rem;
    font-size: 1.25rem;
  }

  .partner-points {
    margin: 0.85rem 0 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.4rem;
    color: var(--ink-700);
    font-size: 0.92rem;
  }

  .guarantees-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .guarantee-card {
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.35rem;
  }

  .guarantee-card h3 {
    margin-bottom: 0.45rem;
    font-size: 1.08rem;
  }

  .guarantee-card p {
    margin-bottom: 0;
    font-size: 0.92rem;
  }

  .fleet-subhead {
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
  }

  .fleet-subhead h3 {
    margin: 0.35rem 0 0;
    font-size: 1.35rem;
  }

  .fleet-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .fleet-card {
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.35rem;
  }

  .fleet-card h4 {
    margin: 0.8rem 0 0.45rem;
    font-size: 1.12rem;
  }

  .fleet-card ul {
    margin: 0.75rem 0 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.3rem;
    font-size: 0.88rem;
    color: var(--ink-700);
  }

  .cert-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .b2b-form-wrap {
    max-width: 54rem;
  }

  .b2b-form-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 3.2vw, 2.5rem);
    box-shadow: var(--shadow-xs);
  }

  .b2b-form-card h2 {
    margin-top: 0.4rem;
  }

  .b2b-submit-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .b2b-feedback {
    margin: 0.25rem 0 0;
    min-height: 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--forest-800);
  }
</style>
