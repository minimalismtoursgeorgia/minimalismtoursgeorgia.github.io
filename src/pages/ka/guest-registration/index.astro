---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuestRegistrationForm from '../../../components/GuestRegistrationForm.astro';
import { SITE } from '../../../data/site';
import { withBase, absoluteUrl } from '../../../lib/urls';

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'მთავარი', item: absoluteUrl('/ka/', Astro.site) },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'სტუმრის რეგისტრაცია და სამედიცინო ფორმა',
      item: absoluteUrl('/ka/guest-registration/', Astro.site),
    },
  ],
};
---

<BaseLayout
  title={`სტუმრის რეგისტრაცია და სამედიცინო ფორმა | ${SITE.brandName}`}
  description="კონფიდენციალური წინასამგზავრო რეგისტრაცია, საგანგებო კონტაქტი, დაზღვევა და სამედიცინო უსაფრთხოების ფორმა Minimalism Tours Georgia-ს ტურებისთვის."
  canonicalPath="/ka/guest-registration/"
  alternateEnPath="/guest-registration/"
  alternateKaPath="/ka/guest-registration/"
  alternatePlPath="/pl/guest-registration/"
  alternateUkPath="/uk/guest-registration/"
  alternateHePath="/he/guest-registration/"
  lang="ka"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/ka/')}>მთავარი</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">სტუმრის რეგისტრაცია და სამედიცინო ფორმა</span>
      </nav>
      <span class="eyebrow">უსაფრთხოება და წინასწარი რეგისტრაცია</span>
      <h1>სტუმრის რეგისტრაცია და გადაუდებელი სამედიცინო ფორმა</h1>
      <p>
        სტანდარტული საველე უსაფრთხოების ფორმა მტირალას, მაჭახელასა და კავკასიონის ტურებისთვის ({SITE.brandName}).
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 58rem;">
      <GuestRegistrationForm lang="ka" />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.85rem;
    color: var(--ink-600);
    margin-bottom: 0.85rem;
  }

  .breadcrumbs a {
    color: var(--ink-700);
    text-decoration: none;
    font-weight: 600;
  }

  .page-hero p {
    max-width: 46rem;
    margin-bottom: 0;
  }
</style>
