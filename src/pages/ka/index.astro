---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroShowcase, { type FeaturedTourSlide } from '../../components/HeroShowcase.astro';
import { SITE, PICKUP_POINTS } from '../../data/site';
import { KA_CONTENT } from '../../data/i18n-ka';
import { withBase, absoluteUrl } from '../../lib/urls';

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'მთავარი', item: absoluteUrl('/ka/', Astro.site) },
  ],
};

const kaFeaturedTours: FeaturedTourSlide[] = [
  {
    titleLines: ['მტირალა 9 კმ', 'ჩანჩქერის ბილიკი'],
    location: 'მტირალას პარკი',
    badgeText: 'UNESCO',
    image: withBase('/images/mtirala-waterfall-hiker.webp'),
    imageAlt: 'მოლაშქრე ჩანჩქერთან მტირალას ეროვნული პარკის 9 კმ ტყის ბილიკზე',
    href: withBase('/tours/?region=mtirala'),
  },
  {
    titleLines: ['მტირალა 2 დღე', 'თავშესაფარში'],
    location: 'აჭარა, საქართველო',
    badgeText: '2 დღე',
    image: withBase('/images/mtirala-2day.webp'),
    imageAlt: 'მტირალას ეროვნული პარკის ხის თავშესაფარი ნისლიან წიფლნარში',
    href: withBase('/tours/mtirala-2-day-shelter-hike/'),
  },
  {
    titleLines: ['მყინვარწვერი', 'ალპური ლაშქრობა'],
    location: 'ყაზბეგი, საქართველო',
    badgeText: '5,054 მ',
    image: withBase('/images/kazbegi-peak.webp'),
    imageAlt: 'დათოვლილი მყინვარწვერი სტეფანწმინდას ხეობის თავზე',
    href: withBase('/tours/kazbegi-mount-kazbek-expedition/'),
  },
];
---

<BaseLayout
  title={KA_CONTENT.title}
  description={KA_CONTENT.description}
  canonicalPath="/ka/"
  alternateEnPath="/"
  alternateKaPath="/ka/"
  alternatePlPath="/pl/"
  lang="ka"
  jsonLd={[breadcrumbJsonLd]}
>
  <HeroShowcase
    watermarkText="MINIMALISM"
    headlineLines={['საქართველო,', 'ღია ბარათების', 'მიღმა.']}
    ctaLabel="ტურების ნახვა"
    ctaHref={withBase('/tours/')}
    subcopy="აღმოაჩინე იუნესკოს კოლხური ტყეები, აჭარის ფარული ბილიკები და კავკასიონის ავთენტური მარშრუტები სერტიფიცირებულ გიდებთან ერთად."
    bgImage={withBase('/images/mestia-svaneti.webp')}
    bgAlt="კავკასიონის ალპური ბილიკი და დათოვლილი მწვერვალები საქართველოში"
    featuredTours={kaFeaturedTours}
    trustStat={`${SITE.experienceYears}+ წ.`}
    trustCopy="10+ წლიანი გამოცდილება, GMGA/FMGA და იუნესკოს სტანდარტები ინდივიდუალური და B2B ჯგუფებისთვის."
    trustLinkLabel="ძირითადი ტურები ↓"
    trustLinkHref="#ka-tours"
    switcherLabel="რჩეული ტურების გადართვა"
  />

  <section class="section-surface section-tight">
    <div class="container">
      <h2 style="font-size: 1.35rem; margin-bottom: 1rem;">{KA_CONTENT.credentialsTitle}</h2>
      <ul class="ka-cred-grid">
        {KA_CONTENT.credentials.map((c) => <li>✓ {c}</li>)}
      </ul>
    </div>
  </section>

  <section id="ka-tours" class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">ბათუმი · აჭარა</span>
          <h2>{KA_CONTENT.coreToursTitle}</h2>
        </div>
        <p>{KA_CONTENT.contactNote}</p>
      </div>

      <div class="ka-tours-grid">
        {
          KA_CONTENT.coreTours.map((t) => (
            <article class="ka-tour-card reveal-on-scroll">
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.65rem;">
                <span class="badge badge-forest">{t.duration}</span>
                <span class="badge badge-sea">{t.price}</span>
              </div>
              <h3>
                <a href={withBase(`/tours/${t.slug}/`)}>{t.title}</a>
              </h3>
              <p>{t.note}</p>
              <a class="btn btn-outline btn-sm" href={withBase(`/tours/${t.slug}/`)}>
                დეტალები და ფასები →
              </a>
            </article>
          ))
        }
      </div>

      <aside class="ka-optional-banner reveal-on-scroll" aria-label="დამატებითი აქტივობები სურვილისამებრ">
        <div>
          <span class="badge badge-sea">{KA_CONTENT.optionalExtras.badge}</span>
          <h3>{KA_CONTENT.optionalExtras.title}</h3>
          <p>{KA_CONTENT.optionalExtras.note}</p>
        </div>
        <div class="ka-optional-pills">
          {KA_CONTENT.optionalExtras.items.map((item) => (
            <span class="badge badge-forest">{item}</span>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-surface">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">{SITE.defaultStartTime} გასვლა</span>
          <h2>{KA_CONTENT.pickupsTitle}</h2>
        </div>
      </div>

      <div class="ka-pickup-grid">
        {
          PICKUP_POINTS.map((p, i) => (
            <article class="ka-pickup-card">
              <span class="badge badge-coral">0{i + 1}</span>
              <h3>{p.name}</h3>
              <p>{p.address}</p>
              <a href={p.mapsUrl} target="_blank" rel="noopener noreferrer">
                რუკაზე ნახვა ↗
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ka-cred-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    font-weight: 600;
    font-size: 0.93rem;
    color: var(--ink-900);
  }

  .ka-tours-grid,
  .ka-pickup-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .ka-tour-card,
  .ka-pickup-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.35rem;
  }

  .ka-tour-card h3 {
    font-size: 1.18rem;
    margin-bottom: 0.55rem;
  }

  .ka-tour-card h3 a {
    color: var(--ink-900);
    text-decoration: none;
  }

  .ka-pickup-card h3 {
    margin-top: 0.65rem;
    margin-bottom: 0.3rem;
  }

  .ka-pickup-card p {
    font-size: 0.88rem;
    margin-bottom: 0.75rem;
  }

  .ka-optional-banner {
    margin-top: 1.5rem;
    padding: 1.25rem 1.35rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-inline-start: 4px solid var(--sea-600);
    border-radius: var(--radius-lg);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.25rem;
  }

  .ka-optional-banner h3 {
    margin: 0.5rem 0 0.3rem;
    font-size: 1.1rem;
  }

  .ka-optional-banner p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-700);
  }

  .ka-optional-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
</style>
