---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SocialIcon from '../../../components/SocialIcon.astro';
import { SITE, PICKUP_POINTS, SOCIAL_LINKS } from '../../../data/site';
import { HE_SITE, HE_PICKUP_POINTS, getToursForLangHe } from '../../../data/i18n-he';
import { withBase, absoluteUrl } from '../../../lib/urls';

const heTours = getToursForLangHe('he');

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ראשי', item: absoluteUrl('/he/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'צור קשר', item: absoluteUrl('/he/contact/', Astro.site) },
  ],
};
---

<BaseLayout
  title={`צור קשר והזמנת סיור | ${SITE.brandName}`}
  description="צרו קשר עם Minimalism Tours Georgia ב-WhatsApp, Telegram או טלפון להזמנת סיורים מבטומי, מסלולים פרטיים באג׳רה, שיתופי פעולה B2B או טיפוס להר קזבק."
  canonicalPath="/he/contact/"
  alternateEnPath="/contact/"
  alternateKaPath="/ka/"
  alternatePlPath="/pl/contact/"
  alternateUkPath="/uk/contact/"
  alternateHePath="/he/contact/"
  lang="he"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/he/')}>ראשי</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">צור קשר</span>
      </nav>
      <span class="eyebrow">אפס עמלות תיווך · מענה ישיר בבטומי</span>
      <h1>תכננו סיור או שלחו שאלה</h1>
      <p style="max-width: 46rem; font-size: 1.05rem;">
        שלחו את התאריכים המועדפים, גודל הקבוצה ונקודת האיסוף בבטומי ישירות לצוות ההזמנות שלנו — או כתבו מיידית ב-WhatsApp לבדיקת מצב השבילים.{' '}
        <a href={withBase('/he/partners/')}>מחפשים מחירי נטו B2B? עברו ל-B2B ושותפים →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <!-- Accessible Direct Request Form -->
      <div class="contact-form-card">
        <h2>הזמנה ישירה ותכנון מסלול</h2>
        <p style="font-size: 0.94rem; margin-bottom: 1.5rem;">
          מלאו את הפרטים למטה ובחרו איך לשלוח: הודעה מוכנה ב-<strong>WhatsApp</strong>, ב-<strong>Telegram</strong> או העתקה ללוח.
        </p>

        <form id="full-contact-form" class="form-grid" data-enhanced-validation novalidate>
          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="c-name">שם מלא *</label>
              <span id="c-name-hint" class="field-hint">נדרש לאישור ההזמנה</span>
              <input
                id="c-name"
                name="name"
                type="text"
                required
                minlength="2"
                autocomplete="name"
                aria-describedby="c-name-hint"
                data-error="c-name-error"
                placeholder="השם שלכם"
              />
              <div id="c-name-error" class="error-msg">
                <span role="img" aria-label="שגיאה">⚠</span> אנא הזינו לפחות 2 תווים לשם.
              </div>
            </div>

            <div class="field">
              <label for="c-email">כתובת דוא״ל *</label>
              <span id="c-email-hint" class="field-hint">פורמט: you@example.com</span>
              <input
                id="c-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                aria-describedby="c-email-hint"
                data-error="c-email-error"
                placeholder="you@example.com"
              />
              <div id="c-email-error" class="error-msg">
                <span role="img" aria-label="שגיאה">⚠</span> אנא הזינו כתובת דוא״ל תקינה.
              </div>
            </div>
          </div>

          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="c-tour">סיור או מסלול מבוקש *</label>
              <span id="c-tour-hint" class="field-hint">בחרו סיור קבוע או מסלול מותאם אישית</span>
              <select
                id="c-tour"
                name="tour"
                required
                aria-describedby="c-tour-hint"
                data-error="c-tour-error"
              >
                <option value="">בחרו סיור...</option>
                {heTours.map((t) => <option value={t.title}>{t.shortTitle} ({t.duration})</option>)}
                <option value="מסלול פרטי באג׳רה / האגם הירוק / קולחתי">
                  מסלול פרטי באג׳רה / האגם הירוק / קולחתי
                </option>
                <option value="שיתוף פעולה B2B (מלון / סוכנות נסיעות)">
                  שיתוף פעולה B2B (מלון / סוכנות נסיעות)
                </option>
              </select>
              <div id="c-tour-error" class="error-msg">
                <span role="img" aria-label="שגיאה">⚠</span> אנא בחרו סיור או סוג פנייה.
              </div>
            </div>

            <div class="field">
              <label for="c-pickup">נקודת איסוף בבטומי</label>
              <span id="c-pickup-hint" class="field-hint">או בחרו מלון במרכז / אזור אחר</span>
              <select id="c-pickup" name="pickup" aria-describedby="c-pickup-hint">
                {PICKUP_POINTS.map((p) => {
                  const heP = HE_PICKUP_POINTS[p.id];
                  return <option value={heP ? heP.name : p.name}>{heP ? heP.name : p.name}</option>;
                })}
                <option value="המלון שלי במרכז בטומי">המלון שלי במרכז בטומי</option>
                <option value="סטפנצמינדה / קזבגי / אזור אחר">סטפנצמינדה / קזבגי / אזור אחר</option>
              </select>
            </div>
          </div>

          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="c-date">תאריך מועדף</label>
              <span id="c-date-hint" class="field-hint">השאירו ריק אם התאריכים גמישים</span>
              <input id="c-date" name="date" type="date" aria-describedby="c-date-hint" />
            </div>

            <div class="field">
              <label for="c-guests">מספר מטיילים (1–16) *</label>
              <span id="c-guests-hint" class="field-hint">סך המשתתפים כולל ילדים</span>
              <input
                id="c-guests"
                name="guests"
                type="number"
                min="1"
                max="16"
                value="2"
                required
                aria-describedby="c-guests-hint"
                data-error="c-guests-error"
              />
              <div id="c-guests-error" class="error-msg">
                <span role="img" aria-label="שגיאה">⚠</span> גודל הקבוצה חייב להיות בין 1 ל-16 מטיילים.
              </div>
            </div>
          </div>

          <div class="field">
            <label for="c-notes">שאלות, העדפות תזונה או ציוד</label>
            <span id="c-notes-hint" class="field-hint">אופציונלי: ארוחות צמחוניות, מקלות הליכה, תאריכים לקזבק או גילאי ילדים</span>
            <textarea
              id="c-notes"
              name="notes"
              aria-describedby="c-notes-hint"
              placeholder="ספרו לנו איך נראה יום הטיול האידיאלי שלכם..."
            ></textarea>
          </div>

          <div class="contact-submit-row">
            <button type="submit" class="btn btn-coral">
              שליחה ב-WhatsApp →
            </button>
            <button id="c-tg-btn" type="button" class="btn btn-forest">
              שליחה ב-Telegram →
            </button>
            <button id="c-copy-btn" type="button" class="btn btn-outline">
              העתקת הסיכום
            </button>
          </div>

          <p id="c-feedback" class="contact-feedback" role="status" aria-live="polite"></p>
        </form>
      </div>

      <!-- Direct Channels -->
      <aside class="contact-side">
        <div class="side-panel">
          <span class="eyebrow">ערוצים ישירים</span>
          <h2>פרטי קשר — Minimalism Tours Georgia</h2>
          <ul class="direct-list">
            <li>
              <strong>WhatsApp וטלפון</strong>
              <a href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer">
                {SITE.phoneDisplay} (התגובה המהירה ביותר)
              </a>
              <a href={`tel:${SITE.phoneRaw}`}>חייגו {SITE.phoneDisplay}</a>
            </li>
            <li>
              <strong>Telegram</strong>
              <a href={SITE.telegramUrl} target="_blank" rel="noopener noreferrer">
                @MinimalismToursGeorgia ↗
              </a>
            </li>
            <li>
              <strong>כתובת המשרד</strong>
              <a href={SITE.googleBusinessUrl} target="_blank" rel="noopener noreferrer">
                {SITE.officeAddressDisplay} ↗
              </a>
            </li>
            <li>
              <strong>שעות פעילות</strong>
              <span>{HE_SITE.officeHoursDisplay}</span>
            </li>
            <li>
              <strong>GetYourGuide</strong>
              <a href={SITE.getYourGuideSupplierUrl} target="_blank" rel="noopener noreferrer">
                כל הסיורים של Minimalism Tours Georgia ↗
              </a>
            </li>
            <li>
              <strong>ביקורות Google</strong>
              <a href={SITE.googleReviewUrl} target="_blank" rel="noopener noreferrer">
                השאירו ביקורת ב-Google ↗
              </a>
            </li>
            <li>
              <strong>Tripadvisor</strong>
              <a href={SITE.tripadvisorReviewUrl} target="_blank" rel="noopener noreferrer">
                ביקורות ב-Tripadvisor ↗
              </a>
            </li>
            <li>
              <strong>Trustpilot</strong>
              <a href={SITE.trustpilotUrl} target="_blank" rel="noopener noreferrer">
                ביקורות ב-Trustpilot ↗
              </a>
            </li>
          </ul>
        </div>

        <div class="side-panel">
          <span class="eyebrow">עקבו אחרי Minimalism Tours Georgia</span>
          <h3>רשתות חברתיות רשמיות</h3>
          <ul class="social-grid">
            {
              SOCIAL_LINKS.map((s) => (
                <li>
                  <a class="social-card-link" href={s.url} target="_blank" rel="noopener noreferrer">
                    <span class="social-icon-badge" aria-hidden="true">
                      <SocialIcon id={s.id} size={18} />
                    </span>
                    <span class="social-card-meta">
                      <strong>{s.name}</strong>
                      <span>{s.handle} ↗</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="side-panel">
          <span class="eyebrow">נקודות איסוף</span>
          <h3>4 נקודות איסוף מאומתות בבטומי</h3>
          <ul class="pickup-compact">
            {
              PICKUP_POINTS.map((p) => {
                const heP = HE_PICKUP_POINTS[p.id];
                return (
                  <li>
                    <strong>{heP ? heP.name : p.name}</strong>
                    <span>{heP ? heP.address : p.address}</span>
                    <a href={p.mapsUrl} target="_blank" rel="noopener noreferrer">מפות Google ↗</a>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script
  id="contact-config"
  type="application/json"
  set:html={JSON.stringify({
    whatsappUrl: SITE.whatsappUrl,
    telegramUrl: SITE.telegramUrl,
    formspreeEndpoint: SITE.formspreeEndpoint,
  })}
/>

<script>
  const cfgNode = document.getElementById('contact-config');
  const cfg = cfgNode?.textContent ? JSON.parse(cfgNode.textContent) : null;

  const form = document.getElementById('full-contact-form') as HTMLFormElement | null;
  const tgBtn = document.getElementById('c-tg-btn');
  const copyBtn = document.getElementById('c-copy-btn');
  const feedbackEl = document.getElementById('c-feedback');

  const getSummary = () => {
    if (!form) return '';
    const d = new FormData(form);
    return [
      'Minimalism Tours Georgia — פנייה / הזמנה (HE)',
      `שם: ${d.get('name')}`,
      `דוא״ל: ${d.get('email')}`,
      `סיור: ${d.get('tour')}`,
      `איסוף: ${d.get('pickup')}`,
      `תאריך מועדף: ${d.get('date') || 'גמיש'}`,
      `מספר מטיילים: ${d.get('guests')}`,
      d.get('notes') ? `הערות: ${d.get('notes')}` : '',
    ]
      .filter(Boolean)
      .join('\n');
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity() || !cfg) return;
    const summary = getSummary();

    if (cfg.formspreeEndpoint) {
      try {
        await fetch(cfg.formspreeEndpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
      } catch {
        // Fallback cleanly to WhatsApp
      }
    }

    const waUrl = `${cfg.whatsappUrl}?text=${encodeURIComponent(summary)}`;
    window.open(waUrl, '_blank', 'noopener,noreferrer');
    if (feedbackEl) {
      feedbackEl.textContent = 'פותח את WhatsApp עם פרטי הסיור המלאים.';
    }
  });

  tgBtn?.addEventListener('click', () => {
    if (!form || !form.reportValidity() || !cfg) return;
    const summary = getSummary();
    const tgUrl = `${cfg.telegramUrl}?text=${encodeURIComponent(summary)}`;
    window.open(tgUrl, '_blank', 'noopener,noreferrer');
    if (feedbackEl) {
      feedbackEl.textContent = 'פותח את Telegram עם פרטי הסיור המלאים.';
    }
  });

  copyBtn?.addEventListener('click', async () => {
    if (!form || !form.reportValidity()) return;
    try {
      await navigator.clipboard.writeText(getSummary());
      if (feedbackEl) {
        feedbackEl.textContent = 'סיכום הפנייה הועתק ללוח!';
      }
    } catch {
      if (feedbackEl) {
        feedbackEl.textContent = 'השתמשו בכפתור שליחה ב-WhatsApp או Telegram למעלה.';
      }
    }
  });
</script>

<style>
  .page-banner {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--ink-600);
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--ink-700);
    text-decoration: none;
    font-weight: 600;
  }

  .contact-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 58rem) {
    .contact-grid {
      grid-template-columns: 1.35fr 0.85fr;
    }
  }

  .contact-form-card,
  .side-panel {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: clamp(1.4rem, 3vw, 2.25rem);
    box-shadow: var(--shadow-xs);
  }

  .contact-side {
    display: grid;
    gap: 1.5rem;
  }

  .direct-list,
  .pickup-compact {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .direct-list li,
  .pickup-compact li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.92rem;
  }

  .direct-list li:last-child,
  .pickup-compact li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .pickup-compact span {
    color: var(--ink-600);
    font-size: 0.85rem;
  }

  .social-grid {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: 0.65rem;
  }

  .social-card-link {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-page);
    color: var(--ink-900);
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .social-icon-badge {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--forest-100);
    color: var(--forest-800);
    transition: background-color 160ms ease, color 160ms ease;
  }

  .social-card-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .social-card-link strong {
    font-size: 0.92rem;
    color: var(--forest-800);
  }

  .social-card-link span {
    font-size: 0.8rem;
    color: var(--ink-600);
    overflow-wrap: anywhere;
  }

  .social-card-link:hover,
  .social-card-link:focus-visible {
    border-color: var(--forest-800);
    background-color: var(--forest-100);
    transform: translateY(-1px);
  }

  .social-card-link:hover .social-icon-badge,
  .social-card-link:focus-visible .social-icon-badge {
    background-color: var(--forest-800);
    color: #ffffff;
  }

  .contact-submit-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .contact-feedback {
    margin: 0.25rem 0 0;
    min-height: 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--forest-800);
  }
</style>
