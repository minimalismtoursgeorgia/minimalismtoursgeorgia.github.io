---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../data/site';
import {
  HE_SITE,
  HE_CERTIFICATIONS,
  HE_VEHICLES,
  HE_CONTENT_PILLARS,
} from '../../../data/i18n-he';
import { withBase, absoluteUrl } from '../../../lib/urls';

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ראשי', item: absoluteUrl('/he/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'אודות', item: absoluteUrl('/he/about/', Astro.site) },
  ],
};
---

<BaseLayout
  title={`אודות ${SITE.brandName} | מפעילי סיורים בבטומי ו-DMC באג׳רה`}
  description="Minimalism Tours Georgia — מפעילי סיורים מורשים בבטומי עם מעל 10 שנות ניסיון בתקני GMGA/FMGA, מורשת UNESCO ועזרה ראשונה של הצלב האדום."
  canonicalPath="/he/about/"
  alternateEnPath="/about/"
  alternateKaPath="/ka/"
  alternatePlPath="/pl/about/"
  alternateUkPath="/uk/about/"
  alternateHePath="/he/about/"
  lang="he"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/he/')}>ראשי</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">אודות</span>
      </nav>
      <span class="eyebrow">מפעילי סיורים מורשים ו-DMC · בטומי</span>
      <h1>אודות Minimalism Tours Georgia</h1>
      <p style="max-width: 46rem; font-size: 1.05rem;">
        «{HE_SITE.motto}» — סיורי טבע, תרבות ו-B2B לא ממוסחרים ברחבי אג׳רה וגאורגיה עם מדריכים מוסמכים ולוגיסטיקה שקופה.
      </p>
    </div>
  </section>

  <!-- Company Operations & Philosophy -->
  <section class="section">
    <div class="container founder-grid">
      <div class="founder-photo">
        <img
          src={withBase('/images/mtirala-canopy.webp')}
          alt="יער הגשם הממוזג של קולחתי (UNESCO) בפארק הלאומי מטירלה ליד בטומי"
          fetchpriority="high"
          width="1200"
          height="800"
          decoding="async"
        />
      </div>

      <div>
        <span class="eyebrow">מפעילי סיורים בבטומי ו-DMC אג׳רה</span>
        <h2>Minimalism Tours Georgia · {SITE.experienceYears}+ שנות ניסיון בגאורגיה</h2>
        <p>
          מבסיסנו בבטומי שעל חוף הים השחור, Minimalism Tours Georgia מפעילה סיורים בקבוצות קטנות, סיורים פרטיים ותוכניות B2B למטיילים ושותפים המעדיפים עומק ואיכות מקומית על פני תחנות אוטובוס חפוזות. מיערות הגשם של קולחתי (UNESCO) במטירלה ומצ׳אחלה ועד משלחות הרים בקזבגי וסוואנתי — הצוות שלנו שם דגש על בטיחות, אקולוגיה וקצב נעים.
        </p>
        <p>
          כל מסלול כולל הערכת קושי כנה, תוכנית גיבוי למזג אוויר, נקודות איסוף מדויקות ושקיפות מלאה במחיר — ללא הפתעות בתשלום במקום.
        </p>

        <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem;">
          <a class="btn btn-coral" href={withBase('/he/tours/')}>צפו בכל הסיורים</a>
          <a class="btn btn-forest" href={withBase('/he/partners/')}>B2B ושותפויות</a>
          <a class="btn btn-outline" href={SITE.youtubeUrl} target="_blank" rel="noopener noreferrer">
            סרטוני מסלולים ב-YouTube ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Certifications -->
  <section id="certifications" class="section section-surface">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">הכשרה ובטיחות מטיילים</span>
          <h2>הסמכות מדריכים מאומתות</h2>
        </div>
        <p>הסמכות רשמיות בהדרכת טבע, טרקים בהרים ועזרה ראשונה.</p>
      </div>

      <div class="cert-grid">
        {
          HE_CERTIFICATIONS.map((c) => (
            <article class="cert-card reveal-on-scroll">
              <span class="badge badge-forest">{c.issuer}</span>
              <h3>{c.title}</h3>
              <p>{c.scope}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Vehicles & Onboard Comfort -->
  <section id="fleet" class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">תחבורה להרים ולחוף</span>
          <h2>צי רכבים המותאם לגודל הקבוצה ולשטח</h2>
        </div>
        <p>רכבים נוחים עם מיזוג אוויר ו-Wi-Fi לטיפוסים הרריים ולמסלולי חוף.</p>
      </div>

      <div class="vehicle-grid">
        {
          HE_VEHICLES.map((v) => (
            <article class="vehicle-card reveal-on-scroll">
              <span class="badge badge-sea">{v.capacity}</span>
              <h3>{v.name}</h3>
              <p>{v.idealFor}</p>
              <ul>
                {v.amenities.map((a) => <li>{a}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Brand Pillars + B2B Partnerships -->
  <section id="standards" class="section section-forest">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">איך אנחנו עובדים</span>
          <h2>ארבעת עמודי התווך ואירוח B2B</h2>
        </div>
      </div>

      <div class="about-pillars">
        {
          HE_CONTENT_PILLARS.map((p) => (
            <div class="about-pillar">
              <h3>{p.name}</h3>
              <p>{p.summary}</p>
            </div>
          ))
        }
      </div>

      <div class="b2b-box">
        <div>
          <h3>מלונות, הוסטלים ושותפי תיירות</h3>
          <p style="margin-bottom: 0;">
            מחפשים מפעיל אמין לסיורי קבוצות או סיורים פרטיים מבטומי עבור האורחים שלכם? פנו אלינו לקבלת הצעת B2B עדכנית, זמינות עונתית ותנאי שותפות שקופים.
          </p>
        </div>
        <a class="btn btn-coral" href={withBase('/he/partners/#b2b-inquiry')}>בקשו תנאי B2B</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-banner {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--ink-600);
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--ink-700);
    text-decoration: none;
    font-weight: 600;
  }

  .founder-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 54rem) {
    .founder-grid {
      grid-template-columns: minmax(17rem, 23rem) 1fr;
    }
  }

  .founder-photo {
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-md);
  }

  .founder-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
  }

  .cert-grid,
  .vehicle-grid,
  .about-pillars {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .cert-card,
  .vehicle-card {
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.4rem;
  }

  .vehicle-card {
    background-color: var(--bg-surface);
  }

  .cert-card h3,
  .vehicle-card h3 {
    margin-top: 0.85rem;
    margin-bottom: 0.5rem;
    font-size: 1.18rem;
  }

  .cert-card p {
    margin-bottom: 0;
    font-size: 0.93rem;
  }

  .vehicle-card ul {
    margin: 0.85rem 0 0;
    padding-inline-start: 1.15rem;
    font-size: 0.9rem;
    color: var(--ink-700);
    display: grid;
    gap: 0.3rem;
  }

  .about-pillar {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-md);
    padding: 1.2rem;
  }

  .about-pillar h3 {
    color: #f4b69f;
    font-size: 1.12rem;
    margin-bottom: 0.45rem;
  }

  .about-pillar p {
    margin: 0;
    font-size: 0.92rem;
  }

  .b2b-box {
    margin-top: 2rem;
    padding: 1.65rem;
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.22);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .b2b-box h3 {
    margin-bottom: 0.4rem;
  }

  .b2b-box > div {
    max-width: 44rem;
  }
</style>
