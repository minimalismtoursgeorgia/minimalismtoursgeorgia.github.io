---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BatumiNewsHub from '../../../components/BatumiNewsHub.astro';
import { SITE } from '../../../data/site';
import { BATUMI_NEWS_FAQS, BATUMI_NEWS_ITEMS } from '../../../data/batumi-news';
import { absoluteUrl } from '../../../lib/urls';

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: absoluteUrl('/pl/', Astro.site) },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Batumi News i wydarzenia',
      item: absoluteUrl('/pl/batumi-news/', Astro.site),
    },
  ],
};

const itemListJsonLd = {
  '@type': 'ItemList',
  name: 'Batumi News, planowane wydarzenia i zasady podróży (2026–2027)',
  numberOfItems: BATUMI_NEWS_ITEMS.length,
  itemListElement: BATUMI_NEWS_ITEMS.map((item, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: item.title.pl || item.title.en,
    url: `${absoluteUrl('/pl/batumi-news/', Astro.site)}#${item.slug}`,
  })),
};

const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: BATUMI_NEWS_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.question.pl || faq.question.en,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer.pl || faq.answer.en,
    },
  })),
};
---

<BaseLayout
  title={`Batumi News, wydarzenia i kalendarz 2026–2027 | ${SITE.brandName}`}
  description="Kompletny przewodnik po Batumi i Adżarii: Wioska Noworoczna na Placu Europy, sezon zimowy Goderdzi, obowiązkowe ubezpieczenie turystyczne 2026, festiwale i ceny biletów."
  canonicalPath="/pl/batumi-news/"
  alternateEnPath="/batumi-news/"
  alternateKaPath="/ka/batumi-news/"
  alternatePlPath="/pl/batumi-news/"
  alternateUkPath="/uk/batumi-news/"
  lang="pl"
  keywords={[
    'Batumi wiadomości 2026 2027',
    'wydarzenia w Batumi',
    'obowiązkowe ubezpieczenie Gruzja 2026',
    'Goderdzi otwarcie 2026',
    'Minimalism Tours Georgia',
  ]}
  jsonLd={[breadcrumbJsonLd, itemListJsonLd, faqJsonLd]}
>
  <BatumiNewsHub lang="pl" />
</BaseLayout>
