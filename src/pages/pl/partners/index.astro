---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReviewsSection from '../../../components/ReviewsSection.astro';
import { SITE } from '../../../data/site';
import {
  PL_B2B_PARTNER_TYPES,
  PL_B2B_GUARANTEES,
  PL_VEHICLES,
  PL_CERTIFICATIONS,
  getReviewsForLang,
} from '../../../data/i18n-pl';
import { withBase, absoluteUrl } from '../../../lib/urls';

const plPartnerProofReviews = getReviewsForLang('pl').filter(
  (review) => review.category === 'b2b' || review.category === 'safety-cancellation',
);

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: absoluteUrl('/pl/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'B2B i Partnerzy', item: absoluteUrl('/pl/partners/', Astro.site) },
  ],
};
---

<BaseLayout
  title={`Współpraca B2B i obsługa DMC w Gruzji | ${SITE.brandName}`}
  description="Współpracuj z Minimalism Tours Georgia przy obsłudze DMC w Batumi i Adżarii, wycieczkach hotelowych, wyjazdach firmowych i certyfikowanej logistyce w całej Gruzji."
  canonicalPath="/pl/partners/"
  alternateEnPath="/partners/"
  alternateKaPath="/ka/"
  alternatePlPath="/pl/partners/"
  alternateUkPath="/uk/partners/"
  lang="pl"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/pl/')}>Start</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">B2B i Partnerzy</span>
      </nav>
      <span class="eyebrow">DMC Batumi i Adżaria · Operacje dla branży turystycznej</span>
      <h1>Obsługa B2B i partnerstwa z biurami podróży</h1>
      <p style="max-width: 48rem; font-size: 1.05rem;">
        {SITE.brandName} zapewnia niezawodną obsługę naziemną z Batumi po Adżarii, Kolchidzie, Swanetii i Kazbegi dla międzynarodowych touroperatorów, hoteli, firm oraz grup akademickich i rejsowych.
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.35rem;">
        <a
          class="btn btn-coral"
          href={`${SITE.whatsappUrl}?text=${encodeURIComponent('Dzień dobry Minimalism Tours Georgia B2B! Chcielibyśmy porozmawiać o stawkach netto B2B i obsłudze DMC w Batumi / Gruzji.')}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Poproś o cennik B2B na WhatsApp →
        </a>
        <a
          class="btn btn-forest"
          href={`${SITE.telegramUrl}?text=${encodeURIComponent('Dzień dobry Minimalism Tours Georgia B2B! Chcielibyśmy omówić współpracę agencyjną/hotelową.')}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Napisz do działu B2B na Telegram
        </a>
        <a class="btn btn-outline" href="#b2b-inquiry">Wyślij zapytanie partnerskie</a>
      </div>
    </div>
  </section>

  <!-- Who We Partner With -->
  <section id="partner-types" class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Elastyczne modele współpracy</span>
          <h2>Z kim współpracujemy</h2>
        </div>
        <p>Współpraca dopasowana do biur podróży, recepcji hotelowych, wyjazdów firmowych i grup tematycznych.</p>
      </div>

      <div class="partner-grid">
        {
          PL_B2B_PARTNER_TYPES.map((partner) => (
            <article class="partner-card reveal-on-scroll">
              <span class="badge badge-forest">{partner.tag}</span>
              <h3>{partner.title}</h3>
              <p>{partner.summary}</p>
              <ul class="partner-points">
                {partner.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Operational Guarantees & Fleet -->
  <section id="guarantees" class="section section-surface">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Standardy operacyjne i logistyka</span>
          <h2>Gwarancje B2B i flota pojazdów</h2>
        </div>
        <p>Stałe bezpieczeństwo, przejrzyste ceny i przygotowanie pogodowe na wybrzeżu oraz w wysokich górach.</p>
      </div>

      <div class="guarantees-grid">
        {
          PL_B2B_GUARANTEES.map((g) => (
            <article class="guarantee-card reveal-on-scroll">
              <h3>{g.title}</h3>
              <p>{g.detail}</p>
            </article>
          ))
        }
      </div>

      <div class="fleet-subhead">
        <span class="eyebrow">Dedykowana flota</span>
        <h3>Klasy pojazdów dopasowane do grupy (1–16+ gości)</h3>
      </div>

      <div class="fleet-grid">
        {
          PL_VEHICLES.map((v) => (
            <article class="fleet-card reveal-on-scroll">
              <span class="badge badge-sea">{v.capacity}</span>
              <h4>{v.name}</h4>
              <p>{v.idealFor}</p>
              <ul>
                {v.amenities.map((a) => <li>{a}</li>)}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="cert-strip" aria-label="Certyfikaty przewodnickie i bezpieczeństwa">
        {
          PL_CERTIFICATIONS.map((c) => (
            <span class="badge badge-forest">{c.title}</span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Proven B2B & Safety Track Record -->
  <ReviewsSection
    sectionId="partner-proof"
    reviews={plPartnerProofReviews}
    variant="band"
    surface="subtle"
    eyebrow="Potwierdzona praktyka B2B i bezpieczeństwa"
    heading="Opinie partnerów i odpowiedzialne zarządzanie pogodą"
    intro="Prawdziwe opinie międzynarodowego touroperatora oraz gości, których wyjazdy zostały uczciwie odwołane dla bezpieczeństwa na szlaku."
    showPlatformBar={false}
    lang="pl"
  />

  <!-- Request B2B Tariff / Partner Brief -->
  <section id="b2b-inquiry" class="section">
    <div class="container b2b-form-wrap">
      <div class="b2b-form-card">
        <span class="eyebrow">Całodobowe biuro operacyjne B2B 24/7</span>
        <h2>Poproś o cennik B2B lub ofertę dla grupy</h2>
        <p style="font-size: 0.94rem; margin-bottom: 1.5rem;">
          Opisz profil swojej firmy i wymagania trasy poniżej, aby otworzyć gotową wiadomość przez <strong>WhatsApp</strong>, <strong>Telegram</strong> lub skopiować ją do schowka.
        </p>

        <form id="b2b-partner-form" class="form-grid" data-enhanced-validation novalidate>
          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="p-company">Nazwa firmy / biura podróży *</label>
              <span id="p-company-hint" class="field-hint">Wymagane do przygotowania wyceny partnerskiej</span>
              <input
                id="p-company"
                name="company"
                type="text"
                required
                minlength="2"
                autocomplete="organization"
                aria-describedby="p-company-hint"
                data-error="p-company-error"
                placeholder="np. Biuro Podróży / Hotel Batumi"
              />
              <div id="p-company-error" class="error-msg">
                <span role="img" aria-label="Błąd">⚠</span> Wpisz co najmniej 2 znaki dla nazwy firmy.
              </div>
            </div>

            <div class="field">
              <label for="p-type">Typ partnera *</label>
              <span id="p-type-hint" class="field-hint">Wybierz preferowany model współpracy</span>
              <select
                id="p-type"
                name="partnerType"
                required
                aria-describedby="p-type-hint"
                data-error="p-type-error"
              >
                <option value="">Wybierz typ partnera...</option>
                <option value="Biuro podróży / Touroperator / DMC">Biuro podróży / Touroperator / DMC</option>
                <option value="Hotel / Concierge w Batumi">Hotel / Concierge w Batumi</option>
                <option value="Wyjazd firmowy / integracyjny">Wyjazd firmowy / integracyjny</option>
                <option value="Wycieczka brzegowa / Grupa akademicka">Wycieczka brzegowa / Grupa akademicka</option>
                <option value="Indywidualna obsługa DMC B2B">Indywidualna obsługa DMC B2B</option>
              </select>
              <div id="p-type-error" class="error-msg">
                <span role="img" aria-label="Błąd">⚠</span> Wybierz typ partnera.
              </div>
            </div>
          </div>

          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="p-location">Kraj / Miasto</label>
              <span id="p-location-hint" class="field-hint">Skąd pochodzą goście lub gdzie działa agencja</span>
              <input
                id="p-location"
                name="location"
                type="text"
                autocomplete="country-name"
                aria-describedby="p-location-hint"
                placeholder="np. Warszawa, Polska / Batumi, Gruzja"
              />
            </div>

            <div class="field">
              <label for="p-group">Przewidywana wielkość grupy i sezon</label>
              <span id="p-group-hint" class="field-hint">Opcjonalnie: liczba osób, częstotliwość lub termin</span>
              <input
                id="p-group"
                name="groupSeason"
                type="text"
                aria-describedby="p-group-hint"
                placeholder="np. 6–14 gości · Maj–Wrzesień"
              />
            </div>
          </div>

          <div class="field">
            <label for="p-notes">Trasy, języki i uwagi operacyjne</label>
            <span id="p-notes-hint" class="field-hint">Opcjonalnie: stawki netto vs. prowizyjne, opieka white-label, moduły Mtirala/Kazbegi/Swanetia</span>
            <textarea
              id="p-notes"
              name="notes"
              aria-describedby="p-notes-hint"
              placeholder="Opisz docelowe programy, odbiory z hoteli/portu lub wymagania wielodniowe..."
            ></textarea>
          </div>

          <div class="b2b-submit-row">
            <button type="submit" class="btn btn-coral">Wyślij przez WhatsApp →</button>
            <button id="p-tg-btn" type="button" class="btn btn-forest">Wyślij przez Telegram →</button>
            <button id="p-copy-btn" type="button" class="btn btn-outline">Kopiuj zapytanie B2B</button>
          </div>

          <p id="p-feedback" class="b2b-feedback" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script
  id="partners-config"
  type="application/json"
  set:html={JSON.stringify({
    whatsappUrl: SITE.whatsappUrl,
    telegramUrl: SITE.telegramUrl,
  })}
/>

<script>
  const cfgNode = document.getElementById('partners-config');
  const cfg = cfgNode?.textContent ? JSON.parse(cfgNode.textContent) : null;

  const form = document.getElementById('b2b-partner-form') as HTMLFormElement | null;
  const tgBtn = document.getElementById('p-tg-btn');
  const copyBtn = document.getElementById('p-copy-btn');
  const feedbackEl = document.getElementById('p-feedback');

  const getBrief = () => {
    if (!form) return '';
    const d = new FormData(form);
    return [
      'Minimalism Tours Georgia — Zapytanie Partnerskie B2B (PL)',
      `Firma / Biuro: ${d.get('company')}`,
      `Typ partnera: ${d.get('partnerType')}`,
      d.get('location') ? `Kraj / Miasto: ${d.get('location')}` : '',
      d.get('groupSeason') ? `Wielkość grupy i sezon: ${d.get('groupSeason')}` : '',
      d.get('notes') ? `Uwagi: ${d.get('notes')}` : '',
    ]
      .filter(Boolean)
      .join('\n');
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity() || !cfg) return;
    const url = `${cfg.whatsappUrl}?text=${encodeURIComponent(getBrief())}`;
    window.open(url, '_blank', 'noopener,noreferrer');
    if (feedbackEl) {
      feedbackEl.textContent = 'Otwieranie WhatsApp z wypełnionym zapytaniem B2B.';
    }
  });

  tgBtn?.addEventListener('click', () => {
    if (!form || !form.reportValidity() || !cfg) return;
    const url = `${cfg.telegramUrl}?text=${encodeURIComponent(getBrief())}`;
    window.open(url, '_blank', 'noopener,noreferrer');
    if (feedbackEl) {
      feedbackEl.textContent = 'Otwieranie Telegram z wypełnionym zapytaniem B2B.';
    }
  });

  copyBtn?.addEventListener('click', async () => {
    if (!form || !form.reportValidity()) return;
    try {
      await navigator.clipboard.writeText(getBrief());
      if (feedbackEl) {
        feedbackEl.textContent = 'Zapytanie B2B skopiowane do schowka!';
      }
    } catch {
      if (feedbackEl) {
        feedbackEl.textContent = 'Użyj przycisku Wyślij przez WhatsApp lub Telegram powyżej.';
      }
    }
  });
</script>

<style>
  .page-banner {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--ink-600);
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--ink-700);
    text-decoration: none;
    font-weight: 600;
  }

  .partner-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .partner-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: clamp(1.35rem, 2.5vw, 1.85rem);
    box-shadow: var(--shadow-xs);
  }

  .partner-card h3 {
    margin: 0.85rem 0 0.5rem;
    font-size: 1.25rem;
  }

  .partner-points {
    margin: 0.85rem 0 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.4rem;
    color: var(--ink-700);
    font-size: 0.92rem;
  }

  .guarantees-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .guarantee-card {
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.35rem;
  }

  .guarantee-card h3 {
    margin-bottom: 0.45rem;
    font-size: 1.08rem;
  }

  .guarantee-card p {
    margin-bottom: 0;
    font-size: 0.92rem;
  }

  .fleet-subhead {
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
  }

  .fleet-subhead h3 {
    margin: 0.35rem 0 0;
    font-size: 1.35rem;
  }

  .fleet-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .fleet-card {
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.35rem;
  }

  .fleet-card h4 {
    margin: 0.8rem 0 0.45rem;
    font-size: 1.12rem;
  }

  .fleet-card ul {
    margin: 0.75rem 0 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.3rem;
    font-size: 0.88rem;
    color: var(--ink-700);
  }

  .cert-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .b2b-form-wrap {
    max-width: 54rem;
  }

  .b2b-form-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 3.2vw, 2.5rem);
    box-shadow: var(--shadow-xs);
  }

  .b2b-form-card h2 {
    margin-top: 0.4rem;
  }

  .b2b-submit-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .b2b-feedback {
    margin: 0.25rem 0 0;
    min-height: 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--forest-800);
  }
</style>
