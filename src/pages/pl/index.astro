---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroShowcase, { type FeaturedTourSlide } from '../../components/HeroShowcase.astro';
import TourCard from '../../components/TourCard.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import { SITE, PICKUP_POINTS } from '../../data/site';
import {
  PL_SITE,
  PL_CONTENT_PILLARS,
  PL_SEASONS,
  PL_GENERAL_FAQS,
  PL_PICKUP_POINTS,
  getToursForLang,
  getDestinationsForLang,
  getReviewsForLang,
} from '../../data/i18n-pl';
import { withBase, absoluteUrl } from '../../lib/urls';

const plTours = getToursForLang('pl');
const plDestinations = getDestinationsForLang('pl');
const plReviews = getReviewsForLang('pl');

const pricedTours = plTours.filter((t) => t.pricingTiers.length > 0);
const defaultDestination = plDestinations[0];

const heroFeaturedTours: FeaturedTourSlide[] = [
  {
    titleLines: ['Mtirala 9 km', 'Szlak Wodospadu'],
    location: 'Park Mtirala, Gruzja',
    badgeText: 'UNESCO',
    image: withBase('/images/mtirala-waterfall-hiker.webp'),
    imageAlt:
      'Turysta z plecakiem przy ukrytym wodospadzie na 9-kilometrowym leśnym szlaku w Parku Narodowym Mtirala w Gruzji',
    href: withBase('/pl/tours/?region=mtirala'),
  },
  {
    titleLines: ['Mtirala 2 Dni', 'Nocleg w Schronisku'],
    location: 'Adżaria, Gruzja',
    badgeText: '2 Dni',
    image: withBase('/images/mtirala-2day.webp'),
    imageAlt:
      'Drewniane schronisko górskie otoczone mglistym lasem bukowym w Parku Narodowym Mtirala',
    href: withBase('/pl/tours/mtirala-2-day-shelter-hike/'),
  },
  {
    titleLines: ['Góra Kazbek', 'Szczyt Alpejski'],
    location: 'Kazbegi, Gruzja',
    badgeText: '5 054 m',
    image: withBase('/images/kazbegi-peak.webp'),
    imageAlt: 'Ośnieżony szczyt Kazbek górujący nad doliną w Stepancmindzie w Gruzji',
    href: withBase('/pl/tours/kazbegi-mount-kazbek-expedition/'),
  },
];

const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: PL_GENERAL_FAQS.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Start',
      item: absoluteUrl('/pl/', Astro.site),
    },
  ],
};

const destinationsClientData = plDestinations.map((d) => ({
  ...d,
  imageResolved: withBase(d.image),
  toursResolved: d.tourSlugs
    .map((slug) => plTours.find((t) => t.slug === slug))
    .filter((t): t is NonNullable<typeof t> => Boolean(t))
    .map((t) => ({ title: t.shortTitle, href: withBase(`/pl/tours/${t.slug}/`) })),
}));
---

<BaseLayout
  title={`${SITE.brandName} | Wycieczki z Batumi i Adżarii, Trekking i Wyprawy Kaukaskie`}
  description={PL_SITE.description}
  canonicalPath="/pl/"
  alternateEnPath="/"
  alternateKaPath="/ka/"
  alternatePlPath="/pl/"
  alternateUkPath="/uk/"
  alternateHePath="/he/"
  lang="pl"
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <!-- Hero Showcase Section -->
  <HeroShowcase
    watermarkText="MINIMALISM"
    headlineLines={['Gruzja,', 'poza', 'pocztówką.']}
    ctaLabel="Odkryj wycieczki"
    ctaHref={withBase('/pl/tours/')}
    subcopy="Odkryj lasy deszczowe Kolchidy UNESCO, ukryte szlaki Adżarii i autentyczne wyprawy kaukaskie z certyfikowanymi przewodnikami."
    bgImage={withBase('/images/mestia-svaneti.webp')}
    bgAlt="Turysta wędrujący słoneczną alpejską granią w stronę ośnieżonych szczytów Wielkiego Kaukazu w Gruzji"
    featuredTours={heroFeaturedTours}
    trustStat={`${SITE.experienceYears}+ lat`}
    trustCopy="Zaufanie podróżnych indywidualnych i partnerów B2B w całej Gruzji dzięki bezpiecznej i sprawdzonej logistyce."
    trustLinkLabel="Zobacz zweryfikowane opinie ↓"
    trustLinkHref="#reviews"
    switcherLabel="Przełącz polecane wycieczki po Gruzji"
  />

  <!-- Quick Tour Finder & Verified Credentials Strip -->
  <section class="section-surface section-tight" aria-label="Szybka wyszukiwarka wycieczek i standardy">
    <div class="container">
      <form class="hero-finder" action={withBase('/pl/tours/')} method="get" aria-label="Szybka wyszukiwarka wycieczek">
        <div class="finder-field">
          <label for="finder-region">Region</label>
          <select id="finder-region" name="region">
            <option value="">Wszystkie regiony</option>
            <option value="mtirala">Park Narodowy Mtirala</option>
            <option value="machakhela">Wąwóz Machakhela</option>
            <option value="batumi">Stare Batumi</option>
            <option value="kazbegi-svaneti">Kazbegi (Góra Kazbek)</option>
          </select>
        </div>
        <div class="finder-field">
          <label for="finder-duration">Czas trwania</label>
          <select id="finder-duration" name="duration">
            <option value="">Dowolny czas</option>
            <option value="half-day">Półdniowe (~3 godz.)</option>
            <option value="full-day">Całodniowe (6–7 godz.)</option>
            <option value="multi-day">Wielodniowe (2–8 dni)</option>
          </select>
        </div>
        <div class="finder-field">
          <label for="finder-difficulty">Tempo i teren</label>
          <select id="finder-difficulty" name="difficulty">
            <option value="">Dowolny poziom</option>
            <option value="Easy">Łatwy</option>
            <option value="Easy–Moderate">Łatwy–Umiarkowany</option>
            <option value="Moderate">Umiarkowany</option>
            <option value="Moderate–Challenging">Umiarkowany–Wymagający</option>
            <option value="Challenging">Wymagający alpejski</option>
          </select>
        </div>
        <button type="submit" class="btn btn-forest" style="width: 100%;">
          Znajdź wycieczki →
        </button>
      </form>

      <ul class="trust-strip">
        <li>
          <strong>GMGA / FMGA i UNESCO</strong>
          <span>Certyfikowany zespół górski</span>
        </li>
        <li>
          <strong>Pierwsza Pomoc Czerwonego Krzyża</strong>
          <span>Bezpieczeństwo na pierwszym miejscu</span>
        </li>
        <li>
          <strong>{SITE.experienceYears}+ lat w Gruzji</strong>
          <span>DMC Batumi · 4 punkty zbiórki</span>
        </li>
        <li>
          <strong>B2B i klienci indywidualni</strong>
          <span>Zero ukrytych opłat · Anulowanie 24h</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Signature Tours Grid -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Kameralne grupy i prywatnie</span>
          <h2>Flagowe wycieczki z Batumi i okolic</h2>
        </div>
        <div>
          <p>
            Każda trasa podaje dokładny czas marszu, logistykę odbioru, wykaz świadczeń oraz przejrzyste ceny grupowe jeszcze przed wysłaniem wiadomości.
          </p>
        </div>
      </div>

      <div class="tours-grid">
        {plTours.slice(0, 6).map((tour) => <TourCard tour={tour} lang="pl" />)}
      </div>

      <aside class="optional-banner reveal-on-scroll" aria-label="Opcjonalne atrakcje w Mtirali">
        <div class="optional-banner-copy">
          <span class="badge badge-sea">Opcjonalnie · Na życzenie</span>
          <p>
            <strong>Wycieczki do Mtirali</strong> mogą dodatkowo obejmować tyrolkę (80 GEL), jazdę quadem ATV (150 GEL), lokalny miód górski (z plastrem lub płynny, 50 GEL), propolis / დინდგელი (40 GEL) i gruziński obiad (ustalany z przewodnikiem) — całkowicie opcjonalnie, tylko na życzenie.
          </p>
        </div>
        <div class="optional-banner-pills" aria-hidden="true">
          <span class="badge badge-forest">Tyrolka · 80 GEL</span>
          <span class="badge badge-forest">ATV · 150 GEL</span>
          <span class="badge badge-forest">Miód · 50 GEL</span>
          <span class="badge badge-forest">Propolis · 40 GEL</span>
          <span class="badge badge-forest">Obiad · Z przewodnikiem</span>
        </div>
      </aside>

      <div style="margin-top: 2.25rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;">
        <p style="margin: 0; font-size: 0.95rem;">
          Szukasz letniej <strong>5-dniowej wyprawy na Kazbek (5 054 m)</strong> lub indywidualnej trasy po kilku regionach?
        </p>
        <a class="btn btn-outline" href={withBase('/pl/tours/')}>
          Zobacz pełny katalog i filtry ({plTours.length} tras) →
        </a>
      </div>
    </div>
  </section>

  <!-- Verified Guest Reviews -->
  <ReviewsSection
    reviews={plReviews}
    variant="band"
    enableFilters={true}
    eyebrow="Zweryfikowane opinie podróżnych"
    heading="Co mówią nasi goście o wycieczkach"
    intro="Autentyczne opinie z odbytych trekkingów, odpowiedzialnych odwołań z powodu burzy z pełnym zwrotem oraz od międzynarodowych partnerów B2B."
    lang="pl"
  />

  <!-- Interactive Group Price Estimator -->
  <section id="price-estimator" class="section section-surface">
    <div class="container">
      <div class="estimator-shell reveal-on-scroll">
        <div class="estimator-intro">
          <span class="eyebrow">Przejrzyste ceny · Zero ukrytych opłat</span>
          <h2>Kalkulator grupy i walut</h2>
          <p>
            Podróżni solo nie muszą zgadywać cen grupowych, a rodziny przepłacać przy wejściu do parku. Wybierz wycieczkę, ustaw liczbę dorosłych i dzieci (0–17 lat: 75% stawki) i sprawdź sumę w EUR, USD lub GEL.
          </p>
          <ul class="check-list">
            <li>Standardowe bezpłatne anulowanie do 24h na wycieczkach jednodniowych</li>
            <li>Bilet do Ogrodu Botanicznego wliczony w wycieczkę łączoną</li>
            <li>4 sprawdzone punkty zbiórki w centrum Batumi w cenie</li>
          </ul>
        </div>

        <div class="estimator-card" id="home-estimator">
          <div class="estimator-controls">
            <div class="field">
              <label for="est-tour">Wybierz wycieczkę</label>
              <select id="est-tour">
                {
                  pricedTours.map((t, idx) => (
                    <option value={t.slug} selected={idx === 1}>
                      {t.shortTitle} ({t.duration})
                    </option>
                  ))
                }
              </select>
            </div>

            <div class="form-grid form-grid-2">
              <div class="field">
                <label for="est-adults">Dorośli: <strong id="est-adults-val">2</strong></label>
                <input id="est-adults" type="range" min="1" max="16" value="2" />
              </div>
              <div class="field">
                <label for="est-children">Dzieci (0–17 lat, 75%): <strong id="est-children-val">0</strong></label>
                <input id="est-children" type="range" min="0" max="8" value="0" />
              </div>
            </div>

            <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem;">
              <span style="font-size: 0.85rem; font-weight: 700; color: var(--ink-700);">Waluta podglądu:</span>
              <div class="currency-pills" role="group" aria-label="Wybierz walutę">
                <button type="button" class="currency-btn active" data-currency="EUR" aria-pressed="true">EUR €</button>
                <button type="button" class="currency-btn" data-currency="USD" aria-pressed="false">USD $</button>
                <button type="button" class="currency-btn" data-currency="GEL" aria-pressed="false">GEL ₾</button>
              </div>
            </div>
          </div>

          <div class="estimator-output">
            <div class="est-metrics">
              <div>
                <span class="est-label">Za dorosłego</span>
                <strong id="est-per-adult" class="est-num">€63</strong>
              </div>
              <div>
                <span class="est-label">Za dziecko (0–17)</span>
                <strong id="est-per-child" class="est-num">€47</strong>
              </div>
              <div>
                <span class="est-label">Razem grupa (<span id="est-total-pax">2</span> os.)</span>
                <strong id="est-total" class="est-num est-highlight">€126</strong>
              </div>
            </div>
            <p id="est-note" class="est-footnote">
              Sprawdzony cennik 5-poziomowy · Przeliczenia na USD i GEL są orientacyjne.
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1rem;">
              <a
                id="est-wa-link"
                class="btn btn-coral"
                style="flex: 1 1 13rem;"
                href={SITE.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Zarezerwuj wycenę na WhatsApp
              </a>
              <a
                id="est-tour-link"
                class="btn btn-outline"
                href={withBase(`/pl/tours/${pricedTours[1]?.slug || pricedTours[0].slug}/`)}
              >
                Zobacz program
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Georgia Destinations Explorer -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Interaktywna mapa tras</span>
          <h2>Dokąd prowadzą nasze szlaki w Gruzji</h2>
        </div>
        <p>Kliknij dowolny punkt na mapie Gruzji, aby sprawdzić czas dojazdu z Batumi, wysokość, najlepszy sezon oraz powiązane wycieczki.</p>
      </div>

      <div class="map-explorer reveal-on-scroll">
        <div class="map-stage" aria-label="Interaktywna mapa kierunków w Gruzji">
          <svg
            viewBox="0 0 600 320"
            class="georgia-svg"
            role="img"
            aria-label="Stylizowana mapa Gruzji pokazująca Batumi, doliny Adżarii, mokradła Kolchidy, Swanetię i Kazbegi"
          >
            <path d="M0,0 L118,0 C112,75 110,165 88,245 L72,320 L0,320 Z" fill="#D5E7F0" />
            <text x="16" y="160" fill="#1D4E68" font-size="12" font-weight="700" letter-spacing="1.8">MORZE CZARNE</text>

            <path
              d="M116,42 C170,22 250,35 335,44 C415,52 505,78 566,144 C578,186 558,236 512,262 C448,266 376,274 295,286 C215,288 148,284 92,260 C98,215 114,165 116,105 Z"
              fill="#EDF4F0"
              stroke="#2D6A4F"
              stroke-width="2.5"
            />
            <path
              d="M148,54 Q260,36 390,60 T535,134"
              fill="none"
              stroke="#2D6A4F"
              stroke-width="2"
              stroke-dasharray="5 5"
              opacity="0.65"
            />
            <text x="270" y="34" fill="#1B4332" font-size="11" font-weight="700" letter-spacing="1.4">
              PASMO WIELKIEGO KAUKAZU
            </text>
            <text x="145" y="218" fill="#4A5952" font-size="11" font-weight="600">ADŻARIA</text>
          </svg>

          {
            destinationsClientData.map((dest, idx) => (
              <button
                type="button"
                class={`map-pin ${idx === 0 ? 'active' : ''}`}
                style={`left: ${dest.mapCoords.x}%; top: ${dest.mapCoords.y}%;`}
                data-dest-slug={dest.slug}
                aria-pressed={idx === 0 ? 'true' : 'false'}
              >
                <span class="pin-dot" aria-hidden="true"></span>
                <span class="pin-label">{dest.name}</span>
              </button>
            ))
          }
        </div>

        <article class="destination-spotlight" id="destination-spotlight" aria-live="polite">
          <img
            id="dest-img"
            src={withBase(defaultDestination.image)}
            alt={defaultDestination.imageAlt}
            width="1200"
            height="800"
            loading="lazy"
          />
          <div class="dest-content">
            <span id="dest-region-label" class="eyebrow">{defaultDestination.regionLabel}</span>
            <h3 id="dest-title">{defaultDestination.name}</h3>
            <p id="dest-desc">{defaultDestination.description}</p>
            <dl class="dest-meta-grid">
              <div>
                <dt>Z Batumi</dt>
                <dd id="dest-drive">{defaultDestination.driveTimeFromBatumi}</dd>
              </div>
              <div>
                <dt>Wysokość</dt>
                <dd id="dest-elev">{defaultDestination.elevation}</dd>
              </div>
              <div>
                <dt>Najlepszy czas</dt>
                <dd id="dest-season">{defaultDestination.bestSeason}</dd>
              </div>
            </dl>
            <div id="dest-tours-links" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem;">
              {
                destinationsClientData[0].toursResolved.map((tl) => (
                  <a class="btn btn-forest btn-sm" href={tl.href}>
                    {tl.title} →
                  </a>
                ))
              }
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Four Seasons in Georgia Planner -->
  <section id="seasons" class="section section-surface">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Planowanie sezonowe</span>
          <h2>Kiedy odwiedzić Batumi i szlaki Gruzji</h2>
        </div>
        <p>Uczciwe oczekiwania sezonowe — od łagodnych zimowych spacerów na wybrzeżu po kwitnienie Kolchidy i wysokie przełęcze latem.</p>
      </div>

      <div class="seasons-grid">
        {
          PL_SEASONS.map((s) => (
            <article class="season-card reveal-on-scroll">
              <span class="badge badge-sea">{s.months}</span>
              <h3>{s.title}</h3>
              <p>{s.focus}</p>
              <p class="season-tip">
                <strong>Wskazówka terenowa:</strong> {s.practicalNote}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Company Operations + Brand Pillars -->
  <section class="section section-forest">
    <div class="container">
      <div class="guide-feature reveal-on-scroll">
        <div class="guide-photo-frame">
          <img
            src={withBase('/images/mestia-svaneti.webp')}
            alt="Alpejska dolina Kaukazu i ośnieżone granie górskie w Gruzji obsługiwane przez Minimalism Tours Georgia"
            width="1200"
            height="800"
            loading="lazy"
          />
        </div>
        <div class="guide-copy">
          <span class="eyebrow">Operator z Batumi i DMC Adżaria · {SITE.experienceYears}+ lat doświadczenia</span>
          <h2>Niezawodna logistyka. Własne tempo. Gotowość B2B i prywatna.</h2>
          <p>
            Minimalism Tours Georgia powstało wokół prostego standardu: łączenia podróżnych oraz partnerów turystycznych z przyrodą Gruzji i żywą tradycją wiosek dzięki pewnej logistyce, certyfikowanym przewodnikom i przejrzystej ofercie bez ukrytych haczyków.
          </p>

          <div class="pillars-grid">
            {
              PL_CONTENT_PILLARS.map((pillar) => (
                <div class="pillar-item">
                  <h3>{pillar.name}</h3>
                  <p>{pillar.summary}</p>
                </div>
              ))
            }
          </div>

          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem;">
            <a class="btn btn-coral" href={withBase('/pl/partners/')}>B2B i Biura Podróży</a>
            <a class="btn btn-outline-light" href={withBase('/pl/about/')}>Standardy i Flota</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Pickup Points -->
  <section id="pickups" class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Bezstresowy wyjazd o {SITE.defaultStartTime}</span>
          <h2>4 centralne punkty zbiórki w Batumi</h2>
        </div>
        <p>Każda jednodniowa wycieczka wraca do tego samego wygodnego punktu — kliknij dowolny przystanek, aby otworzyć pinezkę w Mapach Google.</p>
      </div>

      <div class="pickup-grid">
        {
          PICKUP_POINTS.map((p, i) => {
            const plP = PL_PICKUP_POINTS[p.id];
            return (
              <article class="pickup-card reveal-on-scroll">
                <span class="badge badge-forest">Punkt 0{i + 1}</span>
                <h3>{plP ? plP.name : p.name}</h3>
                <p class="pickup-district">{plP ? plP.district : p.district}</p>
                <p class="pickup-address">{plP ? plP.address : p.address}</p>
                <a href={p.mapsUrl} target="_blank" rel="noopener noreferrer">
                  Otwórz w Mapach Google ↗
                </a>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- FAQ Accordion -->
  <section class="section section-surface">
    <div class="container" style="max-width: 56rem;">
      <div class="section-header">
        <div>
          <span class="eyebrow">Praktyczne odpowiedzi</span>
          <h2>Często zadawane pytania</h2>
        </div>
      </div>

      <section class="accordion" id="home-faq" aria-label="Często zadawane pytania">
        <div class="accordion-toolbar">
          <button
            type="button"
            class="btn btn-outline btn-sm"
            commandfor="home-faq"
            command="--toggle-all"
            aria-expanded="false"
          >
            <span class="expand-label">Rozwiń wszystko</span>
            <span class="collapse-label">Zwiń wszystko</span>
          </button>
        </div>

        {
          PL_GENERAL_FAQS.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <div class="accordion-panel">
                <p>{item.answer}</p>
              </div>
            </details>
          ))
        }
      </section>
    </div>
  </section>

  <script
    id="home-interactive-data"
    type="application/json"
    set:html={JSON.stringify({
      tours: pricedTours.map((t) => ({
        slug: t.slug,
        shortTitle: t.shortTitle,
        pricingNote: t.pricingNote,
        pricingTiers: t.pricingTiers,
        href: withBase(`/pl/tours/${t.slug}/`),
      })),
      destinations: destinationsClientData,
      currencyRates: SITE.currencyRates,
      whatsappUrl: SITE.whatsappUrl,
    })}
  />

  <script>
    const payloadEl = document.getElementById('home-interactive-data');
    if (payloadEl?.textContent) {
      const data = JSON.parse(payloadEl.textContent);

      const tourSelect = document.getElementById('est-tour') as HTMLSelectElement | null;
      const adultsRange = document.getElementById('est-adults') as HTMLInputElement | null;
      const childrenRange = document.getElementById('est-children') as HTMLInputElement | null;
      const adultsVal = document.getElementById('est-adults-val');
      const childrenVal = document.getElementById('est-children-val');
      const perAdultEl = document.getElementById('est-per-adult');
      const perChildEl = document.getElementById('est-per-child');
      const totalPaxEl = document.getElementById('est-total-pax');
      const totalEl = document.getElementById('est-total');
      const noteEl = document.getElementById('est-note');
      const waLinkEl = document.getElementById('est-wa-link') as HTMLAnchorElement | null;
      const tourLinkEl = document.getElementById('est-tour-link') as HTMLAnchorElement | null;
      const currencyBtns = document.querySelectorAll<HTMLButtonElement>('.currency-btn');

      let activeCurrency: 'EUR' | 'USD' | 'GEL' = 'EUR';

      const formatAmt = (eur: number) => {
        const cfg = data.currencyRates[activeCurrency] || data.currencyRates.EUR;
        const val = Math.round(eur * cfg.rate);
        return `${cfg.symbol}${val}`;
      };

      const renderEstimator = () => {
        if (!tourSelect || !adultsRange || !childrenRange) return;
        const tour = data.tours.find((t: any) => t.slug === tourSelect.value) || data.tours[0];
        if (!tour) return;

        const maxCap = tour.pricingTiers[tour.pricingTiers.length - 1]?.maxPax || 16;
        const adults = Number(adultsRange.value);
        const children = Number(childrenRange.value);
        const totalPax = Math.min(maxCap, Math.max(1, adults + children));

        if (adultsVal) adultsVal.textContent = String(adults);
        if (childrenVal) childrenVal.textContent = String(children);
        if (totalPaxEl) totalPaxEl.textContent = String(adults + children);

        const tier =
          tour.pricingTiers.find((tierItem: any) => totalPax >= tierItem.minPax && totalPax <= tierItem.maxPax) ||
          tour.pricingTiers[tour.pricingTiers.length - 1];

        const totalEur = adults * tier.adultEur + children * tier.childEur;
        if (perAdultEl) perAdultEl.textContent = formatAmt(tier.adultEur);
        if (perChildEl) perChildEl.textContent = formatAmt(tier.childEur);
        if (totalEl) totalEl.textContent = formatAmt(totalEur);
        if (noteEl) {
          noteEl.textContent = `${tour.pricingNote}. ${
            activeCurrency === 'EUR'
              ? 'Podano w bazowej walucie EUR.'
              : 'Wartości w USD i GEL są orientacyjnym przeliczeniem z EUR.'
          }`;
        }
        if (tourLinkEl) tourLinkEl.href = tour.href;
        if (waLinkEl) {
          const msg = `Dzień dobry Minimalism Tours Georgia! Chciałbym zarezerwować „${tour.shortTitle}” dla ${adults} dorosłych i ${children} dzieci. Szacowana suma: €${totalEur} (${formatAmt(totalEur)}).`;
          waLinkEl.href = `${data.whatsappUrl}?text=${encodeURIComponent(msg)}`;
        }
      };

      currencyBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeCurrency = (btn.dataset.currency as 'EUR' | 'USD' | 'GEL') || 'EUR';
          currencyBtns.forEach((b) => {
            const active = b === btn;
            b.classList.toggle('active', active);
            b.setAttribute('aria-pressed', String(active));
          });
          renderEstimator();
        });
      });

      tourSelect?.addEventListener('change', renderEstimator);
      adultsRange?.addEventListener('input', renderEstimator);
      childrenRange?.addEventListener('input', renderEstimator);
      renderEstimator();

      const mapPins = document.querySelectorAll<HTMLButtonElement>('.map-pin');
      const destImg = document.getElementById('dest-img') as HTMLImageElement | null;
      const destRegion = document.getElementById('dest-region-label');
      const destTitle = document.getElementById('dest-title');
      const destDesc = document.getElementById('dest-desc');
      const destDrive = document.getElementById('dest-drive');
      const destElev = document.getElementById('dest-elev');
      const destSeason = document.getElementById('dest-season');
      const destLinks = document.getElementById('dest-tours-links');

      mapPins.forEach((pin) => {
        pin.addEventListener('click', () => {
          const slug = pin.dataset.destSlug;
          const dest = data.destinations.find((d: any) => d.slug === slug);
          if (!dest) return;

          mapPins.forEach((p) => {
            const isMatch = p === pin;
            p.classList.toggle('active', isMatch);
            p.setAttribute('aria-pressed', String(isMatch));
          });

          if (destImg) {
            destImg.src = dest.imageResolved;
            destImg.alt = dest.imageAlt;
          }
          if (destRegion) destRegion.textContent = dest.regionLabel;
          if (destTitle) destTitle.textContent = dest.name;
          if (destDesc) destDesc.textContent = dest.description;
          if (destDrive) destDrive.textContent = dest.driveTimeFromBatumi;
          if (destElev) destElev.textContent = dest.elevation;
          if (destSeason) destSeason.textContent = dest.bestSeason;

          if (destLinks) {
            destLinks.replaceChildren();
            if (dest.toursResolved.length) {
              dest.toursResolved.forEach((tl: any) => {
                const a = document.createElement('a');
                a.className = 'btn btn-forest btn-sm';
                a.href = tl.href;
                a.textContent = `${tl.title} →`;
                destLinks.appendChild(a);
              });
            } else {
              const a = document.createElement('a');
              a.className = 'btn btn-coral btn-sm';
              a.href = `${data.whatsappUrl}?text=${encodeURIComponent(`Dzień dobry Minimalism Tours Georgia! Chciałbym zaplanować prywatną wycieczkę do: ${dest.name}.`)}`;
              a.target = '_blank';
              a.rel = 'noopener noreferrer';
              a.textContent = `Zaplanuj prywatną trasę: ${dest.name} ↗`;
              destLinks.appendChild(a);
            }
          }
        });
      });
    }
  </script>
</BaseLayout>

