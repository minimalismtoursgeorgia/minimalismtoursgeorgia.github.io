---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuestRegistrationForm from '../../../components/GuestRegistrationForm.astro';
import { SITE } from '../../../data/site';
import { withBase, absoluteUrl } from '../../../lib/urls';

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: absoluteUrl('/pl/', Astro.site) },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Rejestracja gościa i formularz medyczny',
      item: absoluteUrl('/pl/guest-registration/', Astro.site),
    },
  ],
};
---

<BaseLayout
  title={`Rejestracja gościa i formularz medyczny | ${SITE.brandName}`}
  description="Poufna rejestracja przed wyjazdem, kontakt alarmowy, dane ubezpieczenia i formularz medyczny dla uczestników wycieczek Minimalism Tours Georgia."
  canonicalPath="/pl/guest-registration/"
  alternateEnPath="/guest-registration/"
  alternateKaPath="/ka/guest-registration/"
  alternatePlPath="/pl/guest-registration/"
  alternateUkPath="/uk/guest-registration/"
  alternateHePath="/he/guest-registration/"
  lang="pl"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/pl/')}>Start</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Rejestracja gościa i formularz medyczny</span>
      </nav>
      <span class="eyebrow">Bezpieczeństwo i rejestracja przed wyjazdem</span>
      <h1>Rejestracja gościa i formularz medyczny</h1>
      <p>
        Standardowy formularz bezpieczeństwa terenowego dla wycieczek w Mtirali, Machakheli i Wysokim Kaukazie ({SITE.brandName}).
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 58rem;">
      <GuestRegistrationForm lang="pl" />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.85rem;
    color: var(--ink-500);
    margin-bottom: 0.9rem;
  }

  .breadcrumbs a {
    color: var(--forest-800);
    text-decoration: none;
    font-weight: 600;
  }

  .page-hero h1 {
    margin: 0.55rem 0 0.7rem;
    max-width: 24ch;
  }

  .page-hero p {
    margin: 0;
    max-width: 62ch;
    color: var(--ink-700);
  }
</style>
