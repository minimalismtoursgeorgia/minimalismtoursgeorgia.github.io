---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SocialIcon from '../../../components/SocialIcon.astro';
import { SITE, PICKUP_POINTS, SOCIAL_LINKS } from '../../../data/site';
import { PL_SITE, PL_PICKUP_POINTS, getToursForLang } from '../../../data/i18n-pl';
import { withBase, absoluteUrl } from '../../../lib/urls';

const plTours = getToursForLang('pl');

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: absoluteUrl('/pl/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'Kontakt', item: absoluteUrl('/pl/contact/', Astro.site) },
  ],
};
---

<BaseLayout
  title={`Kontakt i zapytanie o wycieczkę | ${SITE.brandName}`}
  description="Skontaktuj się z Minimalism Tours Georgia przez WhatsApp, Telegram lub telefon, aby zarezerwować wycieczki z Batumi, prywatne trasy po Adżarii, wyjazdy B2B lub wyprawę na Kazbek."
  canonicalPath="/pl/contact/"
  alternateEnPath="/contact/"
  alternateKaPath="/ka/"
  alternatePlPath="/pl/contact/"
  lang="pl"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="page-banner">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase('/pl/')}>Start</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Kontakt</span>
      </nav>
      <span class="eyebrow">Zero prowizji za rezerwację · Bezpośrednia odpowiedź lokalna</span>
      <h1>Zaplanuj wycieczkę lub zadaj pytanie</h1>
      <p style="max-width: 46rem; font-size: 1.05rem;">
        Wyślij preferowane daty, wielkość grupy i punkt odbioru w Batumi bezpośrednio do naszego biura rezerwacji — lub napisz od razu na WhatsApp o aktualne warunki na szlaku.{' '}
        <a href={withBase('/pl/partners/')}>Szukasz stawek netto B2B? Odwiedź B2B i Partnerzy →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <!-- Accessible Direct Request Form -->
      <div class="contact-form-card">
        <h2>Bezpośrednia rezerwacja i kreator trasy</h2>
        <p style="font-size: 0.94rem; margin-bottom: 1.5rem;">
          Wypełnij szczegóły poniżej i wybierz sposób wysłania: gotowa wiadomość <strong>WhatsApp</strong>, gotowy <strong>Telegram</strong> lub skopiowanie podsumowania do schowka.
        </p>

        <form id="full-contact-form" class="form-grid" data-enhanced-validation novalidate>
          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="c-name">Imię i nazwisko *</label>
              <span id="c-name-hint" class="field-hint">Wymagane do potwierdzenia rezerwacji</span>
              <input
                id="c-name"
                name="name"
                type="text"
                required
                minlength="2"
                autocomplete="name"
                aria-describedby="c-name-hint"
                data-error="c-name-error"
                placeholder="Twoje imię"
              />
              <div id="c-name-error" class="error-msg">
                <span role="img" aria-label="Błąd">⚠</span> Wpisz co najmniej 2 znaki dla imienia.
              </div>
            </div>

            <div class="field">
              <label for="c-email">Adres e-mail *</label>
              <span id="c-email-hint" class="field-hint">Format: imie@example.com</span>
              <input
                id="c-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                aria-describedby="c-email-hint"
                data-error="c-email-error"
                placeholder="imie@example.com"
              />
              <div id="c-email-error" class="error-msg">
                <span role="img" aria-label="Błąd">⚠</span> Podaj poprawny adres e-mail, np. imie@example.com.
              </div>
            </div>
          </div>

          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="c-tour">Wybrana wycieczka lub trasa *</label>
              <span id="c-tour-hint" class="field-hint">Wybierz standardową trasę lub własny program</span>
              <select
                id="c-tour"
                name="tour"
                required
                aria-describedby="c-tour-hint"
                data-error="c-tour-error"
              >
                <option value="">Wybierz wycieczkę...</option>
                {plTours.map((t) => <option value={t.title}>{t.shortTitle} ({t.duration})</option>)}
                <option value="Indywidualna trasa Adżaria / Zielone Jezioro / Kolchida">
                  Indywidualna trasa Adżaria / Zielone Jezioro / Kolchida
                </option>
                <option value="Współpraca B2B (Hotel / Biuro podróży)">
                  Współpraca B2B (Hotel / Biuro podróży)
                </option>
              </select>
              <div id="c-tour-error" class="error-msg">
                <span role="img" aria-label="Błąd">⚠</span> Wybierz wycieczkę lub rodzaj zapytania.
              </div>
            </div>

            <div class="field">
              <label for="c-pickup">Miejsce odbioru w Batumi</label>
              <span id="c-pickup-hint" class="field-hint">Lub wybierz własny hotel w centrum / inny region</span>
              <select id="c-pickup" name="pickup" aria-describedby="c-pickup-hint">
                {PICKUP_POINTS.map((p) => {
                  const plP = PL_PICKUP_POINTS[p.id];
                  return <option value={plP ? plP.name : p.name}>{plP ? plP.name : p.name}</option>;
                })}
                <option value="Własny hotel w centrum Batumi">Własny hotel w centrum Batumi</option>
                <option value="Stepancminda / Kazbegi / Inny region">Stepancminda / Kazbegi / Inny region</option>
              </select>
            </div>
          </div>

          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="c-date">Preferowana data</label>
              <span id="c-date-hint" class="field-hint">Zostaw puste, jeśli termin jest elastyczny</span>
              <input id="c-date" name="date" type="date" aria-describedby="c-date-hint" />
            </div>

            <div class="field">
              <label for="c-guests">Wielkość grupy (1–16) *</label>
              <span id="c-guests-hint" class="field-hint">Łączna liczba osób, w tym dzieci</span>
              <input
                id="c-guests"
                name="guests"
                type="number"
                min="1"
                max="16"
                value="2"
                required
                aria-describedby="c-guests-hint"
                data-error="c-guests-error"
              />
              <div id="c-guests-error" class="error-msg">
                <span role="img" aria-label="Błąd">⚠</span> Liczba gości musi mieścić się w przedziale od 1 do 16.
              </div>
            </div>
          </div>

          <div class="field">
            <label for="c-notes">Pytania, dieta lub potrzeby sprzętowe</label>
            <span id="c-notes-hint" class="field-hint">Opcjonalnie: posiłki wegetariańskie, kijki trekkingowe, terminy na Kazbek lub wiek dzieci</span>
            <textarea
              id="c-notes"
              name="notes"
              aria-describedby="c-notes-hint"
              placeholder="Opisz, jak ma wyglądać Twój wymarzony dzień..."
            ></textarea>
          </div>

          <div class="contact-submit-row">
            <button type="submit" class="btn btn-coral">
              Wyślij przez WhatsApp →
            </button>
            <button id="c-tg-btn" type="button" class="btn btn-forest">
              Wyślij przez Telegram →
            </button>
            <button id="c-copy-btn" type="button" class="btn btn-outline">
              Kopiuj podsumowanie
            </button>
          </div>

          <p id="c-feedback" class="contact-feedback" role="status" aria-live="polite"></p>
        </form>
      </div>

      <!-- Direct Channels -->
      <aside class="contact-side">
        <div class="side-panel">
          <span class="eyebrow">Kanały bezpośrednie</span>
          <h2>Kontakt z Minimalism Tours Georgia</h2>
          <ul class="direct-list">
            <li>
              <strong>WhatsApp i Telefon</strong>
              <a href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer">
                {SITE.phoneDisplay} (Najszybsza odpowiedź)
              </a>
              <a href={`tel:${SITE.phoneRaw}`}>Zadzwoń {SITE.phoneDisplay}</a>
            </li>
            <li>
              <strong>Telegram</strong>
              <a href={SITE.telegramUrl} target="_blank" rel="noopener noreferrer">
                @MinimalismToursGeorgia ↗
              </a>
            </li>
            <li>
              <strong>Adres biura</strong>
              <a href={SITE.googleBusinessUrl} target="_blank" rel="noopener noreferrer">
                {SITE.officeAddressDisplay} ↗
              </a>
            </li>
            <li>
              <strong>Godziny pracy</strong>
              <span>{PL_SITE.officeHoursDisplay}</span>
            </li>
            <li>
              <strong>GetYourGuide</strong>
              <a href={SITE.getYourGuideSupplierUrl} target="_blank" rel="noopener noreferrer">
                Wszystkie wycieczki Minimalism Tours Georgia ↗
              </a>
            </li>
            <li>
              <strong>Opinie Google</strong>
              <a href={SITE.googleReviewUrl} target="_blank" rel="noopener noreferrer">
                Zostaw opinię Google ↗
              </a>
            </li>
            <li>
              <strong>Tripadvisor</strong>
              <a href={SITE.tripadvisorReviewUrl} target="_blank" rel="noopener noreferrer">
                Opinie Tripadvisor ↗
              </a>
            </li>
            <li>
              <strong>Trustpilot</strong>
              <a href={SITE.trustpilotUrl} target="_blank" rel="noopener noreferrer">
                Opinie Trustpilot ↗
              </a>
            </li>
          </ul>
        </div>

        <div class="side-panel">
          <span class="eyebrow">Obserwuj Minimalism Tours Georgia</span>
          <h3>Oficjalne media społecznościowe</h3>
          <ul class="social-grid">
            {
              SOCIAL_LINKS.map((s) => (
                <li>
                  <a class="social-card-link" href={s.url} target="_blank" rel="noopener noreferrer">
                    <span class="social-icon-badge" aria-hidden="true">
                      <SocialIcon id={s.id} size={18} />
                    </span>
                    <span class="social-card-meta">
                      <strong>{s.name}</strong>
                      <span>{s.handle} ↗</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="side-panel">
          <span class="eyebrow">Punkty zbiórki</span>
          <h3>4 sprawdzone miejsca w Batumi</h3>
          <ul class="pickup-compact">
            {
              PICKUP_POINTS.map((p) => {
                const plP = PL_PICKUP_POINTS[p.id];
                return (
                  <li>
                    <strong>{plP ? plP.name : p.name}</strong>
                    <span>{plP ? plP.address : p.address}</span>
                    <a href={p.mapsUrl} target="_blank" rel="noopener noreferrer">Mapy Google ↗</a>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script
  id="contact-config"
  type="application/json"
  set:html={JSON.stringify({
    whatsappUrl: SITE.whatsappUrl,
    telegramUrl: SITE.telegramUrl,
    formspreeEndpoint: SITE.formspreeEndpoint,
  })}
/>

<script>
  const cfgNode = document.getElementById('contact-config');
  const cfg = cfgNode?.textContent ? JSON.parse(cfgNode.textContent) : null;

  const form = document.getElementById('full-contact-form') as HTMLFormElement | null;
  const tgBtn = document.getElementById('c-tg-btn');
  const copyBtn = document.getElementById('c-copy-btn');
  const feedbackEl = document.getElementById('c-feedback');

  const getSummary = () => {
    if (!form) return '';
    const d = new FormData(form);
    return [
      'Minimalism Tours Georgia — Zapytanie / Rezerwacja (PL)',
      `Imię: ${d.get('name')}`,
      `Email: ${d.get('email')}`,
      `Wycieczka: ${d.get('tour')}`,
      `Odbiór: ${d.get('pickup')}`,
      `Preferowana data: ${d.get('date') || 'Elastyczna'}`,
      `Liczba osób: ${d.get('guests')}`,
      d.get('notes') ? `Uwagi: ${d.get('notes')}` : '',
    ]
      .filter(Boolean)
      .join('\n');
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity() || !cfg) return;
    const summary = getSummary();

    if (cfg.formspreeEndpoint) {
      try {
        await fetch(cfg.formspreeEndpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
      } catch {
        // Fallback cleanly to WhatsApp
      }
    }

    const waUrl = `${cfg.whatsappUrl}?text=${encodeURIComponent(summary)}`;
    window.open(waUrl, '_blank', 'noopener,noreferrer');
    if (feedbackEl) {
      feedbackEl.textContent = 'Otwieranie WhatsApp z wypełnionymi szczegółami wycieczki.';
    }
  });

  tgBtn?.addEventListener('click', () => {
    if (!form || !form.reportValidity() || !cfg) return;
    const summary = getSummary();
    const tgUrl = `${cfg.telegramUrl}?text=${encodeURIComponent(summary)}`;
    window.open(tgUrl, '_blank', 'noopener,noreferrer');
    if (feedbackEl) {
      feedbackEl.textContent = 'Otwieranie Telegram z wypełnionymi szczegółami wycieczki.';
    }
  });

  copyBtn?.addEventListener('click', async () => {
    if (!form || !form.reportValidity()) return;
    try {
      await navigator.clipboard.writeText(getSummary());
      if (feedbackEl) {
        feedbackEl.textContent = 'Podsumowanie zapytania skopiowano do schowka!';
      }
    } catch {
      if (feedbackEl) {
        feedbackEl.textContent = 'Użyj przycisku Wyślij przez WhatsApp lub Telegram powyżej.';
      }
    }
  });
</script>

<style>
  .page-banner {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--ink-600);
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--ink-700);
    text-decoration: none;
    font-weight: 600;
  }

  .contact-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 58rem) {
    .contact-grid {
      grid-template-columns: 1.35fr 0.85fr;
    }
  }

  .contact-form-card,
  .side-panel {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: clamp(1.4rem, 3vw, 2.25rem);
    box-shadow: var(--shadow-xs);
  }

  .contact-side {
    display: grid;
    gap: 1.5rem;
  }

  .direct-list,
  .pickup-compact {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .direct-list li,
  .pickup-compact li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.92rem;
  }

  .direct-list li:last-child,
  .pickup-compact li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .pickup-compact span {
    color: var(--ink-600);
    font-size: 0.85rem;
  }

  .social-grid {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: 0.65rem;
  }

  .social-card-link {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-page);
    color: var(--ink-900);
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .social-icon-badge {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--forest-100);
    color: var(--forest-800);
    transition: background-color 160ms ease, color 160ms ease;
  }

  .social-card-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .social-card-link strong {
    font-size: 0.92rem;
    color: var(--forest-800);
  }

  .social-card-link span {
    font-size: 0.8rem;
    color: var(--ink-600);
    overflow-wrap: anywhere;
  }

  .social-card-link:hover,
  .social-card-link:focus-visible {
    border-color: var(--forest-800);
    background-color: var(--forest-100);
    transform: translateY(-1px);
  }

  .social-card-link:hover .social-icon-badge,
  .social-card-link:focus-visible .social-icon-badge {
    background-color: var(--forest-800);
    color: #ffffff;
  }

  .contact-submit-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .contact-feedback {
    margin: 0.25rem 0 0;
    min-height: 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--forest-800);
  }
</style>
